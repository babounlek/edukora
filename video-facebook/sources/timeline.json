 "subs": [
  {
   "t0": 0.302083,
   "t1": 1.828541,
   "texte": "Il a eu la correction…"
  },
  {
   "t0": 1.838541,
   "t1": 3.8750410000000004,
   "texte": "mais l'a-t-il vraiment comprise ?"
  },
  {
   "t0": 5.232083,
   "t1": 6.5502080000000005,
   "texte": "Sur EduKora,"
  },
  {
   "t0": 6.560208,
   "t1": 8.883123999999999,
   "texte": "chaque corrigé détaille chaque étape."
  },
  {
   "t0": 9.283666,
   "t1": 10.812332,
   "texte": "Rien n'est sauté."
  },
  {
   "t0": 12.172082999999999,
   "t1": 13.909082999999999,
   "texte": "La méthode est rappelée."
  },
  {
   "t0": 14.308540999999998,
   "t1": 15.926165999999998,
   "texte": "Chaque calcul est posé,"
  },
  {
   "t0": 15.936165999999998,
   "t1": 17.360623999999998,
   "texte": "ligne après ligne."
  },
  {
   "t0": 17.759583,
   "t1": 19.887207999999998,
   "texte": "Et le résultat est vérifié."
  },
  {
   "t0": 21.251040999999997,
   "t1": 23.298333,
   "texte": "Du BEPC au Probatoire,"
  },
  {
   "t0": 23.308332999999998,
   "t1": 24.472416,
   "texte": "puis au BAC."
  },
  {
   "t0": 24.873958,
   "t1": 26.074916,
   "texte": "Et le GCE,"
  },
  {
   "t0": 26.084916,
   "t1": 27.665625,
   "texte": "en version anglaise."
  },
  {
   "t0": 29.032082999999997,
   "t1": 30.636665999999998,
   "texte": "L'élève révise seul,"
  },
  {
   "t0": 30.646665999999996,
   "t1": 31.862832999999995,
   "texte": "à son rythme."
  },
  {
   "t0": 32.263333,
   "t1": 34.011165999999996,
