    # <<< redirections-segments-en

    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }


    # Robots d'aspiration pour l'IA : jamais de PDF. C'est un filtre de courtoisie (le User-Agent se falsifie) : la vraie
    # protection est le quota quotidien côté Django (backend/access/quota.py), qui s'applique à tout client. Les robots
    # d'aperçu de lien (WhatsApp, Facebook...) ne sont pas dans cette liste.
    @robots_ia_pdf {
        header_regexp User-Agent (?i)(gptbot|chatgpt-user|oai-searchbot|claudebot|claude-web|anthropic-ai|ccbot|bytespider|perplexitybot|google-extended|amazonbot|applebot-extended|meta-externalagent|cohere-ai|diffbot)
        path_regexp ^/(access/cours/pdf/|access/lessons/|inedit/epreuves/[0-9]+/sujet\.pdf|fiches/[0-9]+/(sujet|corrige)\.pdf|quiz/sessions/[0-9]+/(sujet|corrige)\.pdf)
    }
    handle @robots_ia_pdf {
        respond "Forbidden" 403
    }

    # PDF « sujet » des épreuves (Lesson.sujet_pdf) : plus servis en direct. Ils passent par
    # /access/lessons/<id>/sujet.pdf (Django), qui compte le téléchargement dans le quota quotidien
    # (backend/access/quota.py) - sans ce blocage, une adresse /media/sujets_pdf/... contournerait le quota.
    # Le dossier *_avant_filigrane est une sauvegarde interne, jamais à servir.
    @pdf_sujets_prives path /media/sujets_pdf/* /media/sujets_pdf_avant_filigrane/*
    handle @pdf_sujets_prives {
        respond "Not found" 404
    }

    # Illustrations et figures des cours : une heure de cache navigateur, puis revalidation (ETag). Pas plus long :
    # une figure corrigée garde son nom de fichier.
    handle_path /media/* {
        root * /srv/media
        header Cache-Control "public, max-age=3600"
        file_server
    }

    # /quiz/sessions*, /quiz/revisions* et /quiz/maitrise* (API DRF, voir quiz/urls.py)
    # et pas /quiz* : le frontend a aussi ses propres routes sous /quiz (page de
    # démarrage "/quiz", pages de session "/quiz/session/:id") - un simple préfixe
    # /quiz* les envoyait toutes à Django, qui n'a pourtant aucune route pour elles
    # (404 constaté en prod après rebuild), au lieu de laisser le handler générique
    # ci-dessous servir la SPA. Même piège reproduit puis corrigé pour /inedit* : le
    # frontend a ses propres routes sous /inedit ("/inedit", "/inedit/tentative/:id",
    # ".../resultat", volontairement au singulier "tentative") - seuls les sous-chemins
    # d'API réels de inedit/urls.py (au pluriel "tentatives") sont routés vers Django.
    # /fiches/* (avec le slash final, pas /fiches*) : le frontend a sa propre page à
    # "/fiches" (sans slash, voir App.tsx) tandis que toute l'API fiches.urls vit sous
    # "/fiches/..." (avec slash, y compris la création "POST /fiches/") - même trailing
    # slash qui distingue déjà "/quiz"/"/inedit" (pages) de leurs sous-chemins d'API,
    # ici c'est le seul signal disponible puisque page et API partagent le même mot.
    # /whatsapp* sans cette subtilité : contrairement à /quiz, /inedit, /fiches, le
    # frontend n'a AUCUNE page sous ce mot (l'opt-in vit dans /compte) - rien à
    # distinguer, tout /whatsapp* va à Django.
    # /quiz/xp* (objectif d'XP du jour) est une API aussi, ajoutée avec les trois suivantes.
    # /quiz/essais* (essai gratuit sans compte, voir quiz/essai.py) : avec le S, jamais /quiz/essai* - le frontend
    # a ses propres pages "/quiz/essai" et "/quiz/essai/resultat" (App.tsx), qui doivent rester servies par la SPA.
    # /quiz/accueil*, /quiz/priorites*, /quiz/bilan-periode* : trois routes d'API de
    # quiz/urls.py qui manquaient à cette liste - Caddy répondait 405 (fichier
    # statique, GET/HEAD seulement) à leur preflight CORS depuis le serveur de dev, et
    # servait index.html en prod. Toute nouvelle route sous /quiz/ doit être ajoutée ici.
    # /recherche/* (recherche globale, voir recherche/urls.py) : avec le slash final, par la même
    # logique que /fiches/* - la page de résultats du frontend est "/:pays/recherche", jamais
    # un chemin qui COMMENCE par /recherche, mais autant ne rien laisser d'ambigu.
    # /healthz : contrôle de déploiement (deploy/deploy.sh), voir edtech_cm/health.py.
    @backend path /healthz /admin* /auth* /catalog* /subscriptions* /payments* /revendeurs* /access* /quiz/sessions* /quiz/revisions* /quiz/maitrise* /quiz/subjects* /quiz/parcours* /quiz/plan-du-jour* /quiz/matieres* /quiz/accueil* /quiz/priorites* /quiz/bilan-periode* /quiz/xp* /quiz/chrono* /quiz/essais* /quiz/en-cours* /quiz/historique* /analytics* /inedit/mes-inscriptions* /inedit/mes-tentatives* /inedit/epreuves* /inedit/tentatives* /fiches/* /whatsapp* /relances* /recherche/* /aide-api/* /simulations* /partage-apercu* /partage-image/* /sitemap.xml /sitemap-*.xml
    handle @backend {
        reverse_proxy backend:8000
    }

    # Moteurs de recherche : la SPA ne donne à ces robots qu'un HTML identique pour toutes les pages (titre générique,
    # aucun texte) tant que le JavaScript n'a pas tourné et que les API n'ont pas répondu. Pour les pages de contenu,
    # ils reçoivent à la place la page complète - titre, description, canonical, hreflang, texte public (voir
    # backend/catalog/prerendu.py). Seulement les moteurs : les robots d'entraînement de l'IA (GPTBot, ClaudeBot...) n'y
    # sont pas, et les visiteurs n'y passent jamais. Mêmes chemins que les aperçus de liens ci-dessous.
    @robots_moteurs {
        header_regexp User-Agent (?i)(googlebot|google-inspectiontool|bingbot|bingpreview|duckduckbot|yandexbot|baiduspider|applebot/)
        path_regexp ^/(en/)?([a-z]{2}/)?(epreuves|past-papers|cours|lessons|epreuves-inedites|mock-papers|aide|help|examens|exams)/[^/]+(/lire|/read)?/?$
    }
    handle @robots_moteurs {
        rewrite * /prerendu{path}
        reverse_proxy backend:8000
    }

    # Les pages SANS identifiant (accueil du pays, listes d'épreuves / cours / thèmes, tarifs, à propos, aide) : même
    # traitement, pour que leur HTML initial porte un titre propre, un texte et des liens vers les pages d'examen au lieu
    # du HTML vide de la SPA (voir backend/catalog/pages_statiques.py). `/`, `/en` et `/cm` y sont compris.
    @robots_moteurs_statique {
        header_regexp User-Agent (?i)(googlebot|google-inspectiontool|bingbot|bingpreview|duckduckbot|yandexbot|baiduspider|applebot/)
        path_regexp ^/(en/)?(([a-z]{2})(/(epreuves|past-papers|cours|lessons|themes-frequents|frequent-topics))?|tarifs|pricing|a-propos|about|aide|help)?/?$
    }
    handle @robots_moteurs_statique {
        rewrite * /prerendu{path}
        reverse_proxy backend:8000
    }

    # Aperçu des liens partagés : les robots de WhatsApp, Facebook, Telegram... ne lancent pas le
    # JavaScript de la SPA, donc ne voient que les balises génériques d'index.html. Pour les pages
    # d'épreuve, de cours et d'épreuve inédite, ils reçoivent à la place une page de balises <meta>
    # propres au contenu (voir backend/catalog/apercu_partage.py). Les visiteurs n'y passent jamais.
    # Les deux jeux de segments : français (/cm/epreuves/x) et anglais (/en/cm/past-papers/x, voir
    # frontend/src/lib/i18n/segments-url.json) ; un test vérifie qu'ils couvrent toutes les routes de détail.
    @robots_apercu {
        header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest)
        path_regexp ^/(en/)?([a-z]{2}/)?(epreuves|past-papers|cours|lessons|epreuves-inedites|mock-papers|aide|help|examens|exams)/[^/]+(/lire|/read)?/?$
    }
    # Le quiz gratuit partagé : /quiz/essai/<cursus>/<matière>/<thème> (identifiants numériques, pas de pays) et sa
    # forme anglaise /en/quiz/trial/... ; /quiz/essai tout court et /quiz/essai/resultat restent à la SPA.
    @robots_apercu_quiz {
        header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest)
        path_regexp ^/(en/quiz/trial|quiz/essai)/[0-9]+/[0-9]+/[0-9]+/?$
    }
    handle @robots_apercu_quiz {
        rewrite * /partage-apercu{path}
        reverse_proxy backend:8000
    }
    handle @robots_apercu {
        rewrite * /partage-apercu{path}
        reverse_proxy backend:8000
    }

    # Accueil de la version anglaise (/en, /en/cm) : pas de contenu propre, mais l'aperçu générique
    # doit être en anglais (og:locale, description) - sans cette règle, ces robots recevraient les
    # balises françaises d'index.html.
    @robots_apercu_en {
        header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest)
        path_regexp ^/en(/[a-z]{2})?/?$
    }
    handle @robots_apercu_en {
        rewrite * /partage-apercu{path}
        reverse_proxy backend:8000
    }

    # Aperçu des pages sans identifiant (accueil du pays, listes, tarifs, à propos, aide) : titre et description propres.
    @robots_apercu_statique {
        header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest)
        path_regexp ^/(en/)?(([a-z]{2})(/(epreuves|past-papers|cours|lessons|themes-frequents|frequent-topics))?|tarifs|pricing|a-propos|about|aide|help)?/?$
    }
    handle @robots_apercu_statique {
        rewrite * /partage-apercu{path}
        reverse_proxy backend:8000
    }

    # Fichiers de /assets : le nom contient le hash du contenu (Vite), un fichier ne change
    # jamais sous un même nom - cache navigateur d'un an, aucune revalidation aux visites
    # suivantes (sur une connexion mobile lente, c'est ce qui fait la différence entre
    # « chargement instantané » et « tout re-télécharger »).
    # SANS try_files : un fichier absent (ancienne version d'une page encore ouverte après un
    # déploiement) doit répondre 404, jamais index.html. Avec le repli sur index.html, le navigateur
    # (et le service worker, qui garde toute réponse 200 de /assets) conservait une PAGE HTML pendant
    # un an sous le nom d'un script - l'application restait cassée jusqu'au vidage du cache.
    handle /assets/* {
        root * /srv/frontend
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Fichiers statiques non versionnés de la racine (logos, icônes, manifeste d'images) : un jour de
    # cache, sans quoi chaque page les revalide un par un (une requête de plus par logo, même en 304).
    @statiques_racine path /brand/* /favicon.ico /favicon.svg /favicon-16x16.png /favicon-32x32.png /apple-touch-icon.png /pwa-192.png /pwa-512.png /pwa-maskable-512.png /icons.svg
    handle @statiques_racine {
        root * /srv/frontend
        header Cache-Control "public, max-age=86400"
        file_server
    }

    # >>> routes-spa-connues (GÉNÉRÉ par scripts/generer_caddy_segments.py : ne pas modifier à la main)
    # Un moteur de recherche qui demande une adresse que l'application ne connaît pas reçoit un vrai 404 (un visiteur,
    # lui, garde la page introuvable de l'application). Un fichier existant passe toujours.
    @bot_adresse_inconnue {
        header_regexp User-Agent (?i)(googlebot|google-inspectiontool|bingbot|bingpreview|duckduckbot|yandexbot|baiduspider|applebot/)
        not path_regexp ^(?:/|/en|/[a-z]{2}|/en/[a-z]{2}|/epreuves/[^/]+|/en/past\-papers/[^/]+|/epreuves/[^/]+/lire|/en/past\-papers/[^/]+/read|/cours/[^/]+|/en/lessons/[^/]+|/cours/[^/]+/lire|/en/lessons/[^/]+/read|/connexion|/en/login|/qui\-etudie|/en/who\-is\-studying|/tarifs|/en/pricing|/abonnement|/en/subscription|/compte|/en/account|/mes\-acces|/en/my\-access|/historique|/en/history|/carnet|/en/notebook|/mes\-paiements|/en/my\-payments|/espace\-revendeur|/en/reseller\-area|/devenir\-revendeur|/en/become\-a\-reseller|/quiz|/en/quiz|/quiz/essai|/en/quiz/trial|/quiz/essai/resultat|/en/quiz/trial/result|/quiz/essai/[^/]+/[^/]+/[^/]+|/en/quiz/trial/[^/]+/[^/]+/[^/]+|/quiz/session/[^/]+|/en/quiz/session/[^/]+|/quiz/session/[^/]+/resultat|/en/quiz/session/[^/]+/result|/historique/quiz/[^/]+|/en/history/quiz/[^/]+|/revision|/en/revision|/parcours|/en/learning\-paths|/parcours/[^/]+|/en/learning\-paths/[^/]+|/inedit/tentative/[^/]+|/en/mock/attempt/[^/]+|/inedit/tentative/[^/]+/resultat|/en/mock/attempt/[^/]+/result|/simulation/[^/]+|/en/simulation/[^/]+|/simulation/[^/]+/resultat|/en/simulation/[^/]+/result|/fiches|/en/study\-sheets|/confidentialite|/en/privacy|/cgu|/en/terms|/a\-propos|/en/about|/aide|/en/help|/aide/[^/]+|/en/help/[^/]+|/[a-z]{2}/epreuves|/en/[a-z]{2}/past\-papers|/[a-z]{2}/examens/[^/]+|/en/[a-z]{2}/exams/[^/]+|/[a-z]{2}/recherche|/en/[a-z]{2}/search|/[a-z]{2}/themes\-frequents|/en/[a-z]{2}/frequent\-topics|/[a-z]{2}/themes\-frequents/[^/]+/exercices|/en/[a-z]{2}/frequent\-topics/[^/]+/exercises|/[a-z]{2}/themes\-frequents/[^/]+/exercices/[^/]+|/en/[a-z]{2}/frequent\-topics/[^/]+/exercises/[^/]+|/[a-z]{2}/cours|/en/[a-z]{2}/lessons|/[a-z]{2}/epreuves/[^/]+|/en/[a-z]{2}/past\-papers/[^/]+|/[a-z]{2}/epreuves/[^/]+/lire|/en/[a-z]{2}/past\-papers/[^/]+/read|/[a-z]{2}/epreuves\-inedites/[^/]+|/en/[a-z]{2}/mock\-papers/[^/]+)/?$
        not file {
            root /srv/frontend
            try_files {path}
        }
    }
    handle @bot_adresse_inconnue {
        header Cache-Control "no-store"
        respond "Not found" 404
    }
    # <<< routes-spa-connues

    # Toute autre adresse = une page de l'application : index.html, à revalider à chaque visite (il
    # référence les fichiers hashés de la version courante). Sans en-tête, le navigateur appliquait
    # une fraîcheur « heuristique » à la page.
    handle {
        root * /srv/frontend
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }

    # Une erreur sur /assets ou /media ne doit jamais hériter du cache d'un an posé plus haut.
    handle_errors {
        @erreur_fichier path /assets/* /media/*
        handle @erreur_fichier {
            header Cache-Control "no-store"
            respond "Not found" {err.status_code}
        }
    }
}
