{$SITE_DOMAIN::80} {
    encode zstd gzip

    # Indexable par défaut (prod). Un environnement de recette/staging qui ne doit pas être
    # référencé définit ROBOTS_TAG="noindex, nofollow, noarchive" dans son .env (lu par ce
    # conteneur via env_file) - jamais en dur ici : un noindex global sur toutes les réponses,
    # sitemap.xml et robots.txt compris, rendait le sitemap inutile.
    header {
        X-Robots-Tag "{$ROBOTS_TAG:index, follow}"
    }

    # Point d'entrée de l'app et service worker : jamais servis depuis un cache sans
    # revalidation, sinon une nouvelle version ne parviendrait plus aux visiteurs qui ont
    # déjà l'ancienne (incident qui avait fait désactiver la PWA, voir frontend/src/main.tsx).
    @points_d_entree path / /index.html /sw.js /push-sw.js /registerSW.js /manifest.webmanifest
    header @points_d_entree Cache-Control "no-cache"

    # >>> redirections-segments-en (GÉNÉRÉ par scripts/generer_caddy_segments.py : ne pas modifier à la main)
    # Une URL anglaise portant encore des segments français (/en/cm/epreuves/x) est redirigée en 301 vers sa forme
    # anglaise (/en/cm/past-papers/x) : une page, une adresse. La query est conservée (sans « ? » orphelin).
    map {http.request.uri.query} {qs_en} {
        ""      ""
        default "?{http.request.uri.query}"
    }
    @seg_en_1 path_regexp seg1 ^/en/epreuves/([^/]+)/?$
    redir @seg_en_1 /en/past-papers/{re.seg1.1}{qs_en} 301
    @seg_en_2 path_regexp seg2 ^/en/epreuves/([^/]+)/lire/?$
