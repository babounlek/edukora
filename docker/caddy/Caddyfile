{$SITE_DOMAIN::80} {
    encode zstd gzip

    # Indexable par défaut (prod). Un environnement de recette/staging qui ne doit pas être
    # référencé définit ROBOTS_TAG="noindex, nofollow, noarchive" dans son .env (lu par ce
    # conteneur via env_file) - jamais en dur ici : un noindex global sur toutes les réponses,
    # sitemap.xml et robots.txt compris, rendait le sitemap inutile.
    header {
        X-Robots-Tag "{$ROBOTS_TAG:index, follow}"
    }

    # Fichiers de /assets : le nom contient le hash du contenu (Vite), un fichier ne change
    # jamais sous un même nom - cache navigateur d'un an, aucune revalidation aux visites
    # suivantes (sur une connexion mobile lente, c'est ce qui fait la différence entre
    # « chargement instantané » et « tout re-télécharger »).
    @assets_hashes path /assets/*
    header @assets_hashes Cache-Control "public, max-age=31536000, immutable"

    # Point d'entrée de l'app et service worker : jamais servis depuis un cache sans
    # revalidation, sinon une nouvelle version ne parviendrait plus aux visiteurs qui ont
    # déjà l'ancienne (incident qui avait fait désactiver la PWA, voir frontend/src/main.tsx).
    @points_d_entree path / /index.html /sw.js /push-sw.js /registerSW.js /manifest.webmanifest
    header @points_d_entree Cache-Control "no-cache"

    # >>> redirections-segments-en (GÉNÉRÉ par scripts/generer_caddy_segments.py : ne pas modifier à la main)
    # Une URL anglaise portant encore des segments français (/en/cm/epreuves/x) est redirigée en 301 vers sa forme
    # anglaise (/en/cm/past-papers/x) : une page, une adresse. La query est conservée (sans « ? » orphelin).
    map {http.request.uri.query} {qs_en} {
        ""      ""
        default "?{http.request.uri.query}"
    }
    @seg_en_1 path_regexp seg1 ^/en/epreuves/([^/]+)/?$
    redir @seg_en_1 /en/past-papers/{re.seg1.1}{qs_en} 301
    @seg_en_2 path_regexp seg2 ^/en/epreuves/([^/]+)/lire/?$
    redir @seg_en_2 /en/past-papers/{re.seg2.1}/read{qs_en} 301
    @seg_en_3 path_regexp seg3 ^/en/cours/([^/]+)/?$
    redir @seg_en_3 /en/lessons/{re.seg3.1}{qs_en} 301
    @seg_en_4 path_regexp seg4 ^/en/cours/([^/]+)/lire/?$
    redir @seg_en_4 /en/lessons/{re.seg4.1}/read{qs_en} 301
    @seg_en_5 path_regexp seg5 ^/en/connexion/?$
    redir @seg_en_5 /en/login{qs_en} 301
    @seg_en_6 path_regexp seg6 ^/en/qui-etudie/?$
    redir @seg_en_6 /en/who-is-studying{qs_en} 301
    @seg_en_7 path_regexp seg7 ^/en/tarifs/?$
    redir @seg_en_7 /en/pricing{qs_en} 301
    @seg_en_8 path_regexp seg8 ^/en/abonnement/?$
    redir @seg_en_8 /en/subscription{qs_en} 301
    @seg_en_9 path_regexp seg9 ^/en/compte/?$
    redir @seg_en_9 /en/account{qs_en} 301
    @seg_en_10 path_regexp seg10 ^/en/mes-acces/?$
    redir @seg_en_10 /en/my-access{qs_en} 301
    @seg_en_11 path_regexp seg11 ^/en/historique/?$
    redir @seg_en_11 /en/history{qs_en} 301
    @seg_en_12 path_regexp seg12 ^/en/carnet/?$
    redir @seg_en_12 /en/notebook{qs_en} 301
    @seg_en_13 path_regexp seg13 ^/en/mes-paiements/?$
    redir @seg_en_13 /en/my-payments{qs_en} 301
    @seg_en_14 path_regexp seg14 ^/en/espace-revendeur/?$
    redir @seg_en_14 /en/reseller-area{qs_en} 301
    @seg_en_15 path_regexp seg15 ^/en/devenir-revendeur/?$
    redir @seg_en_15 /en/become-a-reseller{qs_en} 301
    @seg_en_16 path_regexp seg16 ^/en/quiz/essai/?$
    redir @seg_en_16 /en/quiz/trial{qs_en} 301
    @seg_en_17 path_regexp seg17 ^/en/quiz/essai/resultat/?$
    redir @seg_en_17 /en/quiz/trial/result{qs_en} 301
    @seg_en_18 path_regexp seg18 ^/en/quiz/essai/([^/]+)/([^/]+)/([^/]+)/?$
    redir @seg_en_18 /en/quiz/trial/{re.seg18.1}/{re.seg18.2}/{re.seg18.3}{qs_en} 301
    @seg_en_19 path_regexp seg19 ^/en/quiz/session/([^/]+)/resultat/?$
    redir @seg_en_19 /en/quiz/session/{re.seg19.1}/result{qs_en} 301
    @seg_en_20 path_regexp seg20 ^/en/historique/quiz/([^/]+)/?$
    redir @seg_en_20 /en/history/quiz/{re.seg20.1}{qs_en} 301
    @seg_en_21 path_regexp seg21 ^/en/parcours/?$
    redir @seg_en_21 /en/learning-paths{qs_en} 301
    @seg_en_22 path_regexp seg22 ^/en/parcours/([^/]+)/?$
    redir @seg_en_22 /en/learning-paths/{re.seg22.1}{qs_en} 301
    @seg_en_23 path_regexp seg23 ^/en/inedit/tentative/([^/]+)/?$
    redir @seg_en_23 /en/mock/attempt/{re.seg23.1}{qs_en} 301
    @seg_en_24 path_regexp seg24 ^/en/inedit/tentative/([^/]+)/resultat/?$
    redir @seg_en_24 /en/mock/attempt/{re.seg24.1}/result{qs_en} 301
    @seg_en_25 path_regexp seg25 ^/en/simulation/([^/]+)/resultat/?$
    redir @seg_en_25 /en/simulation/{re.seg25.1}/result{qs_en} 301
    @seg_en_26 path_regexp seg26 ^/en/fiches/?$
    redir @seg_en_26 /en/study-sheets{qs_en} 301
    @seg_en_27 path_regexp seg27 ^/en/confidentialite/?$
    redir @seg_en_27 /en/privacy{qs_en} 301
    @seg_en_28 path_regexp seg28 ^/en/cgu/?$
    redir @seg_en_28 /en/terms{qs_en} 301
    @seg_en_29 path_regexp seg29 ^/en/a-propos/?$
    redir @seg_en_29 /en/about{qs_en} 301
    @seg_en_30 path_regexp seg30 ^/en/([a-z]{2})/epreuves/?$
    redir @seg_en_30 /en/{re.seg30.1}/past-papers{qs_en} 301
    @seg_en_31 path_regexp seg31 ^/en/([a-z]{2})/recherche/?$
    redir @seg_en_31 /en/{re.seg31.1}/search{qs_en} 301
    @seg_en_32 path_regexp seg32 ^/en/([a-z]{2})/themes-frequents/?$
    redir @seg_en_32 /en/{re.seg32.1}/frequent-topics{qs_en} 301
    @seg_en_33 path_regexp seg33 ^/en/([a-z]{2})/themes-frequents/([^/]+)/exercices/?$
    redir @seg_en_33 /en/{re.seg33.1}/frequent-topics/{re.seg33.2}/exercises{qs_en} 301
    @seg_en_34 path_regexp seg34 ^/en/([a-z]{2})/themes-frequents/([^/]+)/exercices/([^/]+)/?$
    redir @seg_en_34 /en/{re.seg34.1}/frequent-topics/{re.seg34.2}/exercises/{re.seg34.3}{qs_en} 301
    @seg_en_35 path_regexp seg35 ^/en/([a-z]{2})/cours/?$
    redir @seg_en_35 /en/{re.seg35.1}/lessons{qs_en} 301
    @seg_en_36 path_regexp seg36 ^/en/([a-z]{2})/epreuves/([^/]+)/?$
    redir @seg_en_36 /en/{re.seg36.1}/past-papers/{re.seg36.2}{qs_en} 301
    @seg_en_37 path_regexp seg37 ^/en/([a-z]{2})/epreuves/([^/]+)/lire/?$
    redir @seg_en_37 /en/{re.seg37.1}/past-papers/{re.seg37.2}/read{qs_en} 301
    @seg_en_38 path_regexp seg38 ^/en/([a-z]{2})/epreuves-inedites/([^/]+)/?$
    redir @seg_en_38 /en/{re.seg38.1}/mock-papers/{re.seg38.2}{qs_en} 301
    # <<< redirections-segments-en

    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }


    # Robots d'aspiration pour l'IA : jamais de PDF. C'est un filtre de courtoisie (le User-Agent se falsifie) : la vraie
    # protection est le quota quotidien côté Django (backend/access/quota.py), qui s'applique à tout client. Les robots
    # d'aperçu de lien (WhatsApp, Facebook...) ne sont pas dans cette liste.
    @robots_ia_pdf {
        header_regexp User-Agent (?i)(gptbot|chatgpt-user|oai-searchbot|claudebot|claude-web|anthropic-ai|ccbot|bytespider|perplexitybot|google-extended|amazonbot|applebot-extended|meta-externalagent|cohere-ai|diffbot)
        path_regexp ^/(access/cours/pdf/|access/lessons/|inedit/epreuves/[0-9]+/sujet\.pdf|fiches/[0-9]+/(sujet|corrige)\.pdf|quiz/sessions/[0-9]+/(sujet|corrige)\.pdf)
    }
    handle @robots_ia_pdf {
        respond "Forbidden" 403
    }

    # PDF « sujet » des épreuves (Lesson.sujet_pdf) : plus servis en direct. Ils passent par
    # /access/lessons/<id>/sujet.pdf (Django), qui compte le téléchargement dans le quota quotidien
    # (backend/access/quota.py) - sans ce blocage, une adresse /media/sujets_pdf/... contournerait le quota.
    # Le dossier *_avant_filigrane est une sauvegarde interne, jamais à servir.
    @pdf_sujets_prives path /media/sujets_pdf/* /media/sujets_pdf_avant_filigrane/*
    handle @pdf_sujets_prives {
        respond "Not found" 404
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    # /quiz/sessions*, /quiz/revisions* et /quiz/maitrise* (API DRF, voir quiz/urls.py)
    # et pas /quiz* : le frontend a aussi ses propres routes sous /quiz (page de
    # démarrage "/quiz", pages de session "/quiz/session/:id") - un simple préfixe
    # /quiz* les envoyait toutes à Django, qui n'a pourtant aucune route pour elles
    # (404 constaté en prod après rebuild), au lieu de laisser le handler générique
    # ci-dessous servir la SPA. Même piège reproduit puis corrigé pour /inedit* : le
    # frontend a ses propres routes sous /inedit ("/inedit", "/inedit/tentative/:id",
    # ".../resultat", volontairement au singulier "tentative") - seuls les sous-chemins
    # d'API réels de inedit/urls.py (au pluriel "tentatives") sont routés vers Django.
    # /fiches/* (avec le slash final, pas /fiches*) : le frontend a sa propre page à
    # "/fiches" (sans slash, voir App.tsx) tandis que toute l'API fiches.urls vit sous
    # "/fiches/..." (avec slash, y compris la création "POST /fiches/") - même trailing
    # slash qui distingue déjà "/quiz"/"/inedit" (pages) de leurs sous-chemins d'API,
    # ici c'est le seul signal disponible puisque page et API partagent le même mot.
    # /whatsapp* sans cette subtilité : contrairement à /quiz, /inedit, /fiches, le
    # frontend n'a AUCUNE page sous ce mot (l'opt-in vit dans /compte) - rien à
    # distinguer, tout /whatsapp* va à Django.
    # /quiz/xp* (objectif d'XP du jour) est une API aussi, ajoutée avec les trois suivantes.
    # /quiz/essais* (essai gratuit sans compte, voir quiz/essai.py) : avec le S, jamais /quiz/essai* - le frontend
    # a ses propres pages "/quiz/essai" et "/quiz/essai/resultat" (App.tsx), qui doivent rester servies par la SPA.
    # /quiz/accueil*, /quiz/priorites*, /quiz/bilan-periode* : trois routes d'API de
    # quiz/urls.py qui manquaient à cette liste - Caddy répondait 405 (fichier
    # statique, GET/HEAD seulement) à leur preflight CORS depuis le serveur de dev, et
    # servait index.html en prod. Toute nouvelle route sous /quiz/ doit être ajoutée ici.
    # /recherche/* (recherche globale, voir recherche/urls.py) : avec le slash final, par la même
    # logique que /fiches/* - la page de résultats du frontend est "/:pays/recherche", jamais
    # un chemin qui COMMENCE par /recherche, mais autant ne rien laisser d'ambigu.
    # /healthz : contrôle de déploiement (deploy/deploy.sh), voir edtech_cm/health.py.
    @backend path /healthz /admin* /auth* /catalog* /subscriptions* /payments* /revendeurs* /access* /quiz/sessions* /quiz/revisions* /quiz/maitrise* /quiz/subjects* /quiz/parcours* /quiz/plan-du-jour* /quiz/matieres* /quiz/accueil* /quiz/priorites* /quiz/bilan-periode* /quiz/xp* /quiz/essais* /quiz/en-cours* /quiz/historique* /analytics* /inedit/mes-inscriptions* /inedit/mes-tentatives* /inedit/epreuves* /inedit/tentatives* /fiches/* /whatsapp* /relances* /recherche/* /simulations* /partage-apercu* /partage-image/* /sitemap.xml /sitemap-*.xml
    handle @backend {
        reverse_proxy backend:8000
    }

    # Aperçu des liens partagés : les robots de WhatsApp, Facebook, Telegram... ne lancent pas le
    # JavaScript de la SPA, donc ne voient que les balises génériques d'index.html. Pour les pages
    # d'épreuve, de cours et d'épreuve inédite, ils reçoivent à la place une page de balises <meta>
    # propres au contenu (voir backend/catalog/apercu_partage.py). Les visiteurs n'y passent jamais.
    # Les deux jeux de segments : français (/cm/epreuves/x) et anglais (/en/cm/past-papers/x, voir
    # frontend/src/lib/i18n/segments-url.json) ; un test vérifie qu'ils couvrent toutes les routes de détail.
    @robots_apercu {
        header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest)
        path_regexp ^/(en/)?([a-z]{2}/)?(epreuves|past-papers|cours|lessons|epreuves-inedites|mock-papers)/[^/]+(/lire|/read)?/?$
    }
    # Le quiz gratuit partagé : /quiz/essai/<cursus>/<matière>/<thème> (identifiants numériques, pas de pays) et sa
    # forme anglaise /en/quiz/trial/... ; /quiz/essai tout court et /quiz/essai/resultat restent à la SPA.
    @robots_apercu_quiz {
        header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest)
        path_regexp ^/(en/quiz/trial|quiz/essai)/[0-9]+/[0-9]+/[0-9]+/?$
    }
    handle @robots_apercu_quiz {
        rewrite * /partage-apercu{path}
        reverse_proxy backend:8000
    }
    handle @robots_apercu {
        rewrite * /partage-apercu{path}
        reverse_proxy backend:8000
    }

    # Accueil de la version anglaise (/en, /en/cm) : pas de contenu propre, mais l'aperçu générique
    # doit être en anglais (og:locale, description) - sans cette règle, ces robots recevraient les
    # balises françaises d'index.html.
    @robots_apercu_en {
        header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest)
        path_regexp ^/en(/[a-z]{2})?/?$
    }
    handle @robots_apercu_en {
        rewrite * /partage-apercu{path}
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
