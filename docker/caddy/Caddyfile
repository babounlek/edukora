:80 {
    encode zstd gzip


    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }


    handle_path /media/* {
        root * /srv/media
        file_server
    }

    @backend path /admin* /auth* /catalog* /subscriptions* /payments* /access* /quiz* /sitemap.xml /sitemap-*.xml
    handle @backend {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}