# --- Stage 1 : build du frontend Vite ---
FROM node:22-alpine AS frontend-build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend/ .

# Ces variables sont figées dans le bundle JS au moment du build (voir
# frontend/vite.config.ts et frontend/src/api/client.ts) - jamais lues à l'exécution
# du conteneur, donc doivent être fournies ici en ARG, pas via l'env du service caddy
# dans docker-compose.yml (qui n'aurait aucun effet).
ARG VITE_API_BASE_URL=https://edukora.africa
ARG VITE_SITE_NAME=EduKora
ARG VITE_SITE_URL=https://edukora.africa
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_SITE_NAME=${VITE_SITE_NAME} \
    VITE_SITE_URL=${VITE_SITE_URL}

RUN npm run build

# --- Stage 2 : Caddy servant ce build ---
FROM caddy:2-alpine

COPY --from=frontend-build /app/dist /srv/frontend
COPY Caddyfile /etc/caddy/Caddyfile
