(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7525, '2.2', 4, 'Déterminer la célérité des ondes à la surface de l''eau.', '### Rappel de méthode
La célérité d''une onde périodique est reliée à sa longueur d''onde et à sa fréquence par la relation c=λ×f.

### Corrigé
$$c = \lambda\times f = 1{,}0\times10^{-2}\times0{,}75$$
$$c = 7{,}5\times10^{-3}\ \text{m/s} = 7{,}5\ \text{mm/s}$$

### Piège à éviter
Ne pas oublier de convertir λ en mètres avant d''effectuer le calcul (elle est donnée en centimètres dans l''énoncé).

### Conseil
Vérifier l''ordre de grandeur : une célérité de quelques mm/s est cohérente pour des vibrations lentes (0,75Hz) à la surface de l''eau, en régime d''ondes de gravité de faible fréquence.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.197961+00:00'::timestamptz, '2026-08-07T17:11:19.197969+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7525, '2.2', 4, "Déterminer la célérité des ondes à la surface de l'eau.", "### Rappel de méthode\nLa célérité d'une onde périodique est reliée à sa longueur d'onde et à sa fréquence par la relation c=λ×f.\n\n### Corrigé\n$$c = \\lambda\\times f = 1{,}0\\times10^{-2}\\times0{,}75$$\n$$c = 7{,}5\\times10^{-3}\\ \\text{m/s} = 7{,}5\\ \\text{mm/s}$$\n\n### Piège à éviter\nNe pas oublier de convertir λ en mètres avant d'effectuer le calcul (elle est donnée en centimètres dans l'énoncé).\n\n### Conseil\nVérifier l'ordre de grandeur : une célérité de quelques mm/s est cohérente pour des vibrations lentes (0,75Hz) à la surface de l'eau, en régime d'ondes de gravité de faible fréquence.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5fe00>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 197961, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 197969, tzinfo=datetime.timezone.utc)); alias=default
