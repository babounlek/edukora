(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7521, 'cours-definir-la-chute-libre', '', 'La chute libre est le mouvement d''un corps soumis uniquement à son poids, toute autre action (frottement de l''air, poussée d''Archimède, etc.) étant négligée ou absente.', NULL, '2026-08-07T17:11:18.055207+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7521, 'cours-definir-la-chute-libre', '', "La chute libre est le mouvement d'un corps soumis uniquement à son poids, toute autre action (frottement de l'air, poussée d'Archimède, etc.) étant négligée ou absente.", None, datetime.datetime(2026, 8, 7, 17, 11, 18, 55207, tzinfo=datetime.timezone.utc)); alias=default
