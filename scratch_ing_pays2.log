(0.000) INSERT INTO "catalog_exercise_mots_cles_recherche" ("exercise_id", "tag_id") SELECT * FROM UNNEST((ARRAY[7522,7522,7522,7522,7522])::bigint[], (ARRAY[5578,5488,5524,5590,5373])::bigint[]) ON CONFLICT DO NOTHING; args=([7522, 7522, 7522, 7522, 7522], [5578, 5488, 5524, 5590, 5373]); alias=default
(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7522, '1', 1, 'Faire le schéma annoté d''un pendule simple.', '### Rappel de méthode
Un pendule simple est constitué d''une masse ponctuelle suspendue à un fil inextensible et de masse négligeable, oscillant sans frottement autour d''un point fixe.

### Corrigé
Le schéma annoté d''un pendule simple comporte : un point fixe de suspension O, un fil inextensible de longueur L (de masse négligeable), une masse ponctuelle m fixée à l''extrémité libre du fil, la position d''équilibre (verticale, repère de l''angle θ=0), et l''angle d''élongation θ mesuré entre le fil et la verticale à un instant donné.

### Piège à éviter
Ne pas oublier d''indiquer clairement le sens positif conventionnel de l''angle θ, ainsi que la position d''équilibre (verticale) servant de référence.

### Conseil
Toujours représenter, sur le schéma, la longueur L du fil et l''angle θ comme les deux grandeurs caractéristiques nécessaires à l''étude du mouvement du pendule simple.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.232601+00:00'::timestamptz, '2026-08-07T17:11:18.232608+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7522, '1', 1, "Faire le schéma annoté d'un pendule simple.", "### Rappel de méthode\nUn pendule simple est constitué d'une masse ponctuelle suspendue à un fil inextensible et de masse négligeable, oscillant sans frottement autour d'un point fixe.\n\n### Corrigé\nLe schéma annoté d'un pendule simple comporte : un point fixe de suspension O, un fil inextensible de longueur L (de masse négligeable), une masse ponctuelle m fixée à l'extrémité libre du fil, la position d'équilibre (verticale, repère de l'angle θ=0), et l'angle d'élongation θ mesuré entre le fil et la verticale à un instant donné.\n\n### Piège à éviter\nNe pas oublier d'indiquer clairement le sens positif conventionnel de l'angle θ, ainsi que la position d'équilibre (verticale) servant de référence.\n\n### Conseil\nToujours représenter, sur le schéma, la longueur L du fil et l'angle θ comme les deux grandeurs caractéristiques nécessaires à l'étude du mouvement du pendule simple.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e33620>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 232601, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 232608, tzinfo=datetime.timezone.utc)); alias=default
