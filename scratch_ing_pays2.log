(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7521, 'cours-representer-les-autres-forces-qui-sappliquent-sur-am', '', 'Outre la force électromagnétique, une tige pivotant autour d''un axe est soumise à son poids (appliqué en son centre de gravité) et à la réaction de l''axe au point de pivot.', NULL, '2026-08-07T17:11:17.913229+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7521, 'cours-representer-les-autres-forces-qui-sappliquent-sur-am', '', "Outre la force électromagnétique, une tige pivotant autour d'un axe est soumise à son poids (appliqué en son centre de gravité) et à la réaction de l'axe au point de pivot.", None, datetime.datetime(2026, 8, 7, 17, 11, 17, 913229, tzinfo=datetime.timezone.utc)); alias=default
