(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7518, 'B.2', 6, 'Exprimer la vitesse V0 de l''électron à la sortie des plaques d''accélération A et B, en fonction de e, Ux et m.', '### Rappel de méthode
Le théorème de l''énergie cinétique entre O (vitesse nulle) et O'' (sortie des plaques d''accélération) relie la variation d''énergie cinétique au travail de la force électrique, lui-même égal à q·Ux.

### Corrigé
D''après le théorème de l''énergie cinétique entre O et O'' :
$$\dfrac{1}{2}mV_0^2 - 0 = W(\vec{F}) = qU_{AB} = (-e)\times U_x$$
Comme Ux<0, le produit -e×Ux est positif, ce qui est cohérent (l''énergie cinétique augmente bien). En prenant la valeur absolue pour l''expression de la vitesse :
$$V_0 = \sqrt{\dfrac{2e|U_x|}{m}}$$

### Piège à éviter
Ne pas oublier la valeur absolue (ou l''ajustement de signe) : le terme sous la racine doit impérativement être positif pour que V0 soit un réel physique.

### Conseil
Toujours vérifier, après avoir appliqué le théorème de l''énergie cinétique, que le terme obtenu sous la racine carrée est positif ; sinon, revoir le signe de la tension utilisée.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.871323+00:00'::timestamptz, '2026-08-07T17:11:16.871330+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7518, 'B.2', 6, "Exprimer la vitesse V0 de l'électron à la sortie des plaques d'accélération A et B, en fonction de e, Ux et m.", "### Rappel de méthode\nLe théorème de l'énergie cinétique entre O (vitesse nulle) et O' (sortie des plaques d'accélération) relie la variation d'énergie cinétique au travail de la force électrique, lui-même égal à q·Ux.\n\n### Corrigé\nD'après le théorème de l'énergie cinétique entre O et O' :\n$$\\dfrac{1}{2}mV_0^2 - 0 = W(\\vec{F}) = qU_{AB} = (-e)\\times U_x$$\nComme Ux<0, le produit -e×Ux est positif, ce qui est cohérent (l'énergie cinétique augmente bien). En prenant la valeur absolue pour l'expression de la vitesse :\n$$V_0 = \\sqrt{\\dfrac{2e|U_x|}{m}}$$\n\n### Piège à éviter\nNe pas oublier la valeur absolue (ou l'ajustement de signe) : le terme sous la racine doit impérativement être positif pour que V0 soit un réel physique.\n\n### Conseil\nToujours vérifier, après avoir appliqué le théorème de l'énergie cinétique, que le terme obtenu sous la racine carrée est positif ; sinon, revoir le signe de la tension utilisée.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e179e0>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 871323, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 871330, tzinfo=datetime.timezone.utc)); alias=default
