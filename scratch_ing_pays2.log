(0.000) INSERT INTO "catalog_exercise" ("numero_exercice", "points", "enonce_intro_markdown", "enonce_markdown", "corrige_markdown", "incertitudes", "statut", "lesson_id", "created_at", "updated_at") VALUES ('4', '8', '**PARTIE II : ÉVALUATION DES COMPÉTENCES - 16 points**

**Situation problème 1 - 8 points**

Deux élèves étudient deux montages avec une même bobine réelle (résistance interne r=5Ω) : le circuit 1 (RLC libre, avec R=295Ω) présente des oscillations amorties visibles sur un graphe 1 ; le circuit 2 (RLC forcé par un GBF) présente une résonance d''intensité, avec I=0,35sin(100πt) (A) à la résonance sur le graphe 2. L''élève NGANDO affirme que l''amortissement des oscillations du circuit 1 provient uniquement de la dissipation d''énergie dans R, selon la relation dET/dt=-Ri². Document 1 : ET=Econdensateur+Ebobine, avec le rappel mathématique d(x²)/dt=2x(dx/dt). Document 2 propose 4 GBF au choix : A (u=105sin(100πt)), B (u=105sin(200πt)), C (u=105sin(100πt+π/2)), D (u=100sin(100πt)).', '', '', '[]'::jsonb, 'VALIDE', 874, '2026-08-07T17:11:16.980459+00:00'::timestamptz, '2026-08-07T17:11:16.980465+00:00'::timestamptz) RETURNING "catalog_exercise"."id"; args=('4', '8', "**PARTIE II : ÉVALUATION DES COMPÉTENCES - 16 points**\n\n**Situation problème 1 - 8 points**\n\nDeux élèves étudient deux montages avec une même bobine réelle (résistance interne r=5Ω) : le circuit 1 (RLC libre, avec R=295Ω) présente des oscillations amorties visibles sur un graphe 1 ; le circuit 2 (RLC forcé par un GBF) présente une résonance d'intensité, avec I=0,35sin(100πt) (A) à la résonance sur le graphe 2. L'élève NGANDO affirme que l'amortissement des oscillations du circuit 1 provient uniquement de la dissipation d'énergie dans R, selon la relation dET/dt=-Ri². Document 1 : ET=Econdensateur+Ebobine, avec le rappel mathématique d(x²)/dt=2x(dx/dt). Document 2 propose 4 GBF au choix : A (u=105sin(100πt)), B (u=105sin(200πt)), C (u=105sin(100πt+π/2)), D (u=100sin(100πt)).", '', '', <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e166f0>, StatutContenu.VALIDE, 874, datetime.datetime(2026, 8, 7, 17, 11, 16, 980459, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 980465, tzinfo=datetime.timezone.utc)); alias=default
