(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7523, 'B.1', 4, 'Donner la signification des nombres 226 et 88.', '### Rappel de méthode
Dans la notation ᴬ_Z X d''un noyau, A représente le nombre de nucléons (nombre de masse) et Z le nombre de protons (numéro atomique).

### Corrigé
Pour le noyau ²²⁶₈₈Ra :
- **226** est le **nombre de nucléons** (nombre de masse A), c''est-à-dire le nombre total de protons et de neutrons contenus dans le noyau ;
- **88** est le **numéro atomique** (nombre de charge Z), c''est-à-dire le nombre de protons contenus dans le noyau (qui détermine l''élément chimique, ici le radium).

### Piège à éviter
Ne pas inverser A et Z : le nombre de masse (en haut) est toujours supérieur ou égal au numéro atomique (en bas), puisqu''il inclut aussi les neutrons.

### Conseil
Retenir la position conventionnelle de ces deux nombres dans la notation ᴬ_Z X : A en haut à gauche, Z en bas à gauche du symbole chimique.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.588528+00:00'::timestamptz, '2026-08-07T17:11:18.588537+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7523, 'B.1', 4, 'Donner la signification des nombres 226 et 88.', "### Rappel de méthode\nDans la notation ᴬ_Z X d'un noyau, A représente le nombre de nucléons (nombre de masse) et Z le nombre de protons (numéro atomique).\n\n### Corrigé\nPour le noyau ²²⁶₈₈Ra :\n- **226** est le **nombre de nucléons** (nombre de masse A), c'est-à-dire le nombre total de protons et de neutrons contenus dans le noyau ;\n- **88** est le **numéro atomique** (nombre de charge Z), c'est-à-dire le nombre de protons contenus dans le noyau (qui détermine l'élément chimique, ici le radium).\n\n### Piège à éviter\nNe pas inverser A et Z : le nombre de masse (en haut) est toujours supérieur ou égal au numéro atomique (en bas), puisqu'il inclut aussi les neutrons.\n\n### Conseil\nRetenir la position conventionnelle de ces deux nombres dans la notation ᴬ_Z X : A en haut à gauche, Z en bas à gauche du symbole chimique.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5c590>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 588528, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 588537, tzinfo=datetime.timezone.utc)); alias=default
