(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'A.2', 3, 'Écrire les conditions d''équilibre de la tige.', '### Rappel de méthode
À l''équilibre, un solide mobile autour d''un axe fixe doit vérifier le théorème des moments : la somme des moments des forces par rapport à l''axe de rotation est nulle.

### Corrigé
À l''équilibre (angle α constant), le théorème des moments par rapport à l''axe (Δ) passant par A s''écrit :
$$\sum \mathcal{M}_{/(\Delta)}(\vec{F_i}) = 0$$
c''est-à-dire que le moment du poids par rapport à A doit être opposé (en valeur algébrique) au moment de la force électromagnétique par rapport à A (le moment de la réaction d''axe étant nul, celle-ci étant appliquée en A) :
$$\mathcal{M}_{/A}(\vec{P}) + \mathcal{M}_{/A}(\vec{F}) = 0$$

### Piège à éviter
Ne pas oublier que la réaction d''axe, bien que présente dans le bilan des forces, n''intervient jamais dans l''équation des moments par rapport à cet axe.

### Conseil
Toujours choisir l''axe de rotation lui-même comme point de référence pour écrire l''équation des moments : cela élimine automatiquement la force de réaction inconnue en ce point.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:17.914200+00:00'::timestamptz, '2026-08-07T17:11:17.914206+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'A.2', 3, "Écrire les conditions d'équilibre de la tige.", "### Rappel de méthode\nÀ l'équilibre, un solide mobile autour d'un axe fixe doit vérifier le théorème des moments : la somme des moments des forces par rapport à l'axe de rotation est nulle.\n\n### Corrigé\nÀ l'équilibre (angle α constant), le théorème des moments par rapport à l'axe (Δ) passant par A s'écrit :\n$$\\sum \\mathcal{M}_{/(\\Delta)}(\\vec{F_i}) = 0$$\nc'est-à-dire que le moment du poids par rapport à A doit être opposé (en valeur algébrique) au moment de la force électromagnétique par rapport à A (le moment de la réaction d'axe étant nul, celle-ci étant appliquée en A) :\n$$\\mathcal{M}_{/A}(\\vec{P}) + \\mathcal{M}_{/A}(\\vec{F}) = 0$$\n\n### Piège à éviter\nNe pas oublier que la réaction d'axe, bien que présente dans le bilan des forces, n'intervient jamais dans l'équation des moments par rapport à cet axe.\n\n### Conseil\nToujours choisir l'axe de rotation lui-même comme point de référence pour écrire l'équation des moments : cela élimine automatiquement la force de réaction inconnue en ce point.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e31f70>, '', datetime.datetime(2026, 8, 7, 17, 11, 17, 914200, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 914206, tzinfo=datetime.timezone.utc)); alias=default
