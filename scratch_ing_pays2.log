(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7524, 'cours-donner-la-relation-entre-le-potentiel-darret-et-la-frequence', '', 'La relation d''Einstein de l''effet photoélectrique, appliquée à l''énergie cinétique maximale d''un photoélectron, conduit à une relation affine entre U0 et N.', NULL, '2026-08-07T17:11:18.983368+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7524, 'cours-donner-la-relation-entre-le-potentiel-darret-et-la-frequence', '', "La relation d'Einstein de l'effet photoélectrique, appliquée à l'énergie cinétique maximale d'un photoélectron, conduit à une relation affine entre U0 et N.", None, datetime.datetime(2026, 8, 7, 17, 11, 18, 983368, tzinfo=datetime.timezone.utc)); alias=default
