(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'B.1', 5, 'Partie B (3,5 points). Lors d''un corner, EYOBO communique au ballon placé en un point O (origine d''un plan (O;x,y) vertical) une vitesse v0=20m/s faisant un angle α=60° avec l''horizontale (figure 2). L''action de l''air est négligée, g=9,8m/s². Définir la chute libre.', '### Rappel de méthode
La chute libre est le mouvement d''un corps soumis uniquement à son poids, toute autre action (frottement de l''air, poussée d''Archimède, etc.) étant négligée ou absente.

### Corrigé
La **chute libre** est le mouvement d''un solide soumis uniquement à l''action de son poids, à l''exclusion de toute autre force (en particulier les frottements de l''air, ici explicitement négligés dans l''énoncé). Le solide en chute libre possède alors une accélération constante et égale à l''accélération de la pesanteur $\vec{g}$.

### Piège à éviter
Ne pas confondre chute libre avec chute simplement verticale : la chute libre peut avoir une trajectoire quelconque (parabolique dans le cas d''un lancer avec vitesse initiale non verticale), le critère étant l''absence de toute force autre que le poids.

### Conseil
Toujours vérifier, avant d''appliquer les équations de la chute libre, que l''énoncé précise bien que les frottements de l''air (ou toute autre force) sont négligés : c''est la condition nécessaire à la validité du modèle.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.008086+00:00'::timestamptz, '2026-08-07T17:11:18.008092+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'B.1', 5, "Partie B (3,5 points). Lors d'un corner, EYOBO communique au ballon placé en un point O (origine d'un plan (O;x,y) vertical) une vitesse v0=20m/s faisant un angle α=60° avec l'horizontale (figure 2). L'action de l'air est négligée, g=9,8m/s². Définir la chute libre.", "### Rappel de méthode\nLa chute libre est le mouvement d'un corps soumis uniquement à son poids, toute autre action (frottement de l'air, poussée d'Archimède, etc.) étant négligée ou absente.\n\n### Corrigé\nLa **chute libre** est le mouvement d'un solide soumis uniquement à l'action de son poids, à l'exclusion de toute autre force (en particulier les frottements de l'air, ici explicitement négligés dans l'énoncé). Le solide en chute libre possède alors une accélération constante et égale à l'accélération de la pesanteur $\\vec{g}$.\n\n### Piège à éviter\nNe pas confondre chute libre avec chute simplement verticale : la chute libre peut avoir une trajectoire quelconque (parabolique dans le cas d'un lancer avec vitesse initiale non verticale), le critère étant l'absence de toute force autre que le poids.\n\n### Conseil\nToujours vérifier, avant d'appliquer les équations de la chute libre, que l'énoncé précise bien que les frottements de l'air (ou toute autre force) sont négligés : c'est la condition nécessaire à la validité du modèle.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e32f30>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 8086, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 8092, tzinfo=datetime.timezone.utc)); alias=default
