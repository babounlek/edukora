(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7525, '2.1', 3, 'Déterminer la longueur d''onde des vibrations.', '### Rappel de méthode
Pour une onde circulaire à la surface de l''eau, la distance séparant deux crêtes successives est, par définition, la longueur d''onde.

### Corrigé
La distance entre deux crêtes successives correspond directement à la longueur d''onde :
$$\lambda = 1{,}0\ \text{cm} = 1{,}0\times10^{-2}\ \text{m}$$

### Piège à éviter
Ne pas confondre la distance entre deux crêtes successives (une longueur d''onde) avec la distance entre une crête et le creux suivant (une demi-longueur d''onde).

### Conseil
Toujours bien identifier, sur un profil d''onde, si la distance donnée correspond à une période spatiale complète (crête à crête) ou à une demi-période.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.154638+00:00'::timestamptz, '2026-08-07T17:11:19.154647+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7525, '2.1', 3, "Déterminer la longueur d'onde des vibrations.", "### Rappel de méthode\nPour une onde circulaire à la surface de l'eau, la distance séparant deux crêtes successives est, par définition, la longueur d'onde.\n\n### Corrigé\nLa distance entre deux crêtes successives correspond directement à la longueur d'onde :\n$$\\lambda = 1{,}0\\ \\text{cm} = 1{,}0\\times10^{-2}\\ \\text{m}$$\n\n### Piège à éviter\nNe pas confondre la distance entre deux crêtes successives (une longueur d'onde) avec la distance entre une crête et le creux suivant (une demi-longueur d'onde).\n\n### Conseil\nToujours bien identifier, sur un profil d'onde, si la distance donnée correspond à une période spatiale complète (crête à crête) ou à une demi-période.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5fd70>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 154638, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 154647, tzinfo=datetime.timezone.utc)); alias=default
