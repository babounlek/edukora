(0.001) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7523, 'B.2', 5, 'Donner une application de la radioactivité.', '### Rappel de méthode
La radioactivité, malgré sa dangerosité potentielle, offre de nombreuses applications bénéfiques, notamment en médecine et en datation.

### Corrigé
Une application de la radioactivité est la **datation au carbone 14**, qui permet de déterminer l''âge d''objets ou de restes organiques anciens à partir de la décroissance radioactive du carbone 14 qu''ils contiennent. On pourrait également citer la radiothérapie (traitement de certains cancers) ou la production d''énergie électronucléaire.

### Piège à éviter
Ne pas se limiter à des applications dangereuses (armement nucléaire) : privilégier une application scientifique ou médicale bénéfique.

### Conseil
Retenir au moins deux exemples d''applications (une scientifique comme la datation, une médicale comme la radiothérapie) pour pouvoir répondre à toute variante de cette question.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.637421+00:00'::timestamptz, '2026-08-07T17:11:18.637429+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7523, 'B.2', 5, 'Donner une application de la radioactivité.', "### Rappel de méthode\nLa radioactivité, malgré sa dangerosité potentielle, offre de nombreuses applications bénéfiques, notamment en médecine et en datation.\n\n### Corrigé\nUne application de la radioactivité est la **datation au carbone 14**, qui permet de déterminer l'âge d'objets ou de restes organiques anciens à partir de la décroissance radioactive du carbone 14 qu'ils contiennent. On pourrait également citer la radiothérapie (traitement de certains cancers) ou la production d'énergie électronucléaire.\n\n### Piège à éviter\nNe pas se limiter à des applications dangereuses (armement nucléaire) : privilégier une application scientifique ou médicale bénéfique.\n\n### Conseil\nRetenir au moins deux exemples d'applications (une scientifique comme la datation, une médicale comme la radiothérapie) pour pouvoir répondre à toute variante de cette question.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5c590>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 637421, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 637429, tzinfo=datetime.timezone.utc)); alias=default
