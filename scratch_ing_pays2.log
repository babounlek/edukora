(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7524, '4', 4, 'Déduire du graphe la valeur de W0. On prendra h=6,62×10⁻³⁴J·s.', '### Rappel de méthode
L''ordonnée à l''origine de la droite U0=f(N) vaut -W0/e ; il suffit de lire cette valeur sur le graphe (ou de la calculer à partir de la pente et d''un point) et de multiplier par -e pour obtenir W0.

### Corrigé
**Détermination de la pente** (à partir de deux points bien séparés de la droite moyenne, par exemple les points extrêmes) :
$$a = \dfrac{h}{e} \approx \dfrac{1{,}38-0{,}20}{(8{,}4-5{,}5)\times10^{14}} \approx \dfrac{1{,}18}{2{,}9\times10^{14}} \approx 4{,}1\times10^{-15}\ \text{V·s}$$

**Vérification de cohérence avec h donné :**
$$h_{calc} = a\times e \approx 4{,}1\times10^{-15}\times1{,}6\times10^{-19} \approx 6{,}5\times10^{-34}\ \text{J·s}$$
Cette valeur est bien cohérente avec h=6,62×10⁻³⁴J·s donné, ce qui valide la lecture graphique.

**Ordonnée à l''origine** (lue sur le graphe, ou calculée par b=U0-aN à partir d''un point de la droite) :
$$b \approx -2{,}0\ \text{V}$$

**Énergie d''extraction :**
$$W_0 = -b\times e \approx 2{,}0\times1{,}6\times10^{-19} \approx 3{,}2\times10^{-19}\ \text{J} \approx 2{,}0\ \text{eV}$$

### Piège à éviter
Ne pas oublier que l''ordonnée à l''origine lue sur le graphe (en volts) doit être multipliée par e pour obtenir W0 en joules, et non directement utilisée comme une énergie.

### Conseil
Toujours croiser deux méthodes (lecture directe de l''ordonnée à l''origine, et calcul de la pente comparé à h/e donné) pour valider la cohérence de la détermination graphique de W0.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.984427+00:00'::timestamptz, '2026-08-07T17:11:18.984433+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7524, '4', 4, 'Déduire du graphe la valeur de W0. On prendra h=6,62×10⁻³⁴J·s.', "### Rappel de méthode\nL'ordonnée à l'origine de la droite U0=f(N) vaut -W0/e ; il suffit de lire cette valeur sur le graphe (ou de la calculer à partir de la pente et d'un point) et de multiplier par -e pour obtenir W0.\n\n### Corrigé\n**Détermination de la pente** (à partir de deux points bien séparés de la droite moyenne, par exemple les points extrêmes) :\n$$a = \\dfrac{h}{e} \\approx \\dfrac{1{,}38-0{,}20}{(8{,}4-5{,}5)\\times10^{14}} \\approx \\dfrac{1{,}18}{2{,}9\\times10^{14}} \\approx 4{,}1\\times10^{-15}\\ \\text{V·s}$$\n\n**Vérification de cohérence avec h donné :**\n$$h_{calc} = a\\times e \\approx 4{,}1\\times10^{-15}\\times1{,}6\\times10^{-19} \\approx 6{,}5\\times10^{-34}\\ \\text{J·s}$$\nCette valeur est bien cohérente avec h=6,62×10⁻³⁴J·s donné, ce qui valide la lecture graphique.\n\n**Ordonnée à l'origine** (lue sur le graphe, ou calculée par b=U0-aN à partir d'un point de la droite) :\n$$b \\approx -2{,}0\\ \\text{V}$$\n\n**Énergie d'extraction :**\n$$W_0 = -b\\times e \\approx 2{,}0\\times1{,}6\\times10^{-19} \\approx 3{,}2\\times10^{-19}\\ \\text{J} \\approx 2{,}0\\ \\text{eV}$$\n\n### Piège à éviter\nNe pas oublier que l'ordonnée à l'origine lue sur le graphe (en volts) doit être multipliée par e pour obtenir W0 en joules, et non directement utilisée comme une énergie.\n\n### Conseil\nToujours croiser deux méthodes (lecture directe de l'ordonnée à l'origine, et calcul de la pente comparé à h/e donné) pour valider la cohérence de la détermination graphique de W0.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e17c80>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 984427, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 984433, tzinfo=datetime.timezone.utc)); alias=default
