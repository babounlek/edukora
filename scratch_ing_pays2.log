(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7519, 'cours-examiner-la-declaration-de-leleve-ngando', '', 'Dans un circuit RLC réel, la bobine possède elle-même une résistance interne r qui dissipe également de l''énergie par effet Joule ; la puissance totale dissipée doit donc tenir compte de R **et** de r, et se retrouve en dérivant l''énergie totale ET=Econdensateur+Ebobine à l''aide de la loi des mailles du circuit.', NULL, '2026-08-07T17:11:17.038394+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7519, 'cours-examiner-la-declaration-de-leleve-ngando', '', "Dans un circuit RLC réel, la bobine possède elle-même une résistance interne r qui dissipe également de l'énergie par effet Joule ; la puissance totale dissipée doit donc tenir compte de R **et** de r, et se retrouve en dérivant l'énergie totale ET=Econdensateur+Ebobine à l'aide de la loi des mailles du circuit.", None, datetime.datetime(2026, 8, 7, 17, 11, 17, 38394, tzinfo=datetime.timezone.utc)); alias=default
