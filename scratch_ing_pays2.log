(0.000) INSERT INTO "catalog_exercise" ("numero_exercice", "points", "enonce_intro_markdown", "enonce_markdown", "corrige_markdown", "incertitudes", "statut", "lesson_id", "created_at", "updated_at") VALUES ('5', '8', '**Exercice 5 (8 points)**

**Situation problème 2 - 8 points**

Un vendeur propose des lampes fonctionnant selon deux modes (continu et intermittent/stroboscopique), caractérisées par une plaque signalétique indiquant fe=20Hz (mode intermittent) et λ=580nm (mode continu). Les élèves réalisent deux expériences pour vérifier la conformité de ces caractéristiques avant de valider la commande. Expérience 1 : un vibreur crée des rides circulaires concentriques à la surface de l''eau (célérité c=0,4m/s) ; sous l''éclairage stroboscopique de fréquence fe, les rides paraissent immobiles ; la distance entre la 1ère et la 21e ride vaut d=20cm. Expérience 2 : deux lampes identiques, placées à une hauteur h=3m et distantes de a=0,116cm, éclairent la surface de l''eau ; un flotteur au point A, situé à une distance OA=14,925cm du point O (projeté du milieu des deux lampes), apparaît invisible (point sombre).', '', '', '[]'::jsonb, 'VALIDE', 874, '2026-08-07T17:11:17.099031+00:00'::timestamptz, '2026-08-07T17:11:17.099038+00:00'::timestamptz) RETURNING "catalog_exercise"."id"; args=('5', '8', "**Exercice 5 (8 points)**\n\n**Situation problème 2 - 8 points**\n\nUn vendeur propose des lampes fonctionnant selon deux modes (continu et intermittent/stroboscopique), caractérisées par une plaque signalétique indiquant fe=20Hz (mode intermittent) et λ=580nm (mode continu). Les élèves réalisent deux expériences pour vérifier la conformité de ces caractéristiques avant de valider la commande. Expérience 1 : un vibreur crée des rides circulaires concentriques à la surface de l'eau (célérité c=0,4m/s) ; sous l'éclairage stroboscopique de fréquence fe, les rides paraissent immobiles ; la distance entre la 1ère et la 21e ride vaut d=20cm. Expérience 2 : deux lampes identiques, placées à une hauteur h=3m et distantes de a=0,116cm, éclairent la surface de l'eau ; un flotteur au point A, situé à une distance OA=14,925cm du point O (projeté du milieu des deux lampes), apparaît invisible (point sombre).", '', '', <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e17530>, StatutContenu.VALIDE, 874, datetime.datetime(2026, 8, 7, 17, 11, 17, 99031, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 99038, tzinfo=datetime.timezone.utc)); alias=default
