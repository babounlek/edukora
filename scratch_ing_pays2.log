(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'B.3', 7, 'En déduire l''équation de sa trajectoire.', '### Rappel de méthode
L''équation de la trajectoire s''obtient en éliminant le temps t entre les deux lois horaires x(t) et y(t).

### Corrigé
De la loi horaire $x=(v_0\cos\alpha)t$, on tire $t=\dfrac{x}{v_0\cos\alpha}$. En substituant dans y(t) :
$$y = (v_0\sin\alpha)\times\dfrac{x}{v_0\cos\alpha} - \dfrac{1}{2}g\left(\dfrac{x}{v_0\cos\alpha}\right)^2$$
$$y = x\tan\alpha - \dfrac{g}{2v_0^2\cos^2\alpha}x^2$$
C''est l''équation d''une **parabole**, caractéristique de la chute libre avec vitesse initiale non verticale.

### Piège à éviter
Ne pas oublier le carré sur x dans le second terme (erreur fréquente lors de la substitution de t²).

### Conseil
Vérifier que l''équation obtenue est bien de la forme y=ax-bx² (parabole passant par l''origine avec une pente initiale tanα), cohérente avec la géométrie du lancer.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.104757+00:00'::timestamptz, '2026-08-07T17:11:18.104767+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'B.3', 7, "En déduire l'équation de sa trajectoire.", "### Rappel de méthode\nL'équation de la trajectoire s'obtient en éliminant le temps t entre les deux lois horaires x(t) et y(t).\n\n### Corrigé\nDe la loi horaire $x=(v_0\\cos\\alpha)t$, on tire $t=\\dfrac{x}{v_0\\cos\\alpha}$. En substituant dans y(t) :\n$$y = (v_0\\sin\\alpha)\\times\\dfrac{x}{v_0\\cos\\alpha} - \\dfrac{1}{2}g\\left(\\dfrac{x}{v_0\\cos\\alpha}\\right)^2$$\n$$y = x\\tan\\alpha - \\dfrac{g}{2v_0^2\\cos^2\\alpha}x^2$$\nC'est l'équation d'une **parabole**, caractéristique de la chute libre avec vitesse initiale non verticale.\n\n### Piège à éviter\nNe pas oublier le carré sur x dans le second terme (erreur fréquente lors de la substitution de t²).\n\n### Conseil\nVérifier que l'équation obtenue est bien de la forme y=ax-bx² (parabole passant par l'origine avec une pente initiale tanα), cohérente avec la géométrie du lancer.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e32f90>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 104757, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 104767, tzinfo=datetime.timezone.utc)); alias=default
