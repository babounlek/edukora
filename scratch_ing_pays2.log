(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7525, '3.1', 5, 'Représenter sans souci d''échelle le champ électrostatique E⃗I au milieu I du segment [O1O2].', '### Rappel de méthode
Le champ électrostatique créé en un point par une charge ponctuelle positive est dirigé radialement, en s''éloignant de la charge ; le champ résultant en un point est la somme vectorielle des champs créés par chaque charge.

### Corrigé
Au point I, milieu du segment [O1O2], le champ créé par la charge q1 (positive) est dirigé de O1 vers O2 (s''éloignant de q1), tandis que le champ créé par la charge q2 (positive) est dirigé de O2 vers O1 (s''éloignant de q2) : ces deux champs sont donc **colinéaires et de sens opposés**. Le champ résultant $\vec{E_I}=\vec{E_1}+\vec{E_2}$ est représenté selon la direction de la droite (O1O2), dans le sens du champ le plus intense (celui créé par q1, la charge la plus grande), c''est-à-dire orienté de O1 vers O2.

### Piège à éviter
Ne pas oublier que les deux charges étant positives, leurs champs en I sont de sens opposés (et non de même sens comme ce serait le cas pour des charges de signes opposés).

### Conseil
Toujours représenter individuellement les deux champs élémentaires avant de tracer le champ résultant, pour éviter toute erreur de sens.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.239292+00:00'::timestamptz, '2026-08-07T17:11:19.239298+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7525, '3.1', 5, "Représenter sans souci d'échelle le champ électrostatique E⃗I au milieu I du segment [O1O2].", "### Rappel de méthode\nLe champ électrostatique créé en un point par une charge ponctuelle positive est dirigé radialement, en s'éloignant de la charge ; le champ résultant en un point est la somme vectorielle des champs créés par chaque charge.\n\n### Corrigé\nAu point I, milieu du segment [O1O2], le champ créé par la charge q1 (positive) est dirigé de O1 vers O2 (s'éloignant de q1), tandis que le champ créé par la charge q2 (positive) est dirigé de O2 vers O1 (s'éloignant de q2) : ces deux champs sont donc **colinéaires et de sens opposés**. Le champ résultant $\\vec{E_I}=\\vec{E_1}+\\vec{E_2}$ est représenté selon la direction de la droite (O1O2), dans le sens du champ le plus intense (celui créé par q1, la charge la plus grande), c'est-à-dire orienté de O1 vers O2.\n\n### Piège à éviter\nNe pas oublier que les deux charges étant positives, leurs champs en I sont de sens opposés (et non de même sens comme ce serait le cas pour des charges de signes opposés).\n\n### Conseil\nToujours représenter individuellement les deux champs élémentaires avant de tracer le champ résultant, pour éviter toute erreur de sens.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5ce30>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 239292, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 239298, tzinfo=datetime.timezone.utc)); alias=default
