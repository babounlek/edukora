(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7524, '3', 3, 'Donner la relation entre le potentiel d''arrêt et la fréquence de la radiation incidente. Vérifier si cette relation est en accord avec le graphe obtenu.', '### Rappel de méthode
La relation d''Einstein de l''effet photoélectrique, appliquée à l''énergie cinétique maximale d''un photoélectron, conduit à une relation affine entre U0 et N.

### Corrigé
D''après la relation d''Einstein $E_{c,max}=hN-W_0$, et sachant que $eU_0=E_{c,max}$ :
$$eU_0 = hN - W_0 \quad\Longrightarrow\quad U_0 = \dfrac{h}{e}N - \dfrac{W_0}{e}$$
Cette relation est bien **affine** en N (de la forme U0=aN+b, avec a=h/e et b=-W0/e), ce qui est en parfait accord avec le graphe obtenu : les points expérimentaux s''alignent effectivement sur une droite, confirmant la validité de cette relation.

### Piège à éviter
Ne pas oublier que cette relation n''est valable que pour N supérieure à la fréquence seuil N0=W0/h (en dessous de laquelle aucun électron n''est émis, quelle que soit l''intensité lumineuse).

### Conseil
Toujours vérifier la cohérence entre la forme mathématique attendue (ici, une fonction affine) et l''allure du graphe expérimental obtenu, avant de conclure à la validité d''une relation physique.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.931675+00:00'::timestamptz, '2026-08-07T17:11:18.931682+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7524, '3', 3, "Donner la relation entre le potentiel d'arrêt et la fréquence de la radiation incidente. Vérifier si cette relation est en accord avec le graphe obtenu.", "### Rappel de méthode\nLa relation d'Einstein de l'effet photoélectrique, appliquée à l'énergie cinétique maximale d'un photoélectron, conduit à une relation affine entre U0 et N.\n\n### Corrigé\nD'après la relation d'Einstein $E_{c,max}=hN-W_0$, et sachant que $eU_0=E_{c,max}$ :\n$$eU_0 = hN - W_0 \\quad\\Longrightarrow\\quad U_0 = \\dfrac{h}{e}N - \\dfrac{W_0}{e}$$\nCette relation est bien **affine** en N (de la forme U0=aN+b, avec a=h/e et b=-W0/e), ce qui est en parfait accord avec le graphe obtenu : les points expérimentaux s'alignent effectivement sur une droite, confirmant la validité de cette relation.\n\n### Piège à éviter\nNe pas oublier que cette relation n'est valable que pour N supérieure à la fréquence seuil N0=W0/h (en dessous de laquelle aucun électron n'est émis, quelle que soit l'intensité lumineuse).\n\n### Conseil\nToujours vérifier la cohérence entre la forme mathématique attendue (ici, une fonction affine) et l'allure du graphe expérimental obtenu, avant de conclure à la validité d'une relation physique.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5c6e0>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 931675, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 931682, tzinfo=datetime.timezone.utc)); alias=default
