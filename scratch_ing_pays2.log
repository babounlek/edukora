(0.000) SELECT "catalog_rappeldemethode"."id", "catalog_rappeldemethode"."exercise_id", "catalog_rappeldemethode"."external_id", "catalog_rappeldemethode"."competence", "catalog_rappeldemethode"."contenu_markdown", "catalog_rappeldemethode"."cours_id", "catalog_rappeldemethode"."created_at" FROM "catalog_rappeldemethode" WHERE "catalog_rappeldemethode"."external_id" = 'cours-representer-le-champ-electrostatique-ei-au-milieu-i' LIMIT 21; args=('cours-representer-le-champ-electrostatique-ei-au-milieu-i',); alias=default
