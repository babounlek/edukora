(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7519, '1', 1, 'Examiner la déclaration de l''élève NGANDO selon laquelle l''amortissement des oscillations du circuit 1 s''explique par la relation dET/dt=-Ri².', '### Rappel de méthode
Dans un circuit RLC réel, la bobine possède elle-même une résistance interne r qui dissipe également de l''énergie par effet Joule ; la puissance totale dissipée doit donc tenir compte de R **et** de r, et se retrouve en dérivant l''énergie totale ET=Econdensateur+Ebobine à l''aide de la loi des mailles du circuit.

### Corrigé
**Énergie totale du circuit :**
$$E_T = \dfrac{1}{2}Cu_C^2 + \dfrac{1}{2}Li^2$$

**Dérivée par rapport au temps** (en utilisant le rappel d(x²)/dt=2x(dx/dt)) :
$$\dfrac{dE_T}{dt} = Cu_C\dfrac{du_C}{dt} + Li\dfrac{di}{dt}$$

Or $i=C\dfrac{du_C}{dt}$, donc $Cu_C\dfrac{du_C}{dt}=u_C i$. De plus, la loi des mailles du circuit RLC série (R, bobine (L,r), condensateur C) donne : $u_C + L\dfrac{di}{dt} + ri = -Ri$, soit $L\dfrac{di}{dt} = -u_C - ri - Ri$. En remplaçant :
$$\dfrac{dE_T}{dt} = u_C i + i\left(-u_C - ri - Ri\right) = -ri^2 - Ri^2 = -(R+r)i^2$$

**Conclusion :** la déclaration de NGANDO est **incomplète, donc fausse en l''état**. La relation correcte est $\dfrac{dE_T}{dt}=-(R+r)i^2$ et non $-Ri^2$ : la bobine réelle utilisée possède sa propre résistance interne r=5Ω qui dissipe également de l''énergie par effet Joule, en plus de la résistance R du circuit. Négliger r reviendrait à sous-estimer l''amortissement réel observé sur le graphe 1.

### Piège à éviter
Ne pas oublier que "bobine réelle" signifie systématiquement une bobine possédant une résistance interne non nulle r, qui doit apparaître dans le bilan énergétique au même titre que R.

### Conseil
Toujours partir de l''énergie totale ET et la dériver rigoureusement à l''aide de la loi des mailles, plutôt que d''affirmer directement une formule de dissipation : cette méthode permet de détecter immédiatement les termes de dissipation manquants (ici, celui associé à r).', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.986816+00:00'::timestamptz, '2026-08-07T17:11:16.986823+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7519, '1', 1, "Examiner la déclaration de l'élève NGANDO selon laquelle l'amortissement des oscillations du circuit 1 s'explique par la relation dET/dt=-Ri².", '### Rappel de méthode\nDans un circuit RLC réel, la bobine possède elle-même une résistance interne r qui dissipe également de l\'énergie par effet Joule ; la puissance totale dissipée doit donc tenir compte de R **et** de r, et se retrouve en dérivant l\'énergie totale ET=Econdensateur+Ebobine à l\'aide de la loi des mailles du circuit.\n\n### Corrigé\n**Énergie totale du circuit :**\n$$E_T = \\dfrac{1}{2}Cu_C^2 + \\dfrac{1}{2}Li^2$$\n\n**Dérivée par rapport au temps** (en utilisant le rappel d(x²)/dt=2x(dx/dt)) :\n$$\\dfrac{dE_T}{dt} = Cu_C\\dfrac{du_C}{dt} + Li\\dfrac{di}{dt}$$\n\nOr $i=C\\dfrac{du_C}{dt}$, donc $Cu_C\\dfrac{du_C}{dt}=u_C i$. De plus, la loi des mailles du circuit RLC série (R, bobine (L,r), condensateur C) donne : $u_C + L\\dfrac{di}{dt} + ri = -Ri$, soit $L\\dfrac{di}{dt} = -u_C - ri - Ri$. En remplaçant :\n$$\\dfrac{dE_T}{dt} = u_C i + i\\left(-u_C - ri - Ri\\right) = -ri^2 - Ri^2 = -(R+r)i^2$$\n\n**Conclusion :** la déclaration de NGANDO est **incomplète, donc fausse en l\'état**. La relation correcte est $\\dfrac{dE_T}{dt}=-(R+r)i^2$ et non $-Ri^2$ : la bobine réelle utilisée possède sa propre résistance interne r=5Ω qui dissipe également de l\'énergie par effet Joule, en plus de la résistance R du circuit. Négliger r reviendrait à sous-estimer l\'amortissement réel observé sur le graphe 1.\n\n### Piège à éviter\nNe pas oublier que "bobine réelle" signifie systématiquement une bobine possédant une résistance interne non nulle r, qui doit apparaître dans le bilan énergétique au même titre que R.\n\n### Conseil\nToujours partir de l\'énergie totale ET et la dériver rigoureusement à l\'aide de la loi des mailles, plutôt que d\'affirmer directement une formule de dissipation : cette méthode permet de détecter immédiatement les termes de dissipation manquants (ici, celui associé à r).', '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e17890>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 986816, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 986823, tzinfo=datetime.timezone.utc)); alias=default
