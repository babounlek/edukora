(0.000) INSERT INTO "catalog_exercise" ("numero_exercice", "points", "enonce_intro_markdown", "enonce_markdown", "corrige_markdown", "incertitudes", "statut", "lesson_id", "created_at", "updated_at") VALUES ('1', '7', '**EXERCICE 1 : Mouvements dans les champs de force - 7 points**

*Les parties A et B sont indépendantes.*

**Partie A (3,5 points).** Le dispositif ci-après (figure 1) comporte une tige de cuivre AM mobile autour d''un axe horizontal (Δ) perpendiculaire au plan de la figure et passant par A. La tige AM baigne dans un champ magnétique $\vec{B}$ uniforme et son extrémité M plonge dans une cuve de mercure (longueur immergée négligeable). On ferme le circuit : la tige s''écarte de sa position d''équilibre initiale (verticale) d''un angle α vers la droite.', '', '', '[]'::jsonb, 'VALIDE', 886, '2026-08-07T17:11:17.811518+00:00'::timestamptz, '2026-08-07T17:11:17.811525+00:00'::timestamptz) RETURNING "catalog_exercise"."id"; args=('1', '7', "**EXERCICE 1 : Mouvements dans les champs de force - 7 points**\n\n*Les parties A et B sont indépendantes.*\n\n**Partie A (3,5 points).** Le dispositif ci-après (figure 1) comporte une tige de cuivre AM mobile autour d'un axe horizontal (Δ) perpendiculaire au plan de la figure et passant par A. La tige AM baigne dans un champ magnétique $\\vec{B}$ uniforme et son extrémité M plonge dans une cuve de mercure (longueur immergée négligeable). On ferme le circuit : la tige s'écarte de sa position d'équilibre initiale (verticale) d'un angle α vers la droite.", '', '', <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e32840>, StatutContenu.VALIDE, 886, datetime.datetime(2026, 8, 7, 17, 11, 17, 811518, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 811525, tzinfo=datetime.timezone.utc)); alias=default
