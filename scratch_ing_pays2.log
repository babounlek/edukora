(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7523, 'B.4', 7, 'Calculer en MeV l''énergie libérée lors de la désintégration d''un noyau de radium. Données : m(Ra)=225,9771u ; m(Rn)=221,9704u ; m(He)=4,0015u ; 1u=931,5MeV/c².', '### Rappel de méthode
L''énergie libérée par une désintégration nucléaire se calcule à partir du défaut de masse Δm=minitiale-mfinale, converti en énergie via E=Δm×931,5MeV lorsque Δm est exprimé en u.

### Corrigé
**Défaut de masse :**
$$\Delta m = m(Ra) - \left[m(Rn) + m(He)\right] = 225{,}9771 - (221{,}9704 + 4{,}0015)$$
$$\Delta m = 225{,}9771 - 225{,}9719 = 0{,}0052\ u$$

**Énergie libérée :**
$$E = \Delta m\times931{,}5 = 0{,}0052\times931{,}5 \approx 4{,}84\ \text{MeV}$$

### Piège à éviter
Bien respecter le sens de la soustraction (masse initiale moins masse des produits) pour une désintégration spontanée qui libère de l''énergie : un Δm positif signifie une énergie libérée.

### Conseil
Vérifier que la valeur obtenue est cohérente avec les énergies typiques libérées par une désintégration α (de l''ordre de quelques MeV) : ici, E≈4,84MeV est effectivement très proche de la valeur réelle connue pour cette désintégration du radium 226 (≈4,87MeV), ce qui valide fortement le calcul.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.737152+00:00'::timestamptz, '2026-08-07T17:11:18.737159+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7523, 'B.4', 7, "Calculer en MeV l'énergie libérée lors de la désintégration d'un noyau de radium. Données : m(Ra)=225,9771u ; m(Rn)=221,9704u ; m(He)=4,0015u ; 1u=931,5MeV/c².", "### Rappel de méthode\nL'énergie libérée par une désintégration nucléaire se calcule à partir du défaut de masse Δm=minitiale-mfinale, converti en énergie via E=Δm×931,5MeV lorsque Δm est exprimé en u.\n\n### Corrigé\n**Défaut de masse :**\n$$\\Delta m = m(Ra) - \\left[m(Rn) + m(He)\\right] = 225{,}9771 - (221{,}9704 + 4{,}0015)$$\n$$\\Delta m = 225{,}9771 - 225{,}9719 = 0{,}0052\\ u$$\n\n**Énergie libérée :**\n$$E = \\Delta m\\times931{,}5 = 0{,}0052\\times931{,}5 \\approx 4{,}84\\ \\text{MeV}$$\n\n### Piège à éviter\nBien respecter le sens de la soustraction (masse initiale moins masse des produits) pour une désintégration spontanée qui libère de l'énergie : un Δm positif signifie une énergie libérée.\n\n### Conseil\nVérifier que la valeur obtenue est cohérente avec les énergies typiques libérées par une désintégration α (de l'ordre de quelques MeV) : ici, E≈4,84MeV est effectivement très proche de la valeur réelle connue pour cette désintégration du radium 226 (≈4,87MeV), ce qui valide fortement le calcul.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5e030>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 737152, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 737159, tzinfo=datetime.timezone.utc)); alias=default
