(0.000) INSERT INTO "catalog_exercise_mots_cles_recherche" ("exercise_id", "tag_id") SELECT * FROM UNNEST((ARRAY[7526,7526,7526,7526,7526])::bigint[], (ARRAY[3363,5515,3925,5783,3231])::bigint[]) ON CONFLICT DO NOTHING; args=([7526, 7526, 7526, 7526, 7526], [3363, 5515, 3925, 5783, 3231]); alias=default
(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7526, '1', 1, 'En t''aidant des informations ci-dessus, et à l''aide d''une démarche scientifique, départage BEKOLO et TAGNE.', '### Rappel de méthode
La démarche consiste d''abord à calculer la vitesse vB à partir de la relation donnée v0²=vB²+2gr(1-cosα), puis à utiliser le mouvement uniformément accéléré sans vitesse initiale sur AB (vB²=2al) pour en déduire l''accélération a, à comparer ensuite aux deux propositions.

### Corrigé
**Étape 1 : calcul de vB à partir de la relation donnée.**
$$v_0^2 = v_B^2 + 2gr(1-\cos\alpha)$$
$$v_B^2 = v_0^2 - 2gr(1-\cos\alpha) = 4{,}0^2 - 2\times9{,}8\times1{,}0\times(1-\cos60°)$$
$$v_B^2 = 16 - 19{,}6\times(1-0{,}5) = 16 - 9{,}8 = 6{,}2\ \text{m}^2/\text{s}^2$$
$$v_B \approx 2{,}49\ \text{m/s}$$

**Étape 2 : calcul de l''accélération sur AB.** Le mobile part de A sans vitesse initiale (mouvement rectiligne uniformément accéléré) et parcourt la distance l=5,0m pour atteindre B avec la vitesse vB :
$$v_B^2 = 2al \quad\Longrightarrow\quad a = \dfrac{v_B^2}{2l} = \dfrac{6{,}2}{2\times5{,}0} = \dfrac{6{,}2}{10} = 0{,}62\ \text{m/s}^2$$

**Conclusion :** la valeur calculée (a=0,62m/s²) correspond exactement à la proposition de **TAGNE** (a''=0,62m/s²). C''est donc **TAGNE qui a raison** ; la valeur proposée par BEKOLO (2,6m/s²) est erronée.

### Piège à éviter
Ne pas oublier d''utiliser la relation fournie par l''énoncé (v0²=vB²+2gr(1-cosα)) comme étape intermédiaire indispensable pour obtenir vB avant de pouvoir calculer l''accélération sur AB.

### Conseil
Toujours procéder par étapes indépendantes clairement identifiées (ici : d''abord la portion circulaire BO via la relation donnée, puis la portion rectiligne AB via les équations du MRUA) pour départager deux propositions numériques concurrentes.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.341049+00:00'::timestamptz, '2026-08-07T17:11:19.341055+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7526, '1', 1, "En t'aidant des informations ci-dessus, et à l'aide d'une démarche scientifique, départage BEKOLO et TAGNE.", "### Rappel de méthode\nLa démarche consiste d'abord à calculer la vitesse vB à partir de la relation donnée v0²=vB²+2gr(1-cosα), puis à utiliser le mouvement uniformément accéléré sans vitesse initiale sur AB (vB²=2al) pour en déduire l'accélération a, à comparer ensuite aux deux propositions.\n\n### Corrigé\n**Étape 1 : calcul de vB à partir de la relation donnée.**\n$$v_0^2 = v_B^2 + 2gr(1-\\cos\\alpha)$$\n$$v_B^2 = v_0^2 - 2gr(1-\\cos\\alpha) = 4{,}0^2 - 2\\times9{,}8\\times1{,}0\\times(1-\\cos60°)$$\n$$v_B^2 = 16 - 19{,}6\\times(1-0{,}5) = 16 - 9{,}8 = 6{,}2\\ \\text{m}^2/\\text{s}^2$$\n$$v_B \\approx 2{,}49\\ \\text{m/s}$$\n\n**Étape 2 : calcul de l'accélération sur AB.** Le mobile part de A sans vitesse initiale (mouvement rectiligne uniformément accéléré) et parcourt la distance l=5,0m pour atteindre B avec la vitesse vB :\n$$v_B^2 = 2al \\quad\\Longrightarrow\\quad a = \\dfrac{v_B^2}{2l} = \\dfrac{6{,}2}{2\\times5{,}0} = \\dfrac{6{,}2}{10} = 0{,}62\\ \\text{m/s}^2$$\n\n**Conclusion :** la valeur calculée (a=0,62m/s²) correspond exactement à la proposition de **TAGNE** (a'=0,62m/s²). C'est donc **TAGNE qui a raison** ; la valeur proposée par BEKOLO (2,6m/s²) est erronée.\n\n### Piège à éviter\nNe pas oublier d'utiliser la relation fournie par l'énoncé (v0²=vB²+2gr(1-cosα)) comme étape intermédiaire indispensable pour obtenir vB avant de pouvoir calculer l'accélération sur AB.\n\n### Conseil\nToujours procéder par étapes indépendantes clairement identifiées (ici : d'abord la portion circulaire BO via la relation donnée, puis la portion rectiligne AB via les équations du MRUA) pour départager deux propositions numériques concurrentes.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5e390>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 341049, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 341055, tzinfo=datetime.timezone.utc)); alias=default
