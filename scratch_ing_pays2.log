(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7523, 'A.2.2', 3, 'En déduire la longueur d''onde de la radiation utilisée.', '### Rappel de méthode
L''interfrange d''un dispositif à deux sources cohérentes est reliée à la longueur d''onde par la relation i=λD/a.

### Corrigé
De la relation $i=\dfrac{\lambda D}{a}$, on isole λ :
$$\lambda = \dfrac{i\times a}{D} = \dfrac{0{,}7\times10^{-3}\times3\times10^{-3}}{3}$$
$$\lambda = 7\times10^{-7}\ \text{m} = 700\ \text{nm}$$

### Piège à éviter
Ne pas oublier de convertir toutes les longueurs (i, a) en mètres avant d''effectuer le calcul numérique.

### Conseil
Vérifier que la valeur obtenue pour λ appartient bien au domaine du visible (400 à 800nm) : ici, λ=700nm correspond à une lumière rouge, ce qui est un bon indicateur de cohérence physique du résultat.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.542835+00:00'::timestamptz, '2026-08-07T17:11:18.542841+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7523, 'A.2.2', 3, "En déduire la longueur d'onde de la radiation utilisée.", "### Rappel de méthode\nL'interfrange d'un dispositif à deux sources cohérentes est reliée à la longueur d'onde par la relation i=λD/a.\n\n### Corrigé\nDe la relation $i=\\dfrac{\\lambda D}{a}$, on isole λ :\n$$\\lambda = \\dfrac{i\\times a}{D} = \\dfrac{0{,}7\\times10^{-3}\\times3\\times10^{-3}}{3}$$\n$$\\lambda = 7\\times10^{-7}\\ \\text{m} = 700\\ \\text{nm}$$\n\n### Piège à éviter\nNe pas oublier de convertir toutes les longueurs (i, a) en mètres avant d'effectuer le calcul numérique.\n\n### Conseil\nVérifier que la valeur obtenue pour λ appartient bien au domaine du visible (400 à 800nm) : ici, λ=700nm correspond à une lumière rouge, ce qui est un bon indicateur de cohérence physique du résultat.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5d550>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 542835, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 542841, tzinfo=datetime.timezone.utc)); alias=default
