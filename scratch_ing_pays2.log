(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7521, 'cours-appliquer-le-theoreme-du-centre-dinertie-et-determiner-les-lois-horaires', '', 'Le théorème du centre d''inertie appliqué à un solide en chute libre donne une accélération constante égale à g ; les lois horaires s''obtiennent par deux intégrations successives, en utilisant les conditions initiales (position et vitesse à t=0).', NULL, '2026-08-07T17:11:18.103548+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7521, 'cours-appliquer-le-theoreme-du-centre-dinertie-et-determiner-les-lois-horaires', '', "Le théorème du centre d'inertie appliqué à un solide en chute libre donne une accélération constante égale à g ; les lois horaires s'obtiennent par deux intégrations successives, en utilisant les conditions initiales (position et vitesse à t=0).", None, datetime.datetime(2026, 8, 7, 17, 11, 18, 103548, tzinfo=datetime.timezone.utc)); alias=default
