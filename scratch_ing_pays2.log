(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7525, '1.1', 1, 'Écrire l''équation-bilan de cette désintégration.', '### Rappel de méthode
Dans une désintégration β⁻, un neutron du noyau se transforme en proton avec émission d''un électron (et d''un antineutrino) : le nombre de nucléons A reste inchangé, tandis que le numéro atomique Z augmente de 1.

### Corrigé
Le cobalt-60 (Z=27) se désintègre par émission β⁻ en nickel (Z=28), avec conservation du nombre de nucléons (A=60) :
$$^{60}_{27}Co \longrightarrow\ ^{60}_{28}Ni + ^{0}_{-1}e$$
**Vérification des lois de conservation :**
- Nombre de nucléons : 60 = 60 + 0 ✓
- Numéro atomique : 27 = 28 + (-1) ✓

### Piège à éviter
Ne pas oublier que la désintégration β⁻ augmente le numéro atomique de 1 (et non l''inverse, qui correspondrait à une désintégration β⁺).

### Conseil
Retenir que le nickel (Z=28) est bien l''élément suivant le cobalt (Z=27) dans le tableau périodique, cohérent avec l''augmentation de Z lors d''une désintégration β⁻.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.067083+00:00'::timestamptz, '2026-08-07T17:11:19.067090+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7525, '1.1', 1, "Écrire l'équation-bilan de cette désintégration.", "### Rappel de méthode\nDans une désintégration β⁻, un neutron du noyau se transforme en proton avec émission d'un électron (et d'un antineutrino) : le nombre de nucléons A reste inchangé, tandis que le numéro atomique Z augmente de 1.\n\n### Corrigé\nLe cobalt-60 (Z=27) se désintègre par émission β⁻ en nickel (Z=28), avec conservation du nombre de nucléons (A=60) :\n$$^{60}_{27}Co \\longrightarrow\\ ^{60}_{28}Ni + ^{0}_{-1}e$$\n**Vérification des lois de conservation :**\n- Nombre de nucléons : 60 = 60 + 0 ✓\n- Numéro atomique : 27 = 28 + (-1) ✓\n\n### Piège à éviter\nNe pas oublier que la désintégration β⁻ augmente le numéro atomique de 1 (et non l'inverse, qui correspondrait à une désintégration β⁺).\n\n### Conseil\nRetenir que le nickel (Z=28) est bien l'élément suivant le cobalt (Z=27) dans le tableau périodique, cohérent avec l'augmentation de Z lors d'une désintégration β⁻.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5f320>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 67083, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 67090, tzinfo=datetime.timezone.utc)); alias=default
