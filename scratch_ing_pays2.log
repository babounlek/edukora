(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7518, 'B.3', 7, 'Sachant que O''I=l/2 (I étant le point de sortie des plaques de déviation, situé au milieu de celles-ci) et que z=Uz/(4dUx)×x² à l''intérieur des plaques, exprimer la déflexion ZP sur l''écran en fonction de D, l, Ux, Uz et d.', '### Rappel de méthode
La trajectoire parabolique à l''intérieur des plaques de déviation se raccorde, en sortie, à une trajectoire rectiligne dont le prolongement passe par le milieu I des plaques (propriété classique de la parabole) ; la déflexion totale sur l''écran s''obtient alors par un simple théorème de Thalès (proportionnalité des triangles semblables).

### Corrigé
**Pente de la trajectoire à la sortie des plaques (x=l) :**
$$\dfrac{dz}{dx}\bigg|_{x=l} = \dfrac{U_z}{2dU_x}\times l = \dfrac{U_z\,l}{2dU_x}$$

**Par la propriété du prolongement rectiligne passant par I (milieu des plaques, à l''abscisse l/2 de l''entrée) :** la trajectoire rectiligne après les plaques peut être considérée comme partant du point I, situé à une distance (D-l/2) de l''écran. La déflexion totale sur l''écran est alors :
$$Z_P = \dfrac{dz}{dx}\bigg|_{x=l}\times\left(D-\dfrac{l}{2}\right) = \dfrac{U_z\,l}{2dU_x}\left(D-\dfrac{l}{2}\right)$$

### Piège à éviter
Ne pas utiliser la distance totale D directement depuis les plaques : il faut bien utiliser la distance (D-l/2) depuis le point virtuel I, propriété caractéristique de la trajectoire parabolique dans un champ uniforme.

### Conseil
Retenir cette formule classique ZP=(Uz·l)/(2d·Ux)×(D-l/2) comme résultat standard du problème de déflexion électrostatique dans un tube cathodique, applicable dès que la géométrie (l, d, D) et les tensions (Ux, Uz) sont données.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.919243+00:00'::timestamptz, '2026-08-07T17:11:16.919251+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7518, 'B.3', 7, "Sachant que O'I=l/2 (I étant le point de sortie des plaques de déviation, situé au milieu de celles-ci) et que z=Uz/(4dUx)×x² à l'intérieur des plaques, exprimer la déflexion ZP sur l'écran en fonction de D, l, Ux, Uz et d.", "### Rappel de méthode\nLa trajectoire parabolique à l'intérieur des plaques de déviation se raccorde, en sortie, à une trajectoire rectiligne dont le prolongement passe par le milieu I des plaques (propriété classique de la parabole) ; la déflexion totale sur l'écran s'obtient alors par un simple théorème de Thalès (proportionnalité des triangles semblables).\n\n### Corrigé\n**Pente de la trajectoire à la sortie des plaques (x=l) :**\n$$\\dfrac{dz}{dx}\\bigg|_{x=l} = \\dfrac{U_z}{2dU_x}\\times l = \\dfrac{U_z\\,l}{2dU_x}$$\n\n**Par la propriété du prolongement rectiligne passant par I (milieu des plaques, à l'abscisse l/2 de l'entrée) :** la trajectoire rectiligne après les plaques peut être considérée comme partant du point I, situé à une distance (D-l/2) de l'écran. La déflexion totale sur l'écran est alors :\n$$Z_P = \\dfrac{dz}{dx}\\bigg|_{x=l}\\times\\left(D-\\dfrac{l}{2}\\right) = \\dfrac{U_z\\,l}{2dU_x}\\left(D-\\dfrac{l}{2}\\right)$$\n\n### Piège à éviter\nNe pas utiliser la distance totale D directement depuis les plaques : il faut bien utiliser la distance (D-l/2) depuis le point virtuel I, propriété caractéristique de la trajectoire parabolique dans un champ uniforme.\n\n### Conseil\nRetenir cette formule classique ZP=(Uz·l)/(2d·Ux)×(D-l/2) comme résultat standard du problème de déflexion électrostatique dans un tube cathodique, applicable dès que la géométrie (l, d, D) et les tensions (Ux, Uz) sont données.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e16600>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 919243, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 919251, tzinfo=datetime.timezone.utc)); alias=default
