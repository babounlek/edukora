(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7518, 'cours-ecrire-lequation-bilan-de-cette-reaction-2024', '', 'L''écriture d''une équation-bilan nucléaire impose la conservation du nombre de charge Z et du nombre de nucléons A de part et d''autre de la flèche.', NULL, '2026-08-07T17:11:16.774009+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7518, 'cours-ecrire-lequation-bilan-de-cette-reaction-2024', '', "L'écriture d'une équation-bilan nucléaire impose la conservation du nombre de charge Z et du nombre de nucléons A de part et d'autre de la flèche.", None, datetime.datetime(2026, 8, 7, 17, 11, 16, 774009, tzinfo=datetime.timezone.utc)); alias=default
