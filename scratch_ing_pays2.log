(0.000) INSERT INTO "catalog_lesson" ("title", "slug", "subject_id", "lesson_type", "year", "epreuve_source", "origine", "etablissement", "content_markdown", "duree_epreuve", "coefficient", "statut", "published_at", "est_vitrine", "sujet_pdf", "created_at", "updated_at") VALUES ('Physique-Chimie BAC D et TI 2019', 'physique-chimie-bac-d-et-ti-2019', 11, 'CORR', 2019, 'bac-d-physique-2019-cameroun.pdf', 'OFFICIEL', '', '', '3h', '2', 'VALIDE', NULL, false, '', '2026-08-07T17:11:18.805143+00:00'::timestamptz, '2026-08-07T17:11:18.805149+00:00'::timestamptz) RETURNING "catalog_lesson"."id"; args=('Physique-Chimie BAC D et TI 2019', 'physique-chimie-bac-d-et-ti-2019', 11, LessonType.CORR, 2019, 'bac-d-physique-2019-cameroun.pdf', Origine.OFFICIEL, '', '', '3h', '2', StatutContenu.VALIDE, None, False, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 805143, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 805149, tzinfo=datetime.timezone.utc)); alias=default
