(0.001) INSERT INTO "catalog_exercise_mots_cles_recherche" ("exercise_id", "tag_id") SELECT * FROM UNNEST((ARRAY[7518,7518,7518,7518,7518,7518])::bigint[], (ARRAY[5512,6249,5354,6251,6250,6252])::bigint[]) ON CONFLICT DO NOTHING; args=([7518, 7518, 7518, 7518, 7518, 7518], [5512, 6249, 5354, 6251, 6250, 6252]); alias=default
(0.001) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7518, 'A.1.1', 1, 'A. Réactions nucléaires (4 points). La réaction ⁶₃Li + ... → ²₁H + ⁴₂He (fission du lithium 6 par un neutron) fait intervenir les masses suivantes : m(Li)=6,01512u ; m(H)=2,01410u ; m(He)=4,00260u ; 1u=931,5MeV/c². Déterminer la variation d''énergie de la réaction.', '### Rappel de méthode
La variation d''énergie d''une réaction nucléaire se calcule à partir du défaut de masse Δm=mfinale-minitiale, converti en énergie via ΔE=Δm·c², soit ΔE=Δm(u)×931,5 MeV lorsque Δm est exprimé en u.

### Corrigé
**Défaut de masse :**
$$\Delta m = m(H) + m(He) - m(Li) = 2{,}01410 + 4{,}00260 - 6{,}01512$$
$$\Delta m = 6{,}01670 - 6{,}01512 = -0{,}00158\ u$$

**Variation d''énergie :**
$$\Delta E = \Delta m \times 931{,}5 = -0{,}00158\times931{,}5 \approx -1{,}47\ \text{MeV}$$

### Piège à éviter
Bien respecter le sens de la soustraction (masse des produits moins masse des réactifs) : un signe négatif de ΔE signifie que la réaction absorbe de l''énergie, un signe positif qu''elle en libère.

### Conseil
Toujours vérifier la cohérence du signe obtenu avec la conclusion physique attendue à la question suivante (réaction spontanée ou non), avant de conclure trop vite.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.633338+00:00'::timestamptz, '2026-08-07T17:11:16.633349+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7518, 'A.1.1', 1, "A. Réactions nucléaires (4 points). La réaction ⁶₃Li + ... → ²₁H + ⁴₂He (fission du lithium 6 par un neutron) fait intervenir les masses suivantes : m(Li)=6,01512u ; m(H)=2,01410u ; m(He)=4,00260u ; 1u=931,5MeV/c². Déterminer la variation d'énergie de la réaction.", "### Rappel de méthode\nLa variation d'énergie d'une réaction nucléaire se calcule à partir du défaut de masse Δm=mfinale-minitiale, converti en énergie via ΔE=Δm·c², soit ΔE=Δm(u)×931,5 MeV lorsque Δm est exprimé en u.\n\n### Corrigé\n**Défaut de masse :**\n$$\\Delta m = m(H) + m(He) - m(Li) = 2{,}01410 + 4{,}00260 - 6{,}01512$$\n$$\\Delta m = 6{,}01670 - 6{,}01512 = -0{,}00158\\ u$$\n\n**Variation d'énergie :**\n$$\\Delta E = \\Delta m \\times 931{,}5 = -0{,}00158\\times931{,}5 \\approx -1{,}47\\ \\text{MeV}$$\n\n### Piège à éviter\nBien respecter le sens de la soustraction (masse des produits moins masse des réactifs) : un signe négatif de ΔE signifie que la réaction absorbe de l'énergie, un signe positif qu'elle en libère.\n\n### Conseil\nToujours vérifier la cohérence du signe obtenu avec la conclusion physique attendue à la question suivante (réaction spontanée ou non), avant de conclure trop vite.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e15f10>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 633338, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 633349, tzinfo=datetime.timezone.utc)); alias=default
