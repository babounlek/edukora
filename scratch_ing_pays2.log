(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7525, 'cours-representer-le-champ-electrostatique-ei-au-milieu-i', '', 'Le champ électrostatique créé en un point par une charge ponctuelle positive est dirigé radialement, en s''éloignant de la charge ; le champ résultant en un point est la somme vectorielle des champs créés par chaque charge.', NULL, '2026-08-07T17:11:19.278273+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7525, 'cours-representer-le-champ-electrostatique-ei-au-milieu-i', '', "Le champ électrostatique créé en un point par une charge ponctuelle positive est dirigé radialement, en s'éloignant de la charge ; le champ résultant en un point est la somme vectorielle des champs créés par chaque charge.", None, datetime.datetime(2026, 8, 7, 17, 11, 19, 278273, tzinfo=datetime.timezone.utc)); alias=default
