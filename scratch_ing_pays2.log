(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7523, 'A.1', 1, 'Indiquer sur un schéma la zone de l''écran où sont observées les franges d''interférences.', '### Rappel de méthode
La zone d''interférences observable sur l''écran correspond à la région de recouvrement des deux faisceaux lumineux issus des sources secondaires S1 et S2, c''est-à-dire à l''intersection des deux cônes de lumière diffractée.

### Corrigé
Sur le schéma du dispositif (S, S1, S2, écran E), la zone où sont observées les franges d''interférences est la région centrale de l''écran, délimitée par le recouvrement des faisceaux lumineux issus de S1 et de S2 : c''est la zone commune aux deux faisceaux divergents, centrée sur l''axe de symétrie du dispositif (la médiatrice de S1S2 prolongée jusqu''à l''écran).

### Piège à éviter
Ne pas représenter la zone d''interférences sur la totalité de l''écran : en dehors de la zone de recouvrement des deux faisceaux, un seul faisceau (ou aucun) éclaire l''écran, et aucune figure d''interférence n''y est observable.

### Conseil
Toujours représenter les deux faisceaux divergents issus de S1 et S2 comme des cônes (ou triangles en coupe), la zone d''interférences étant précisément leur intersection commune sur l''écran.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.446637+00:00'::timestamptz, '2026-08-07T17:11:18.446644+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7523, 'A.1', 1, "Indiquer sur un schéma la zone de l'écran où sont observées les franges d'interférences.", "### Rappel de méthode\nLa zone d'interférences observable sur l'écran correspond à la région de recouvrement des deux faisceaux lumineux issus des sources secondaires S1 et S2, c'est-à-dire à l'intersection des deux cônes de lumière diffractée.\n\n### Corrigé\nSur le schéma du dispositif (S, S1, S2, écran E), la zone où sont observées les franges d'interférences est la région centrale de l'écran, délimitée par le recouvrement des faisceaux lumineux issus de S1 et de S2 : c'est la zone commune aux deux faisceaux divergents, centrée sur l'axe de symétrie du dispositif (la médiatrice de S1S2 prolongée jusqu'à l'écran).\n\n### Piège à éviter\nNe pas représenter la zone d'interférences sur la totalité de l'écran : en dehors de la zone de recouvrement des deux faisceaux, un seul faisceau (ou aucun) éclaire l'écran, et aucune figure d'interférence n'y est observable.\n\n### Conseil\nToujours représenter les deux faisceaux divergents issus de S1 et S2 comme des cônes (ou triangles en coupe), la zone d'interférences étant précisément leur intersection commune sur l'écran.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e332f0>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 446637, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 446644, tzinfo=datetime.timezone.utc)); alias=default
