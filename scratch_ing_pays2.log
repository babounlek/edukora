(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7522, '2.2', 3, 'En déduire l''expression de l''élongation du pendule en fonction du temps.', '### Rappel de méthode
L''élongation d''un pendule simple en oscillation harmonique s''écrit sous la forme générale θ(t)=θm sin(ωt+φ), avec ω=2π/T ; la phase à l''origine φ se détermine à partir de la valeur de θ(0) et du sens de variation initial.

### Corrigé
**Pulsation :**
$$\omega = \dfrac{2\pi}{T} = \dfrac{2\pi}{2} = \pi\ \text{rad/s}$$

Puisque θ(0)=0 et que la courbe croît juste après t=0 (vers son premier maximum), la phase à l''origine est φ=0. L''expression de l''élongation est donc :
$$\theta(t) = \theta_m\sin(\omega t) = 0{,}25\sin(\pi t)\ \text{rad}$$

### Piège à éviter
Ne pas se contenter d''écrire θ(t)=θm sin(ωt) sans avoir vérifié, à partir du graphe, que la phase à l''origine est effectivement nulle (ce qui n''est vrai que parce que θ(0)=0 et que la courbe est croissante en t=0⁺).

### Conseil
Toujours vérifier la cohérence de l''expression obtenue en recalculant θ(0), θ(1) et l''amplitude à partir de la formule, et en comparant ces valeurs à la lecture directe du graphe.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.329929+00:00'::timestamptz, '2026-08-07T17:11:18.329943+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7522, '2.2', 3, "En déduire l'expression de l'élongation du pendule en fonction du temps.", "### Rappel de méthode\nL'élongation d'un pendule simple en oscillation harmonique s'écrit sous la forme générale θ(t)=θm sin(ωt+φ), avec ω=2π/T ; la phase à l'origine φ se détermine à partir de la valeur de θ(0) et du sens de variation initial.\n\n### Corrigé\n**Pulsation :**\n$$\\omega = \\dfrac{2\\pi}{T} = \\dfrac{2\\pi}{2} = \\pi\\ \\text{rad/s}$$\n\nPuisque θ(0)=0 et que la courbe croît juste après t=0 (vers son premier maximum), la phase à l'origine est φ=0. L'expression de l'élongation est donc :\n$$\\theta(t) = \\theta_m\\sin(\\omega t) = 0{,}25\\sin(\\pi t)\\ \\text{rad}$$\n\n### Piège à éviter\nNe pas se contenter d'écrire θ(t)=θm sin(ωt) sans avoir vérifié, à partir du graphe, que la phase à l'origine est effectivement nulle (ce qui n'est vrai que parce que θ(0)=0 et que la courbe est croissante en t=0⁺).\n\n### Conseil\nToujours vérifier la cohérence de l'expression obtenue en recalculant θ(0), θ(1) et l'amplitude à partir de la formule, et en comparant ces valeurs à la lecture directe du graphe.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e33350>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 329929, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 329943, tzinfo=datetime.timezone.utc)); alias=default
