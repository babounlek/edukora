(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7519, '2', 2, 'Aider les élèves à choisir, parmi les 4 GBF proposés dans le document 2, celui qui correspond au régime de résonance d''intensité observé sur le graphe 2, sachant que R=295Ω, r=5Ω et que le courant à la résonance est i=0,35sin(100πt) (A).', '### Rappel de méthode
À la résonance d''intensité d''un circuit RLC série, la tension du générateur et le courant sont en phase, et leur amplitude sont reliées par la loi d''Ohm généralisée Um=Im×(R+r) (l''impédance totale se réduisant à la résistance totale du circuit à la résonance).

### Corrigé
**Calcul de l''amplitude de tension attendue à la résonance :**
$$U_m = I_m\times(R+r) = 0{,}35\times(295+5) = 0{,}35\times300 = 105\ \text{V}$$

**Comparaison avec le courant donné :** i=0,35sin(100πt) a pour pulsation ω=100π rad/s et pour phase à l''origine 0 (pas de déphasage).

À la résonance, le GBF doit donc délivrer une tension de même pulsation (100π rad/s), de même phase (en phase avec i, donc phase nulle également puisque i n''a pas de phase), et d''amplitude Um=105V.

**Examen des 4 propositions :**
- A : u=105sin(100πt) → amplitude 105V ✓, pulsation 100π rad/s ✓, phase nulle (en phase avec i) ✓ → **convient**
- B : pulsation 200π rad/s ✗ (ne correspond pas à la résonance observée)
- C : déphasage +π/2 ✗ (ne serait pas en phase avec i, incompatible avec la résonance)
- D : amplitude 100V ✗ (ne correspond pas à Um=105V calculé)

**Conclusion :** le générateur à choisir est le **GBF A** (u=105sin(100πt)), seul compatible simultanément avec l''amplitude, la pulsation et la phase attendues à la résonance.

### Piège à éviter
Ne pas se contenter de vérifier un seul critère (par exemple l''amplitude) : il faut impérativement vérifier la cohérence simultanée des trois grandeurs (amplitude, pulsation, phase) pour valider le choix du GBF.

### Conseil
À la résonance d''intensité, retenir le triptyque de vérification : même pulsation que i, tension et courant en phase, et Um=Im×(R+r) - ces trois conditions permettent d''éliminer efficacement les propositions incorrectes.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:17.039439+00:00'::timestamptz, '2026-08-07T17:11:17.039444+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7519, '2', 2, "Aider les élèves à choisir, parmi les 4 GBF proposés dans le document 2, celui qui correspond au régime de résonance d'intensité observé sur le graphe 2, sachant que R=295Ω, r=5Ω et que le courant à la résonance est i=0,35sin(100πt) (A).", "### Rappel de méthode\nÀ la résonance d'intensité d'un circuit RLC série, la tension du générateur et le courant sont en phase, et leur amplitude sont reliées par la loi d'Ohm généralisée Um=Im×(R+r) (l'impédance totale se réduisant à la résistance totale du circuit à la résonance).\n\n### Corrigé\n**Calcul de l'amplitude de tension attendue à la résonance :**\n$$U_m = I_m\\times(R+r) = 0{,}35\\times(295+5) = 0{,}35\\times300 = 105\\ \\text{V}$$\n\n**Comparaison avec le courant donné :** i=0,35sin(100πt) a pour pulsation ω=100π rad/s et pour phase à l'origine 0 (pas de déphasage).\n\nÀ la résonance, le GBF doit donc délivrer une tension de même pulsation (100π rad/s), de même phase (en phase avec i, donc phase nulle également puisque i n'a pas de phase), et d'amplitude Um=105V.\n\n**Examen des 4 propositions :**\n- A : u=105sin(100πt) → amplitude 105V ✓, pulsation 100π rad/s ✓, phase nulle (en phase avec i) ✓ → **convient**\n- B : pulsation 200π rad/s ✗ (ne correspond pas à la résonance observée)\n- C : déphasage +π/2 ✗ (ne serait pas en phase avec i, incompatible avec la résonance)\n- D : amplitude 100V ✗ (ne correspond pas à Um=105V calculé)\n\n**Conclusion :** le générateur à choisir est le **GBF A** (u=105sin(100πt)), seul compatible simultanément avec l'amplitude, la pulsation et la phase attendues à la résonance.\n\n### Piège à éviter\nNe pas se contenter de vérifier un seul critère (par exemple l'amplitude) : il faut impérativement vérifier la cohérence simultanée des trois grandeurs (amplitude, pulsation, phase) pour valider le choix du GBF.\n\n### Conseil\nÀ la résonance d'intensité, retenir le triptyque de vérification : même pulsation que i, tension et courant en phase, et Um=Im×(R+r) - ces trois conditions permettent d'éliminer efficacement les propositions incorrectes.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e178f0>, '', datetime.datetime(2026, 8, 7, 17, 11, 17, 39439, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 39444, tzinfo=datetime.timezone.utc)); alias=default
