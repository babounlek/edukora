(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7518, 'A.1.2', 2, 'Cette réaction est-elle spontanée ?', '### Rappel de méthode
Une réaction nucléaire est spontanée si elle libère de l''énergie (ΔE<0 dans la convention Δm=mfinale-minitiale négatif signifiant énergie libérée) ; ici la convention utilisée donne ΔE négatif correspondant à une énergie à fournir, donc réaction non spontanée.

### Corrigé
La variation d''énergie calculée est négative (ΔE≈-1,47MeV), ce qui signifie que cette transformation **nécessite un apport d''énergie externe** (ici, apporté par le neutron incident) pour se produire. Cette réaction n''est donc **pas spontanée** : elle ne peut avoir lieu que si un neutron suffisamment énergétique vient percuter le noyau de lithium 6.

### Piège à éviter
Ne pas conclure hâtivement "réaction spontanée" simplement parce qu''il s''agit d''une réaction nucléaire : la spontanéité dépend strictement du signe de ΔE (ou, de manière équivalente, du signe de Δm).

### Conseil
Retenir la règle générale : une réaction nucléaire est spontanée si et seulement si la masse totale diminue (Δm<0 au sens minitiale-mfinale), ce qui correspond à une libération d''énergie.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.681968+00:00'::timestamptz, '2026-08-07T17:11:16.681974+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7518, 'A.1.2', 2, 'Cette réaction est-elle spontanée ?', '### Rappel de méthode\nUne réaction nucléaire est spontanée si elle libère de l\'énergie (ΔE<0 dans la convention Δm=mfinale-minitiale négatif signifiant énergie libérée) ; ici la convention utilisée donne ΔE négatif correspondant à une énergie à fournir, donc réaction non spontanée.\n\n### Corrigé\nLa variation d\'énergie calculée est négative (ΔE≈-1,47MeV), ce qui signifie que cette transformation **nécessite un apport d\'énergie externe** (ici, apporté par le neutron incident) pour se produire. Cette réaction n\'est donc **pas spontanée** : elle ne peut avoir lieu que si un neutron suffisamment énergétique vient percuter le noyau de lithium 6.\n\n### Piège à éviter\nNe pas conclure hâtivement "réaction spontanée" simplement parce qu\'il s\'agit d\'une réaction nucléaire : la spontanéité dépend strictement du signe de ΔE (ou, de manière équivalente, du signe de Δm).\n\n### Conseil\nRetenir la règle générale : une réaction nucléaire est spontanée si et seulement si la masse totale diminue (Δm<0 au sens minitiale-mfinale), ce qui correspond à une libération d\'énergie.', '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e166c0>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 681968, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 681974, tzinfo=datetime.timezone.utc)); alias=default
