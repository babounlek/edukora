(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'A.1.1', 1, 'Représenter la force électromagnétique qui s''applique sur la tige, en faisant ressortir le sens du champ magnétique (on admettra que cette force $\vec{F}$ est localisée au point C, milieu de AM).', '### Rappel de méthode
La force électromagnétique (force de Laplace) subie par un conducteur rectiligne parcouru par un courant I dans un champ magnétique uniforme $\vec{B}$ est $\vec{F}=I\vec{AM}\times\vec{B}$ ; son sens s''obtient par la règle de la main droite (ou des trois doigts).

### Corrigé
La force électromagnétique $\vec{F}$ est perpendiculaire à la fois au sens du courant (le long de la tige AM) et au champ magnétique $\vec{B}$. Elle est localisée conventionnellement au point C, milieu de AM, et son sens (déterminé par la règle de la main droite, doigts orientés dans le sens du courant, se refermant vers $\vec{B}$, le pouce indiquant $\vec{F}$) est horizontal, orienté de façon à écarter la tige de sa position d''équilibre initiale vers la droite : c''est justement ce sens qui explique le déplacement observé de la tige.

### Piège à éviter
Ne pas oublier que le sens de $\vec{F}$ doit être cohérent avec le sens de rotation observé (la tige s''écarte vers la droite) : le schéma doit représenter $\vec{B}$, le courant, et $\vec{F}$ de façon mutuellement cohérente avec la règle de la main droite.

### Conseil
Toujours représenter les trois vecteurs (courant, champ, force) sur un schéma en trois dimensions ou en perspective, en utilisant la règle de la main droite comme outil de vérification systématique.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:17.816539+00:00'::timestamptz, '2026-08-07T17:11:17.816545+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'A.1.1', 1, "Représenter la force électromagnétique qui s'applique sur la tige, en faisant ressortir le sens du champ magnétique (on admettra que cette force $\\vec{F}$ est localisée au point C, milieu de AM).", "### Rappel de méthode\nLa force électromagnétique (force de Laplace) subie par un conducteur rectiligne parcouru par un courant I dans un champ magnétique uniforme $\\vec{B}$ est $\\vec{F}=I\\vec{AM}\\times\\vec{B}$ ; son sens s'obtient par la règle de la main droite (ou des trois doigts).\n\n### Corrigé\nLa force électromagnétique $\\vec{F}$ est perpendiculaire à la fois au sens du courant (le long de la tige AM) et au champ magnétique $\\vec{B}$. Elle est localisée conventionnellement au point C, milieu de AM, et son sens (déterminé par la règle de la main droite, doigts orientés dans le sens du courant, se refermant vers $\\vec{B}$, le pouce indiquant $\\vec{F}$) est horizontal, orienté de façon à écarter la tige de sa position d'équilibre initiale vers la droite : c'est justement ce sens qui explique le déplacement observé de la tige.\n\n### Piège à éviter\nNe pas oublier que le sens de $\\vec{F}$ doit être cohérent avec le sens de rotation observé (la tige s'écarte vers la droite) : le schéma doit représenter $\\vec{B}$, le courant, et $\\vec{F}$ de façon mutuellement cohérente avec la règle de la main droite.\n\n### Conseil\nToujours représenter les trois vecteurs (courant, champ, force) sur un schéma en trois dimensions ou en perspective, en utilisant la règle de la main droite comme outil de vérification systématique.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e31af0>, '', datetime.datetime(2026, 8, 7, 17, 11, 17, 816539, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 816545, tzinfo=datetime.timezone.utc)); alias=default
