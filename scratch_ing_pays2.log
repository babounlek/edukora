(0.000) SELECT "catalog_tag"."id" AS "id" FROM "catalog_tag" INNER JOIN "catalog_exercise_mots_cles_recherche" ON ("catalog_tag"."id" = "catalog_exercise_mots_cles_recherche"."tag_id") WHERE "catalog_exercise_mots_cles_recherche"."exercise_id" = 7524 ORDER BY "catalog_tag"."name" ASC; args=(7524,); alias=default
(0.001) INSERT INTO "catalog_exercise_mots_cles_recherche" ("exercise_id", "tag_id") SELECT * FROM UNNEST((ARRAY[7524,7524,7524,7524,7524])::bigint[], (ARRAY[5509,5510,5497,3260,3838])::bigint[]) ON CONFLICT DO NOTHING; args=([7524, 7524, 7524, 7524, 7524], [5509, 5510, 5497, 3260, 3838]); alias=default
(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7524, '1', 1, 'Définir : potentiel d''arrêt.', '### Rappel de méthode
Le potentiel d''arrêt est la tension de freinage minimale à appliquer entre les électrodes d''une cellule photoémissive pour annuler le courant photoélectrique, c''est-à-dire pour arrêter même les photoélectrons les plus rapides.

### Corrigé
Le **potentiel d''arrêt** U0 est la valeur minimale, en valeur absolue, de la tension inverse (de freinage) qu''il faut appliquer entre l''anode et la cathode d''une cellule photoémissive pour annuler totalement le courant photoélectrique, c''est-à-dire pour arrêter même les photoélectrons émis avec l''énergie cinétique maximale Ec,max. Il vérifie la relation $eU_0 = E_{c,max}$.

### Piège à éviter
Ne pas confondre le potentiel d''arrêt (qui annule le courant) avec une tension accélératrice quelconque : le potentiel d''arrêt est spécifiquement la valeur seuil qui stoppe même les électrons les plus énergétiques.

### Conseil
Toujours associer la définition du potentiel d''arrêt à la relation eU0=Ec,max, qui permet de l''exploiter quantitativement dans les calculs.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.814880+00:00'::timestamptz, '2026-08-07T17:11:18.814887+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7524, '1', 1, "Définir : potentiel d'arrêt.", "### Rappel de méthode\nLe potentiel d'arrêt est la tension de freinage minimale à appliquer entre les électrodes d'une cellule photoémissive pour annuler le courant photoélectrique, c'est-à-dire pour arrêter même les photoélectrons les plus rapides.\n\n### Corrigé\nLe **potentiel d'arrêt** U0 est la valeur minimale, en valeur absolue, de la tension inverse (de freinage) qu'il faut appliquer entre l'anode et la cathode d'une cellule photoémissive pour annuler totalement le courant photoélectrique, c'est-à-dire pour arrêter même les photoélectrons émis avec l'énergie cinétique maximale Ec,max. Il vérifie la relation $eU_0 = E_{c,max}$.\n\n### Piège à éviter\nNe pas confondre le potentiel d'arrêt (qui annule le courant) avec une tension accélératrice quelconque : le potentiel d'arrêt est spécifiquement la valeur seuil qui stoppe même les électrons les plus énergétiques.\n\n### Conseil\nToujours associer la définition du potentiel d'arrêt à la relation eU0=Ec,max, qui permet de l'exploiter quantitativement dans les calculs.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5d2e0>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 814880, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 814887, tzinfo=datetime.timezone.utc)); alias=default
