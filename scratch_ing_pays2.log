(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'A.1.2', 2, 'Représenter les autres forces qui s''appliquent sur AM.', '### Rappel de méthode
Outre la force électromagnétique, une tige pivotant autour d''un axe est soumise à son poids (appliqué en son centre de gravité) et à la réaction de l''axe au point de pivot.

### Corrigé
Les autres forces appliquées à la tige AM sont :
- Le **poids** $\vec{P}=m\vec{g}$, vertical vers le bas, appliqué au centre de gravité de la tige (point C, milieu de AM, la tige étant homogène) ;
- La **réaction de l''axe** $\vec{R}$ au point de pivot A, dont la direction n''est pas nécessairement connue a priori (elle assure l''équilibre des forces mais ne produit aucun moment par rapport à A puisqu''elle y est appliquée).

### Piège à éviter
Ne pas oublier la réaction de l''axe, même si elle n''intervient pas dans l''équation des moments par rapport à A (son moment par rapport à A est nul puisqu''elle y est appliquée).

### Conseil
Pour tout solide en rotation autour d''un axe fixe, systématiquement lister : le poids, la réaction de l''axe, et toute force motrice (ici la force électromagnétique), avant d''écrire l''équation des moments.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:17.864572+00:00'::timestamptz, '2026-08-07T17:11:17.864579+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'A.1.2', 2, "Représenter les autres forces qui s'appliquent sur AM.", "### Rappel de méthode\nOutre la force électromagnétique, une tige pivotant autour d'un axe est soumise à son poids (appliqué en son centre de gravité) et à la réaction de l'axe au point de pivot.\n\n### Corrigé\nLes autres forces appliquées à la tige AM sont :\n- Le **poids** $\\vec{P}=m\\vec{g}$, vertical vers le bas, appliqué au centre de gravité de la tige (point C, milieu de AM, la tige étant homogène) ;\n- La **réaction de l'axe** $\\vec{R}$ au point de pivot A, dont la direction n'est pas nécessairement connue a priori (elle assure l'équilibre des forces mais ne produit aucun moment par rapport à A puisqu'elle y est appliquée).\n\n### Piège à éviter\nNe pas oublier la réaction de l'axe, même si elle n'intervient pas dans l'équation des moments par rapport à A (son moment par rapport à A est nul puisqu'elle y est appliquée).\n\n### Conseil\nPour tout solide en rotation autour d'un axe fixe, systématiquement lister : le poids, la réaction de l'axe, et toute force motrice (ici la force électromagnétique), avant d'écrire l'équation des moments.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e31f40>, '', datetime.datetime(2026, 8, 7, 17, 11, 17, 864572, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 864579, tzinfo=datetime.timezone.utc)); alias=default
