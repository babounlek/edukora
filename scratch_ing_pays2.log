(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7523, 'A.2.1', 2, 'La distance séparant la 3ème frange brillante située avant la frange centrale et la 3ème frange brillante après la frange centrale est de 4,2mm. Calculer l''interfrange.', '### Rappel de méthode
La distance entre la frange brillante d''ordre -k et la frange brillante d''ordre +k, de part et d''autre de la frange centrale, correspond à 2k interfranges.

### Corrigé
La distance donnée sépare la frange d''ordre k=-3 et la frange d''ordre k=+3, soit un total de 2×3=6 interfranges :
$$6i = 4{,}2\ \text{mm}$$
$$i = \dfrac{4{,}2}{6} = 0{,}7\ \text{mm}$$

### Piège à éviter
Ne pas diviser par 3 (nombre d''interfranges d''un seul côté) au lieu de 6 (nombre total d''interfranges entre les deux franges symétriques).

### Conseil
Toujours dessiner mentalement (ou sur le schéma) la position des franges d''ordre -3, -2, -1, 0, +1, +2, +3 pour bien compter le nombre d''interfranges séparant deux franges données.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.496471+00:00'::timestamptz, '2026-08-07T17:11:18.496477+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7523, 'A.2.1', 2, "La distance séparant la 3ème frange brillante située avant la frange centrale et la 3ème frange brillante après la frange centrale est de 4,2mm. Calculer l'interfrange.", "### Rappel de méthode\nLa distance entre la frange brillante d'ordre -k et la frange brillante d'ordre +k, de part et d'autre de la frange centrale, correspond à 2k interfranges.\n\n### Corrigé\nLa distance donnée sépare la frange d'ordre k=-3 et la frange d'ordre k=+3, soit un total de 2×3=6 interfranges :\n$$6i = 4{,}2\\ \\text{mm}$$\n$$i = \\dfrac{4{,}2}{6} = 0{,}7\\ \\text{mm}$$\n\n### Piège à éviter\nNe pas diviser par 3 (nombre d'interfranges d'un seul côté) au lieu de 6 (nombre total d'interfranges entre les deux franges symétriques).\n\n### Conseil\nToujours dessiner mentalement (ou sur le schéma) la position des franges d'ordre -3, -2, -1, 0, +1, +2, +3 pour bien compter le nombre d'interfranges séparant deux franges données.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5ca10>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 496471, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 496477, tzinfo=datetime.timezone.utc)); alias=default
