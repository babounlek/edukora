(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7523, 'cours-donner-une-application-de-la-radioactivite', '', 'La radioactivité, malgré sa dangerosité potentielle, offre de nombreuses applications bénéfiques, notamment en médecine et en datation.', NULL, '2026-08-07T17:11:18.684558+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7523, 'cours-donner-une-application-de-la-radioactivite', '', 'La radioactivité, malgré sa dangerosité potentielle, offre de nombreuses applications bénéfiques, notamment en médecine et en datation.', None, datetime.datetime(2026, 8, 7, 17, 11, 18, 684558, tzinfo=datetime.timezone.utc)); alias=default
