(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7518, 'cours-preciser-le-signe-de-ux-et-le-signe-de-uz', '', 'Pour accélérer un électron (charge négative) de A vers B, la force électrique doit être dirigée de A vers B, ce qui impose le sens du champ (donc le signe de la tension) opposé à cette force pour une charge négative ; un raisonnement analogue s''applique pour la déviation vers la plaque C.', NULL, '2026-08-07T17:11:16.870349+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7518, 'cours-preciser-le-signe-de-ux-et-le-signe-de-uz', '', "Pour accélérer un électron (charge négative) de A vers B, la force électrique doit être dirigée de A vers B, ce qui impose le sens du champ (donc le signe de la tension) opposé à cette force pour une charge négative ; un raisonnement analogue s'applique pour la déviation vers la plaque C.", None, datetime.datetime(2026, 8, 7, 17, 11, 16, 870349, tzinfo=datetime.timezone.utc)); alias=default
