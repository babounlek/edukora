(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7518, 'A.2.2', 4, 'Quelle est la nature de cette réaction ?', '### Rappel de méthode
Une réaction où des noyaux légers s''assemblent pour former un noyau plus lourd, avec libération d''énergie, est appelée fusion thermonucléaire.

### Corrigé
Cette réaction consiste en l''assemblage de quatre noyaux légers (hydrogène) pour former un noyau plus lourd (hélium 4) : il s''agit d''une **réaction de fusion thermonucléaire** (également appelée fusion nucléaire), du type de celles qui se produisent naturellement au cœur des étoiles comme le Soleil.

### Piège à éviter
Ne pas confondre avec une réaction de fission (cassure d''un noyau lourd en noyaux plus légers), qui est le phénomène physique inverse.

### Conseil
Associer systématiquement fusion à "noyaux légers → noyau plus lourd" et fission à "noyau lourd → noyaux plus légers", pour ne jamais confondre les deux types de réactions nucléaires.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.775090+00:00'::timestamptz, '2026-08-07T17:11:16.775097+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7518, 'A.2.2', 4, 'Quelle est la nature de cette réaction ?', '### Rappel de méthode\nUne réaction où des noyaux légers s\'assemblent pour former un noyau plus lourd, avec libération d\'énergie, est appelée fusion thermonucléaire.\n\n### Corrigé\nCette réaction consiste en l\'assemblage de quatre noyaux légers (hydrogène) pour former un noyau plus lourd (hélium 4) : il s\'agit d\'une **réaction de fusion thermonucléaire** (également appelée fusion nucléaire), du type de celles qui se produisent naturellement au cœur des étoiles comme le Soleil.\n\n### Piège à éviter\nNe pas confondre avec une réaction de fission (cassure d\'un noyau lourd en noyaux plus légers), qui est le phénomène physique inverse.\n\n### Conseil\nAssocier systématiquement fusion à "noyaux légers → noyau plus lourd" et fission à "noyau lourd → noyaux plus légers", pour ne jamais confondre les deux types de réactions nucléaires.', '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e16f90>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 775090, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 775097, tzinfo=datetime.timezone.utc)); alias=default
