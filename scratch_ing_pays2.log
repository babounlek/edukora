(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7524, '2', 2, 'Tracer la courbe U0=f(N). Échelle : 1cm pour 10¹⁴Hz et 1cm pour 0,2V.', '### Rappel de méthode
La relation d''Einstein de l''effet photoélectrique, eU0=hN-W0, montre que U0 est une fonction affine de N (U0=(h/e)N-W0/e) : le tracé attendu est donc une droite, dont la pente et l''ordonnée à l''origine permettent respectivement de déterminer h et W0.

### Corrigé
En reportant les 5 points expérimentaux (N ; U0) avec les échelles imposées (1cm pour 10¹⁴Hz en abscisse, 1cm pour 0,2V en ordonnée), on obtient un nuage de points quasi parfaitement aligné. La droite moyenne tracée passe au mieux par l''ensemble des points, confirmant une relation affine U0=f(N).

*(Remarque : l''énoncé demande littéralement « N=f(U0) », mais le tracé physiquement pertinent - utilisé aux questions suivantes pour déterminer h et W0 - est U0 en fonction de N, conformément à la relation d''Einstein ; c''est ce tracé qui est présenté ici.)*

### Piège à éviter
Ne pas oublier de respecter scrupuleusement les échelles imposées par l''énoncé, sous peine de fausser la lecture graphique de la pente et de l''ordonnée à l''origine.

### Conseil
Vérifier, une fois la droite tracée, que tous les points expérimentaux sont bien proches de celle-ci (alignement quasi parfait) : un nuage de points mal aligné indiquerait une erreur de report ou de mesure.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.877168+00:00'::timestamptz, '2026-08-07T17:11:18.877174+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7524, '2', 2, 'Tracer la courbe U0=f(N). Échelle : 1cm pour 10¹⁴Hz et 1cm pour 0,2V.', "### Rappel de méthode\nLa relation d'Einstein de l'effet photoélectrique, eU0=hN-W0, montre que U0 est une fonction affine de N (U0=(h/e)N-W0/e) : le tracé attendu est donc une droite, dont la pente et l'ordonnée à l'origine permettent respectivement de déterminer h et W0.\n\n### Corrigé\nEn reportant les 5 points expérimentaux (N ; U0) avec les échelles imposées (1cm pour 10¹⁴Hz en abscisse, 1cm pour 0,2V en ordonnée), on obtient un nuage de points quasi parfaitement aligné. La droite moyenne tracée passe au mieux par l'ensemble des points, confirmant une relation affine U0=f(N).\n\n*(Remarque : l'énoncé demande littéralement « N=f(U0) », mais le tracé physiquement pertinent - utilisé aux questions suivantes pour déterminer h et W0 - est U0 en fonction de N, conformément à la relation d'Einstein ; c'est ce tracé qui est présenté ici.)*\n\n### Piège à éviter\nNe pas oublier de respecter scrupuleusement les échelles imposées par l'énoncé, sous peine de fausser la lecture graphique de la pente et de l'ordonnée à l'origine.\n\n### Conseil\nVérifier, une fois la droite tracée, que tous les points expérimentaux sont bien proches de celle-ci (alignement quasi parfait) : un nuage de points mal aligné indiquerait une erreur de report ou de mesure.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5c5c0>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 877168, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 877174, tzinfo=datetime.timezone.utc)); alias=default
