(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'A.3', 4, 'En déduire l''expression de l''angle α en fonction de m, g, I, L, B, puis calculer sa valeur. Données : m=40g ; I=8A ; B=0,025T ; L=10cm ; g=9,8m/s².', '### Rappel de méthode
En exprimant chaque moment comme le produit de la force par son bras de levier (distance L/2 depuis l''axe, projetée perpendiculairement à la direction de la force), le théorème des moments conduit à une relation entre tanα et les données du problème.

### Corrigé
La tige, de longueur L et de masse m, a son centre de gravité C au milieu, à la distance L/2 de l''axe A. Le poids P=mg est vertical ; son moment par rapport à A vaut $mg\times\dfrac{L}{2}\sin\alpha$ (bras de levier horizontal). La force électromagnétique F=BIL est horizontale (perpendiculaire à la tige et au champ) ; son moment par rapport à A vaut $BIL\times\dfrac{L}{2}\cos\alpha$ (bras de levier vertical). À l''équilibre :
$$mg\times\dfrac{L}{2}\sin\alpha = BIL\times\dfrac{L}{2}\cos\alpha$$
$$mg\sin\alpha = BIL\cos\alpha$$
$$\tan\alpha = \dfrac{BIL}{mg}$$
$$\alpha = \arctan\left(\dfrac{BIL}{mg}\right)$$

**Application numérique :**
$$\tan\alpha = \dfrac{0{,}025\times8\times0{,}10}{0{,}040\times9{,}8} = \dfrac{0{,}02}{0{,}392} \approx 0{,}051$$
$$\alpha \approx 2{,}9°$$

### Piège à éviter
Ne pas oublier de convertir toutes les données en unités SI (m=40g=0,040kg ; L=10cm=0,10m) avant d''effectuer le calcul numérique.

### Conseil
Remarquer que le facteur L/2 (bras de levier commun aux deux moments) se simplifie entièrement dans l''équation finale : le résultat tanα=BIL/(mg) ne dépend donc pas explicitement de la longueur du bras de levier, ce qui est un bon indicateur de cohérence du calcul.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:17.959902+00:00'::timestamptz, '2026-08-07T17:11:17.959908+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'A.3', 4, "En déduire l'expression de l'angle α en fonction de m, g, I, L, B, puis calculer sa valeur. Données : m=40g ; I=8A ; B=0,025T ; L=10cm ; g=9,8m/s².", "### Rappel de méthode\nEn exprimant chaque moment comme le produit de la force par son bras de levier (distance L/2 depuis l'axe, projetée perpendiculairement à la direction de la force), le théorème des moments conduit à une relation entre tanα et les données du problème.\n\n### Corrigé\nLa tige, de longueur L et de masse m, a son centre de gravité C au milieu, à la distance L/2 de l'axe A. Le poids P=mg est vertical ; son moment par rapport à A vaut $mg\\times\\dfrac{L}{2}\\sin\\alpha$ (bras de levier horizontal). La force électromagnétique F=BIL est horizontale (perpendiculaire à la tige et au champ) ; son moment par rapport à A vaut $BIL\\times\\dfrac{L}{2}\\cos\\alpha$ (bras de levier vertical). À l'équilibre :\n$$mg\\times\\dfrac{L}{2}\\sin\\alpha = BIL\\times\\dfrac{L}{2}\\cos\\alpha$$\n$$mg\\sin\\alpha = BIL\\cos\\alpha$$\n$$\\tan\\alpha = \\dfrac{BIL}{mg}$$\n$$\\alpha = \\arctan\\left(\\dfrac{BIL}{mg}\\right)$$\n\n**Application numérique :**\n$$\\tan\\alpha = \\dfrac{0{,}025\\times8\\times0{,}10}{0{,}040\\times9{,}8} = \\dfrac{0{,}02}{0{,}392} \\approx 0{,}051$$\n$$\\alpha \\approx 2{,}9°$$\n\n### Piège à éviter\nNe pas oublier de convertir toutes les données en unités SI (m=40g=0,040kg ; L=10cm=0,10m) avant d'effectuer le calcul numérique.\n\n### Conseil\nRemarquer que le facteur L/2 (bras de levier commun aux deux moments) se simplifie entièrement dans l'équation finale : le résultat tanα=BIL/(mg) ne dépend donc pas explicitement de la longueur du bras de levier, ce qui est un bon indicateur de cohérence du calcul.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e326c0>, '', datetime.datetime(2026, 8, 7, 17, 11, 17, 959902, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 959908, tzinfo=datetime.timezone.utc)); alias=default
