(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7518, 'cours-exprimer-la-vitesse-v0-de-lelectron-a-la-sortie', '', 'Le théorème de l''énergie cinétique entre O (vitesse nulle) et O'' (sortie des plaques d''accélération) relie la variation d''énergie cinétique au travail de la force électrique, lui-même égal à q·Ux.', NULL, '2026-08-07T17:11:16.918147+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7518, 'cours-exprimer-la-vitesse-v0-de-lelectron-a-la-sortie', '', "Le théorème de l'énergie cinétique entre O (vitesse nulle) et O' (sortie des plaques d'accélération) relie la variation d'énergie cinétique au travail de la force électrique, lui-même égal à q·Ux.", None, datetime.datetime(2026, 8, 7, 17, 11, 16, 918147, tzinfo=datetime.timezone.utc)); alias=default
