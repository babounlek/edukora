(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7518, 'A.2.1', 3, 'La transformation de l''hydrogène en hélium 4 (cycle proton-proton) produit une particule α et deux positons à partir de quatre noyaux d''hydrogène. Écrire l''équation-bilan de cette réaction.', '### Rappel de méthode
L''écriture d''une équation-bilan nucléaire impose la conservation du nombre de charge Z et du nombre de nucléons A de part et d''autre de la flèche.

### Corrigé
La transformation globale (cycle proton-proton) s''écrit :
$$4\,{}^1_1H \longrightarrow {}^4_2He + 2\,{}^0_{+1}e$$
**Vérification des lois de conservation :**
- Nombre de nucléons : 4×1 = 4 = 4+2×0 ✓
- Nombre de charge : 4×1 = 4 = 2+2×1 ✓

### Piège à éviter
Ne pas oublier les deux positons (⁰₊₁e) dans le bilan : sans eux, la conservation de la charge ne serait pas respectée (4 protons ont une charge totale +4, alors qu''un seul noyau d''hélium n''a que +2).

### Conseil
Toujours vérifier séparément la conservation de A (nombre de masse) et de Z (numéro atomique/charge) après avoir écrit toute équation de réaction nucléaire, quel que soit son type (fission, fusion, désintégration).', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.728328+00:00'::timestamptz, '2026-08-07T17:11:16.728334+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7518, 'A.2.1', 3, "La transformation de l'hydrogène en hélium 4 (cycle proton-proton) produit une particule α et deux positons à partir de quatre noyaux d'hydrogène. Écrire l'équation-bilan de cette réaction.", "### Rappel de méthode\nL'écriture d'une équation-bilan nucléaire impose la conservation du nombre de charge Z et du nombre de nucléons A de part et d'autre de la flèche.\n\n### Corrigé\nLa transformation globale (cycle proton-proton) s'écrit :\n$$4\\,{}^1_1H \\longrightarrow {}^4_2He + 2\\,{}^0_{+1}e$$\n**Vérification des lois de conservation :**\n- Nombre de nucléons : 4×1 = 4 = 4+2×0 ✓\n- Nombre de charge : 4×1 = 4 = 2+2×1 ✓\n\n### Piège à éviter\nNe pas oublier les deux positons (⁰₊₁e) dans le bilan : sans eux, la conservation de la charge ne serait pas respectée (4 protons ont une charge totale +4, alors qu'un seul noyau d'hélium n'a que +2).\n\n### Conseil\nToujours vérifier séparément la conservation de A (nombre de masse) et de Z (numéro atomique/charge) après avoir écrit toute équation de réaction nucléaire, quel que soit son type (fission, fusion, désintégration).", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e165a0>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 728328, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 728334, tzinfo=datetime.timezone.utc)); alias=default
