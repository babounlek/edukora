(0.001) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7518, 'B.1', 5, 'B. Accélération et déflexion d''un électron dans un champ électrique (4 points). Un électron, de charge q=-e et de masse m, est émis sans vitesse initiale en O, puis accéléré entre les plaques A et B soumises à une tension Ux, avant d''être dévié par un champ électrique créé par les plaques C et E soumises à une tension Uz. Préciser le signe de Ux et le signe de Uz.', '### Rappel de méthode
Pour accélérer un électron (charge négative) de A vers B, la force électrique doit être dirigée de A vers B, ce qui impose le sens du champ (donc le signe de la tension) opposé à cette force pour une charge négative ; un raisonnement analogue s''applique pour la déviation vers la plaque C.

### Corrigé
**Signe de Ux :** l''électron, de charge négative, doit être accéléré de la plaque A (où il entre avec une vitesse quasi nulle) vers la plaque B. La force électrique $\vec{F}=q\vec{E}=-e\vec{E}$ doit donc être dirigée de A vers B. Comme la charge est négative, le champ $\vec{E}$ (et donc la tension Ux=VA-VB) doit être orienté en sens opposé à la force, ce qui impose **Ux < 0** (VB>VA : la plaque de sortie B doit être au potentiel le plus élevé pour attirer l''électron négatif).

**Signe de Uz :** pour dévier l''électron vers la plaque C (potentiel plus élevé, d''après le schéma où C est la plaque supérieure vers laquelle le faisceau doit s''incurver), il faut que la force électrique soit dirigée vers C, soit, pour une charge négative, un champ dirigé de C vers E. Ceci correspond à **Uz > 0** (VC>VE, la plaque supérieure C étant portée au potentiel le plus élevé, attire l''électron chargé négativement).

### Piège à éviter
Ne pas oublier le signe négatif de la charge de l''électron dans le raisonnement : pour une charge négative, la force électrique est **opposée** au champ électrique, ce qui inverse l''intuition naturelle liant signe de tension et sens de déviation.

### Conseil
Toujours établir un schéma clair avec les vecteurs force, champ et vitesse avant de conclure sur le signe d''une tension accélératrice ou déflectrice, en particulier pour une particule chargée négativement.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:16.821264+00:00'::timestamptz, '2026-08-07T17:11:16.821270+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7518, 'B.1', 5, "B. Accélération et déflexion d'un électron dans un champ électrique (4 points). Un électron, de charge q=-e et de masse m, est émis sans vitesse initiale en O, puis accéléré entre les plaques A et B soumises à une tension Ux, avant d'être dévié par un champ électrique créé par les plaques C et E soumises à une tension Uz. Préciser le signe de Ux et le signe de Uz.", "### Rappel de méthode\nPour accélérer un électron (charge négative) de A vers B, la force électrique doit être dirigée de A vers B, ce qui impose le sens du champ (donc le signe de la tension) opposé à cette force pour une charge négative ; un raisonnement analogue s'applique pour la déviation vers la plaque C.\n\n### Corrigé\n**Signe de Ux :** l'électron, de charge négative, doit être accéléré de la plaque A (où il entre avec une vitesse quasi nulle) vers la plaque B. La force électrique $\\vec{F}=q\\vec{E}=-e\\vec{E}$ doit donc être dirigée de A vers B. Comme la charge est négative, le champ $\\vec{E}$ (et donc la tension Ux=VA-VB) doit être orienté en sens opposé à la force, ce qui impose **Ux < 0** (VB>VA : la plaque de sortie B doit être au potentiel le plus élevé pour attirer l'électron négatif).\n\n**Signe de Uz :** pour dévier l'électron vers la plaque C (potentiel plus élevé, d'après le schéma où C est la plaque supérieure vers laquelle le faisceau doit s'incurver), il faut que la force électrique soit dirigée vers C, soit, pour une charge négative, un champ dirigé de C vers E. Ceci correspond à **Uz > 0** (VC>VE, la plaque supérieure C étant portée au potentiel le plus élevé, attire l'électron chargé négativement).\n\n### Piège à éviter\nNe pas oublier le signe négatif de la charge de l'électron dans le raisonnement : pour une charge négative, la force électrique est **opposée** au champ électrique, ce qui inverse l'intuition naturelle liant signe de tension et sens de déviation.\n\n### Conseil\nToujours établir un schéma clair avec les vecteurs force, champ et vitesse avant de conclure sur le signe d'une tension accélératrice ou déflectrice, en particulier pour une particule chargée négativement.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e160f0>, '', datetime.datetime(2026, 8, 7, 17, 11, 16, 821264, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 16, 821270, tzinfo=datetime.timezone.utc)); alias=default
