(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'B.4', 8, 'Calculer la distance OXp, où Xp est le point de chute du ballon sur le plan horizontal.', '### Rappel de méthode
Le point de chute sur le plan horizontal (y=0, x≠0) s''obtient en résolvant l''équation de la trajectoire pour y=0 ; la distance obtenue est la portée du tir.

### Corrigé
Au point de chute, y=0 et x=OXp≠0. D''après l''équation de la trajectoire :
$$0 = OX_p\tan\alpha - \dfrac{g}{2v_0^2\cos^2\alpha}OX_p^2$$
$$OX_p\left(\tan\alpha - \dfrac{g}{2v_0^2\cos^2\alpha}OX_p\right)=0$$
En écartant la solution triviale OXp=0 :
$$OX_p = \dfrac{2v_0^2\cos^2\alpha\tan\alpha}{g} = \dfrac{v_0^2\sin(2\alpha)}{g}$$
**Application numérique :**
$$OX_p = \dfrac{20^2\times\sin(120°)}{9{,}8} = \dfrac{400\times0{,}866}{9{,}8} \approx 35{,}3\ \text{m}$$

### Piège à éviter
Ne pas oublier d''écarter la solution triviale x=0 (point de départ), qui vérifie aussi l''équation mais ne correspond pas au point de chute recherché.

### Conseil
Retenir la formule classique de la portée OXp=v0²sin(2α)/g pour tout lancer parabolique retombant au même niveau que le point de départ : elle évite de refaire tout le calcul à chaque fois.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.158078+00:00'::timestamptz, '2026-08-07T17:11:18.158086+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'B.4', 8, 'Calculer la distance OXp, où Xp est le point de chute du ballon sur le plan horizontal.', "### Rappel de méthode\nLe point de chute sur le plan horizontal (y=0, x≠0) s'obtient en résolvant l'équation de la trajectoire pour y=0 ; la distance obtenue est la portée du tir.\n\n### Corrigé\nAu point de chute, y=0 et x=OXp≠0. D'après l'équation de la trajectoire :\n$$0 = OX_p\\tan\\alpha - \\dfrac{g}{2v_0^2\\cos^2\\alpha}OX_p^2$$\n$$OX_p\\left(\\tan\\alpha - \\dfrac{g}{2v_0^2\\cos^2\\alpha}OX_p\\right)=0$$\nEn écartant la solution triviale OXp=0 :\n$$OX_p = \\dfrac{2v_0^2\\cos^2\\alpha\\tan\\alpha}{g} = \\dfrac{v_0^2\\sin(2\\alpha)}{g}$$\n**Application numérique :**\n$$OX_p = \\dfrac{20^2\\times\\sin(120°)}{9{,}8} = \\dfrac{400\\times0{,}866}{9{,}8} \\approx 35{,}3\\ \\text{m}$$\n\n### Piège à éviter\nNe pas oublier d'écarter la solution triviale x=0 (point de départ), qui vérifie aussi l'équation mais ne correspond pas au point de chute recherché.\n\n### Conseil\nRetenir la formule classique de la portée OXp=v0²sin(2α)/g pour tout lancer parabolique retombant au même niveau que le point de départ : elle évite de refaire tout le calcul à chaque fois.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e33920>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 158078, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 158086, tzinfo=datetime.timezone.utc)); alias=default
