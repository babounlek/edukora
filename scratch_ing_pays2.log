(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7520, '1', 1, 'Aider les élèves à vérifier la conformité de la fréquence fe=20Hz indiquée sur la plaque signalétique, à partir des données de l''expérience 1 (stroboscopie sur rides circulaires).', '### Rappel de méthode
Lorsqu''un phénomène périodique de fréquence N est observé immobile sous un éclairage stroboscopique de fréquence fe, la condition d''immobilité apparente impose que le rapport N/fe soit un nombre entier k (cas d''immobilité vraie, k pouvant valoir 1, 2, 3...).

### Corrigé
**Longueur d''onde des rides à la surface de l''eau :** la distance d sépare la 1ère et la 21e ride, soit 20 intervalles (longueurs d''onde) :
$$\lambda_{eau} = \dfrac{d}{20} = \dfrac{0{,}20}{20} = 0{,}01\ \text{m} = 1\ \text{cm}$$

**Fréquence N des rides (fréquence du vibreur) :**
$$N = \dfrac{c}{\lambda_{eau}} = \dfrac{0{,}4}{0{,}01} = 40\ \text{Hz}$$

**Vérification de la condition d''immobilité apparente :**
$$\dfrac{N}{f_e} = \dfrac{40}{20} = 2$$
Ce rapport est un nombre entier (k=2), ce qui est cohérent avec l''observation de rides immobiles sous l''éclairage stroboscopique à fe=20Hz (cas particulier où le stroboscope n''éclaire qu''une fois sur deux périodes du phénomène, ce qui donne aussi une image immobile).

**Conclusion :** la fréquence fe=20Hz indiquée sur la plaque signalétique est **conforme**, puisqu''elle vérifie bien la condition d''immobilité apparente N/fe entier.

### Piège à éviter
Ne pas se limiter au cas k=1 (N=fe) : l''immobilité apparente sous éclairage stroboscopique s''observe aussi pour tout multiple entier, N=k·fe avec k=1,2,3...

### Conseil
Toujours calculer d''abord la fréquence réelle du phénomène périodique observé (ici via λeau et c), puis comparer le rapport N/fe à un nombre entier, plutôt que de comparer directement N à fe.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:17.105008+00:00'::timestamptz, '2026-08-07T17:11:17.105015+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7520, '1', 1, "Aider les élèves à vérifier la conformité de la fréquence fe=20Hz indiquée sur la plaque signalétique, à partir des données de l'expérience 1 (stroboscopie sur rides circulaires).", "### Rappel de méthode\nLorsqu'un phénomène périodique de fréquence N est observé immobile sous un éclairage stroboscopique de fréquence fe, la condition d'immobilité apparente impose que le rapport N/fe soit un nombre entier k (cas d'immobilité vraie, k pouvant valoir 1, 2, 3...).\n\n### Corrigé\n**Longueur d'onde des rides à la surface de l'eau :** la distance d sépare la 1ère et la 21e ride, soit 20 intervalles (longueurs d'onde) :\n$$\\lambda_{eau} = \\dfrac{d}{20} = \\dfrac{0{,}20}{20} = 0{,}01\\ \\text{m} = 1\\ \\text{cm}$$\n\n**Fréquence N des rides (fréquence du vibreur) :**\n$$N = \\dfrac{c}{\\lambda_{eau}} = \\dfrac{0{,}4}{0{,}01} = 40\\ \\text{Hz}$$\n\n**Vérification de la condition d'immobilité apparente :**\n$$\\dfrac{N}{f_e} = \\dfrac{40}{20} = 2$$\nCe rapport est un nombre entier (k=2), ce qui est cohérent avec l'observation de rides immobiles sous l'éclairage stroboscopique à fe=20Hz (cas particulier où le stroboscope n'éclaire qu'une fois sur deux périodes du phénomène, ce qui donne aussi une image immobile).\n\n**Conclusion :** la fréquence fe=20Hz indiquée sur la plaque signalétique est **conforme**, puisqu'elle vérifie bien la condition d'immobilité apparente N/fe entier.\n\n### Piège à éviter\nNe pas se limiter au cas k=1 (N=fe) : l'immobilité apparente sous éclairage stroboscopique s'observe aussi pour tout multiple entier, N=k·fe avec k=1,2,3...\n\n### Conseil\nToujours calculer d'abord la fréquence réelle du phénomène périodique observé (ici via λeau et c), puis comparer le rapport N/fe à un nombre entier, plutôt que de comparer directement N à fe.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e17ec0>, '', datetime.datetime(2026, 8, 7, 17, 11, 17, 105008, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 17, 105015, tzinfo=datetime.timezone.utc)); alias=default
