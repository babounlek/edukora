(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7525, '3.2', 6, 'Déterminer les caractéristiques de E⃗I.', '### Rappel de méthode
Le champ créé par une charge ponctuelle q à une distance r est E=k|q|/r² ; le champ résultant de deux charges colinéaires de sens opposés a pour norme la différence des normes individuelles.

### Corrigé
**Distance de I à chaque charge** (I étant le milieu de O1O2=25cm) :
$$r = \dfrac{25}{2} = 12{,}5\ \text{cm} = 0{,}125\ \text{m}$$

**Champ créé par q1 en I :**
$$E_1 = \dfrac{kq_1}{r^2} = \dfrac{9\times10^9\times10\times10^{-9}}{0{,}125^2} = \dfrac{90}{0{,}015625} \approx 5760\ \text{V/m}$$

**Champ créé par q2 en I :**
$$E_2 = \dfrac{kq_2}{r^2} = \dfrac{9\times10^9\times5{,}0\times10^{-9}}{0{,}125^2} = \dfrac{45}{0{,}015625} \approx 2880\ \text{V/m}$$

**Champ résultant** (E1 et E2 étant colinéaires et de sens opposés, q1 dominant) :
$$E_I = E_1 - E_2 = 5760 - 2880 = 2880\ \text{V/m}$$
dirigé selon la droite (O1O2), dans le sens du champ créé par q1 (de O1 vers O2).

### Piège à éviter
Ne pas additionner directement E1 et E2 : les deux charges étant positives, leurs champs en I sont de sens opposés, il faut donc soustraire leurs normes.

### Conseil
Vérifier que le champ résultant est bien dirigé du côté de la charge la plus faible (ici, vers O2, côté de q2, puisque le champ de q1 domine) : c''est un bon réflexe de vérification physique du sens obtenu.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.279328+00:00'::timestamptz, '2026-08-07T17:11:19.279337+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7525, '3.2', 6, 'Déterminer les caractéristiques de E⃗I.', "### Rappel de méthode\nLe champ créé par une charge ponctuelle q à une distance r est E=k|q|/r² ; le champ résultant de deux charges colinéaires de sens opposés a pour norme la différence des normes individuelles.\n\n### Corrigé\n**Distance de I à chaque charge** (I étant le milieu de O1O2=25cm) :\n$$r = \\dfrac{25}{2} = 12{,}5\\ \\text{cm} = 0{,}125\\ \\text{m}$$\n\n**Champ créé par q1 en I :**\n$$E_1 = \\dfrac{kq_1}{r^2} = \\dfrac{9\\times10^9\\times10\\times10^{-9}}{0{,}125^2} = \\dfrac{90}{0{,}015625} \\approx 5760\\ \\text{V/m}$$\n\n**Champ créé par q2 en I :**\n$$E_2 = \\dfrac{kq_2}{r^2} = \\dfrac{9\\times10^9\\times5{,}0\\times10^{-9}}{0{,}125^2} = \\dfrac{45}{0{,}015625} \\approx 2880\\ \\text{V/m}$$\n\n**Champ résultant** (E1 et E2 étant colinéaires et de sens opposés, q1 dominant) :\n$$E_I = E_1 - E_2 = 5760 - 2880 = 2880\\ \\text{V/m}$$\ndirigé selon la droite (O1O2), dans le sens du champ créé par q1 (de O1 vers O2).\n\n### Piège à éviter\nNe pas additionner directement E1 et E2 : les deux charges étant positives, leurs champs en I sont de sens opposés, il faut donc soustraire leurs normes.\n\n### Conseil\nVérifier que le champ résultant est bien dirigé du côté de la charge la plus faible (ici, vers O2, côté de q2, puisque le champ de q1 domine) : c'est un bon réflexe de vérification physique du sens obtenu.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5cdd0>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 279328, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 279337, tzinfo=datetime.timezone.utc)); alias=default
