(0.001) SELECT "catalog_exercise"."id", "catalog_exercise"."numero_exercice", "catalog_exercise"."points", "catalog_exercise"."enonce_intro_markdown", "catalog_exercise"."enonce_markdown", "catalog_exercise"."corrige_markdown", "catalog_exercise"."incertitudes", "catalog_exercise"."statut", "catalog_exercise"."lesson_id", "catalog_exercise"."created_at", "catalog_exercise"."updated_at" FROM "catalog_exercise" INNER JOIN "catalog_lesson" ON ("catalog_exercise"."lesson_id" = "catalog_lesson"."id") WHERE ("catalog_exercise"."lesson_id" = 889 AND "catalog_exercise"."numero_exercice" = '4') ORDER BY "catalog_lesson"."year" DESC, "catalog_lesson"."title" ASC, "catalog_exercise"."numero_exercice" ASC LIMIT 1; args=(889, '4'); alias=default
(0.000) INSERT INTO "catalog_exercise" ("numero_exercice", "points", "enonce_intro_markdown", "enonce_markdown", "corrige_markdown", "incertitudes", "statut", "lesson_id", "created_at", "updated_at") VALUES ('4', '4', '**EXERCICE 4 : Expérience de physique - 4 points**

L''objectif de cet exercice est de déterminer l''énergie minimale d''extraction W0 d''un électron d''un métal constituant la cathode d''une cellule photoélectrique. Pour ce faire, on éclaire cette cellule avec différentes radiations de fréquence N et on mesure les potentiels d''arrêt correspondants. On obtient les résultats suivants :

| N (×10¹⁴ Hz) | 5,5 | 6,2 | 6,9 | 7,5 | 8,4 |
|---|---|---|---|---|---|
| U0 (V) | 0,20 | 0,49 | 0,79 | 1,03 | 1,38 |', '', '', '[]'::jsonb, 'VALIDE', 889, '2026-08-07T17:11:18.808981+00:00'::timestamptz, '2026-08-07T17:11:18.808991+00:00'::timestamptz) RETURNING "catalog_exercise"."id"; args=('4', '4', "**EXERCICE 4 : Expérience de physique - 4 points**\n\nL'objectif de cet exercice est de déterminer l'énergie minimale d'extraction W0 d'un électron d'un métal constituant la cathode d'une cellule photoélectrique. Pour ce faire, on éclaire cette cellule avec différentes radiations de fréquence N et on mesure les potentiels d'arrêt correspondants. On obtient les résultats suivants :\n\n| N (×10¹⁴ Hz) | 5,5 | 6,2 | 6,9 | 7,5 | 8,4 |\n|---|---|---|---|---|---|\n| U0 (V) | 0,20 | 0,49 | 0,79 | 1,03 | 1,38 |", '', '', <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5ec60>, StatutContenu.VALIDE, 889, datetime.datetime(2026, 8, 7, 17, 11, 18, 808981, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 808991, tzinfo=datetime.timezone.utc)); alias=default
