(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7518, 'cours-determiner-la-variation-denergie-de-la-reaction-2024', '', 'La variation d''énergie d''une réaction nucléaire se calcule à partir du défaut de masse Δm=mfinale-minitiale, converti en énergie via ΔE=Δm·c², soit ΔE=Δm(u)×931,5 MeV lorsque Δm est exprimé en u.', NULL, '2026-08-07T17:11:16.680873+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7518, 'cours-determiner-la-variation-denergie-de-la-reaction-2024', '', "La variation d'énergie d'une réaction nucléaire se calcule à partir du défaut de masse Δm=mfinale-minitiale, converti en énergie via ΔE=Δm·c², soit ΔE=Δm(u)×931,5 MeV lorsque Δm est exprimé en u.", None, datetime.datetime(2026, 8, 7, 17, 11, 16, 680873, tzinfo=datetime.timezone.utc)); alias=default
