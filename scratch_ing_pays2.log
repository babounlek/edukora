(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7526, '2', 2, 'Examine si ONANA est gagnant ou non.', '### Rappel de méthode
Pour vérifier si le projectile atteint la cible E, il faut établir l''équation de la trajectoire parabolique du mouvement de chute libre à partir de O, puis vérifier si le point de coordonnées (xE, yE) appartient effectivement à cette trajectoire.

### Corrigé
**Équation de la trajectoire** (chute libre à partir de O, vitesse v0=4,0m/s inclinée de α=60° par rapport à l''horizontale) :
$$y = x\tan\alpha - \dfrac{g}{2v_0^2\cos^2\alpha}x^2$$

**Calcul de y pour x=xE=0,69m :**
$$y(0{,}69) = 0{,}69\times\tan60° - \dfrac{9{,}8}{2\times4{,}0^2\times\cos^2 60°}\times0{,}69^2$$
$$y(0{,}69) = 0{,}69\times1{,}732 - \dfrac{9{,}8}{2\times16\times0{,}25}\times0{,}4761$$
$$y(0{,}69) \approx 1{,}195 - 0{,}583 \approx 0{,}61\ \text{m}$$

**Comparaison avec yE=0,59m donné :** la valeur calculée (y≈0,61m) est légèrement **supérieure** à l''ordonnée yE=0,59m de la cible (écart d''environ 2cm). Le point (xE, yE) n''appartient donc pas exactement à la trajectoire du projectile : lorsque celui-ci se trouve à l''abscisse x=xE, il se situe environ 2cm **au-dessus** du point où se trouve la cible E.

**Conclusion :** **ONANA n''est pas gagnant.** Bien que sa vitesse v0=4,0m/s ait été correctement obtenue (l''accélération calculée par TAGNE le confirme), son projectile passe légèrement au-dessus de la cible E et ne l''atteint donc pas exactement.

### Piège à éviter
Ne pas se contenter de comparer les ordres de grandeur : il faut vérifier numériquement, avec précision, si y(xE) est bien égal à yE avant de conclure à la réussite du tir.

### Conseil
Toujours substituer la valeur exacte de x dans l''équation de la trajectoire, plutôt que de résoudre pour x en supposant y=yE, pour tester rigoureusement l''appartenance d''un point donné à une trajectoire parabolique.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.384373+00:00'::timestamptz, '2026-08-07T17:11:19.384380+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7526, '2', 2, 'Examine si ONANA est gagnant ou non.', "### Rappel de méthode\nPour vérifier si le projectile atteint la cible E, il faut établir l'équation de la trajectoire parabolique du mouvement de chute libre à partir de O, puis vérifier si le point de coordonnées (xE, yE) appartient effectivement à cette trajectoire.\n\n### Corrigé\n**Équation de la trajectoire** (chute libre à partir de O, vitesse v0=4,0m/s inclinée de α=60° par rapport à l'horizontale) :\n$$y = x\\tan\\alpha - \\dfrac{g}{2v_0^2\\cos^2\\alpha}x^2$$\n\n**Calcul de y pour x=xE=0,69m :**\n$$y(0{,}69) = 0{,}69\\times\\tan60° - \\dfrac{9{,}8}{2\\times4{,}0^2\\times\\cos^2 60°}\\times0{,}69^2$$\n$$y(0{,}69) = 0{,}69\\times1{,}732 - \\dfrac{9{,}8}{2\\times16\\times0{,}25}\\times0{,}4761$$\n$$y(0{,}69) \\approx 1{,}195 - 0{,}583 \\approx 0{,}61\\ \\text{m}$$\n\n**Comparaison avec yE=0,59m donné :** la valeur calculée (y≈0,61m) est légèrement **supérieure** à l'ordonnée yE=0,59m de la cible (écart d'environ 2cm). Le point (xE, yE) n'appartient donc pas exactement à la trajectoire du projectile : lorsque celui-ci se trouve à l'abscisse x=xE, il se situe environ 2cm **au-dessus** du point où se trouve la cible E.\n\n**Conclusion :** **ONANA n'est pas gagnant.** Bien que sa vitesse v0=4,0m/s ait été correctement obtenue (l'accélération calculée par TAGNE le confirme), son projectile passe légèrement au-dessus de la cible E et ne l'atteint donc pas exactement.\n\n### Piège à éviter\nNe pas se contenter de comparer les ordres de grandeur : il faut vérifier numériquement, avec précision, si y(xE) est bien égal à yE avant de conclure à la réussite du tir.\n\n### Conseil\nToujours substituer la valeur exacte de x dans l'équation de la trajectoire, plutôt que de résoudre pour x en supposant y=yE, pour tester rigoureusement l'appartenance d'un point donné à une trajectoire parabolique.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5ef90>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 384373, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 384380, tzinfo=datetime.timezone.utc)); alias=default
