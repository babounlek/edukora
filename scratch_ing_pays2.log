(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7523, 'B.3', 6, 'Déterminer x et y (nombre de masse et numéro atomique du radon produit).', '### Rappel de méthode
Une équation de désintégration nucléaire doit vérifier les lois de conservation du nombre de nucléons (A) et du nombre de charge (Z) de part et d''autre de la flèche (lois de Soddy).

### Corrigé
**Conservation du nombre de nucléons (A) :**
$$226 = x + 4 \quad\Rightarrow\quad x = 222$$

**Conservation du numéro atomique (Z) :**
$$88 = y + 2 \quad\Rightarrow\quad y = 86$$

Le noyau produit est donc ²²²₈₆Rn, ce qui est cohérent avec le numéro atomique réel du radon (Z=86).

### Piège à éviter
Ne pas intervertir les deux équations de conservation (celle du nombre de masse et celle du numéro atomique).

### Conseil
Vérifier systématiquement, après avoir déterminé x et y, que le numéro atomique obtenu correspond bien à l''élément annoncé dans l''énoncé (ici, Rn correspond bien à Z=86) : c''est un excellent moyen de valider le résultat.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.685569+00:00'::timestamptz, '2026-08-07T17:11:18.685576+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7523, 'B.3', 6, 'Déterminer x et y (nombre de masse et numéro atomique du radon produit).', "### Rappel de méthode\nUne équation de désintégration nucléaire doit vérifier les lois de conservation du nombre de nucléons (A) et du nombre de charge (Z) de part et d'autre de la flèche (lois de Soddy).\n\n### Corrigé\n**Conservation du nombre de nucléons (A) :**\n$$226 = x + 4 \\quad\\Rightarrow\\quad x = 222$$\n\n**Conservation du numéro atomique (Z) :**\n$$88 = y + 2 \\quad\\Rightarrow\\quad y = 86$$\n\nLe noyau produit est donc ²²²₈₆Rn, ce qui est cohérent avec le numéro atomique réel du radon (Z=86).\n\n### Piège à éviter\nNe pas intervertir les deux équations de conservation (celle du nombre de masse et celle du numéro atomique).\n\n### Conseil\nVérifier systématiquement, après avoir déterminé x et y, que le numéro atomique obtenu correspond bien à l'élément annoncé dans l'énoncé (ici, Rn correspond bien à Z=86) : c'est un excellent moyen de valider le résultat.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5c860>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 685569, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 685576, tzinfo=datetime.timezone.utc)); alias=default
