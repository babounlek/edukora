(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7522, '2.3', 4, 'Sachant que ce pendule simple a une longueur de 1m, déterminer la valeur de l''accélération de la pesanteur en ce lieu.', '### Rappel de méthode
La période propre d''un pendule simple en petites oscillations est T=2π√(L/g) ; il suffit d''isoler g à partir de cette relation et des valeurs de T et L.

### Corrigé
De la relation $T=2\pi\sqrt{\dfrac{L}{g}}$, on isole g :
$$g = \dfrac{4\pi^2 L}{T^2}$$
**Application numérique :**
$$g = \dfrac{4\pi^2\times1}{2^2} = \pi^2 \approx 9{,}87\ \text{m/s}^2$$

### Piège à éviter
Ne pas oublier d''élever la période T au carré (erreur fréquente : diviser directement par T au lieu de T²).

### Conseil
Vérifier que la valeur obtenue pour g est cohérente avec la valeur usuelle attendue sur Terre (environ 9,8m/s²) : ici, g≈9,87m/s² est effectivement très proche de cette valeur de référence, ce qui valide la lecture du graphe.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.376651+00:00'::timestamptz, '2026-08-07T17:11:18.376658+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7522, '2.3', 4, "Sachant que ce pendule simple a une longueur de 1m, déterminer la valeur de l'accélération de la pesanteur en ce lieu.", "### Rappel de méthode\nLa période propre d'un pendule simple en petites oscillations est T=2π√(L/g) ; il suffit d'isoler g à partir de cette relation et des valeurs de T et L.\n\n### Corrigé\nDe la relation $T=2\\pi\\sqrt{\\dfrac{L}{g}}$, on isole g :\n$$g = \\dfrac{4\\pi^2 L}{T^2}$$\n**Application numérique :**\n$$g = \\dfrac{4\\pi^2\\times1}{2^2} = \\pi^2 \\approx 9{,}87\\ \\text{m/s}^2$$\n\n### Piège à éviter\nNe pas oublier d'élever la période T au carré (erreur fréquente : diviser directement par T au lieu de T²).\n\n### Conseil\nVérifier que la valeur obtenue pour g est cohérente avec la valeur usuelle attendue sur Terre (environ 9,8m/s²) : ici, g≈9,87m/s² est effectivement très proche de cette valeur de référence, ce qui valide la lecture du graphe.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e31b20>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 376651, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 376658, tzinfo=datetime.timezone.utc)); alias=default
