(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7518, 'cours-cette-reaction-est-elle-spontanee-2024', '', 'Une réaction nucléaire est spontanée si elle libère de l''énergie (ΔE<0 dans la convention Δm=mfinale-minitiale négatif signifiant énergie libérée) ; ici la convention utilisée donne ΔE négatif correspondant à une énergie à fournir, donc réaction non spontanée.', NULL, '2026-08-07T17:11:16.727358+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7518, 'cours-cette-reaction-est-elle-spontanee-2024', '', "Une réaction nucléaire est spontanée si elle libère de l'énergie (ΔE<0 dans la convention Δm=mfinale-minitiale négatif signifiant énergie libérée) ; ici la convention utilisée donne ΔE négatif correspondant à une énergie à fournir, donc réaction non spontanée.", None, datetime.datetime(2026, 8, 7, 17, 11, 16, 727358, tzinfo=datetime.timezone.utc)); alias=default
