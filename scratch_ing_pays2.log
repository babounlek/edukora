(0.000) INSERT INTO "catalog_rappeldemethode" ("exercise_id", "external_id", "competence", "contenu_markdown", "cours_id", "created_at") VALUES (7521, 'cours-representer-la-force-electromagnetique-qui-sapplique-sur-la-tige', '', 'La force électromagnétique (force de Laplace) subie par un conducteur rectiligne parcouru par un courant I dans un champ magnétique uniforme $\vec{B}$ est $\vec{F}=I\vec{AM}\times\vec{B}$ ; son sens s''obtient par la règle de la main droite (ou des trois doigts).', NULL, '2026-08-07T17:11:17.863495+00:00'::timestamptz) RETURNING "catalog_rappeldemethode"."id"; args=(7521, 'cours-representer-la-force-electromagnetique-qui-sapplique-sur-la-tige', '', "La force électromagnétique (force de Laplace) subie par un conducteur rectiligne parcouru par un courant I dans un champ magnétique uniforme $\\vec{B}$ est $\\vec{F}=I\\vec{AM}\\times\\vec{B}$ ; son sens s'obtient par la règle de la main droite (ou des trois doigts).", None, datetime.datetime(2026, 8, 7, 17, 11, 17, 863495, tzinfo=datetime.timezone.utc)); alias=default
