(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7522, '2.1', 2, 'En exploitant le graphe (figure 3), déterminer la période, l''amplitude maximale des oscillations et l''élongation initiale de ce pendule.', '### Rappel de méthode
Sur un graphe θ=f(t), la période T se lit comme la durée séparant deux passages consécutifs par un même état (ex. deux zéros consécutifs de même sens de variation), l''amplitude maximale θm est la valeur maximale atteinte par |θ|, et l''élongation initiale est la valeur θ(0) lue à t=0.

### Corrigé
**Période :** le graphe présente des passages par zéro (en décroissant) aux instants t=1s et t=3s ; la durée séparant ces deux passages correspond à une période complète :
$$T = 3 - 1 = 2\ \text{s}$$

**Amplitude maximale :** la valeur crête du graphe atteint θm=0,25 rad (lue au sommet des maxima et minima).

**Élongation initiale :** à t=0, la courbe passe par θ(0)=0 rad (le graphe démarre exactement à l''origine des élongations).

### Piège à éviter
Ne pas confondre la période T (durée d''un cycle complet) avec la demi-période (durée entre un maximum et le minimum suivant, qui vaut T/2=1s ici).

### Conseil
Pour lire précisément une période sur un graphe, privilégier les passages par zéro avec le même sens de variation (montant ou descendant), plus faciles à repérer visuellement que les sommets arrondis des extrema.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.282285+00:00'::timestamptz, '2026-08-07T17:11:18.282294+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7522, '2.1', 2, "En exploitant le graphe (figure 3), déterminer la période, l'amplitude maximale des oscillations et l'élongation initiale de ce pendule.", "### Rappel de méthode\nSur un graphe θ=f(t), la période T se lit comme la durée séparant deux passages consécutifs par un même état (ex. deux zéros consécutifs de même sens de variation), l'amplitude maximale θm est la valeur maximale atteinte par |θ|, et l'élongation initiale est la valeur θ(0) lue à t=0.\n\n### Corrigé\n**Période :** le graphe présente des passages par zéro (en décroissant) aux instants t=1s et t=3s ; la durée séparant ces deux passages correspond à une période complète :\n$$T = 3 - 1 = 2\\ \\text{s}$$\n\n**Amplitude maximale :** la valeur crête du graphe atteint θm=0,25 rad (lue au sommet des maxima et minima).\n\n**Élongation initiale :** à t=0, la courbe passe par θ(0)=0 rad (le graphe démarre exactement à l'origine des élongations).\n\n### Piège à éviter\nNe pas confondre la période T (durée d'un cycle complet) avec la demi-période (durée entre un maximum et le minimum suivant, qui vaut T/2=1s ici).\n\n### Conseil\nPour lire précisément une période sur un graphe, privilégier les passages par zéro avec le même sens de variation (montant ou descendant), plus faciles à repérer visuellement que les sommets arrondis des extrema.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e31490>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 282285, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 282294, tzinfo=datetime.timezone.utc)); alias=default
