(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7525, '1.2', 2, 'Un échantillon contient 2g de cobalt-60 à t=0s. Déterminer la masse de l''isotope au bout de 15,9 ans.', '### Rappel de méthode
La décroissance radioactive suit une loi exponentielle m(t)=m0×(1/2)^(t/T), où T est la demi-vie de l''isotope.

### Corrigé
**Nombre de demi-vies écoulées :**
$$n = \dfrac{t}{T} = \dfrac{15{,}9}{5{,}3} = 3{,}0$$

**Masse restante :**
$$m(t) = m_0\times\left(\dfrac{1}{2}\right)^n = 2\times\left(\dfrac{1}{2}\right)^3 = 2\times\dfrac{1}{8} = 0{,}25\ \text{g}$$

### Piège à éviter
Ne pas oublier de calculer d''abord le nombre entier (ou non) de demi-vies écoulées avant d''appliquer l''exposant.

### Conseil
Remarquer que 15,9 ans correspond exactement à 3 demi-vies (3×5,3=15,9), ce qui simplifie grandement le calcul et confirme la cohérence des données choisies pour cet exercice.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:19.111094+00:00'::timestamptz, '2026-08-07T17:11:19.111100+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7525, '1.2', 2, "Un échantillon contient 2g de cobalt-60 à t=0s. Déterminer la masse de l'isotope au bout de 15,9 ans.", "### Rappel de méthode\nLa décroissance radioactive suit une loi exponentielle m(t)=m0×(1/2)^(t/T), où T est la demi-vie de l'isotope.\n\n### Corrigé\n**Nombre de demi-vies écoulées :**\n$$n = \\dfrac{t}{T} = \\dfrac{15{,}9}{5{,}3} = 3{,}0$$\n\n**Masse restante :**\n$$m(t) = m_0\\times\\left(\\dfrac{1}{2}\\right)^n = 2\\times\\left(\\dfrac{1}{2}\\right)^3 = 2\\times\\dfrac{1}{8} = 0{,}25\\ \\text{g}$$\n\n### Piège à éviter\nNe pas oublier de calculer d'abord le nombre entier (ou non) de demi-vies écoulées avant d'appliquer l'exposant.\n\n### Conseil\nRemarquer que 15,9 ans correspond exactement à 3 demi-vies (3×5,3=15,9), ce qui simplifie grandement le calcul et confirme la cohérence des données choisies pour cet exercice.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e5fce0>, '', datetime.datetime(2026, 8, 7, 17, 11, 19, 111094, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 19, 111100, tzinfo=datetime.timezone.utc)); alias=default
