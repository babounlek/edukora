(0.000) INSERT INTO "catalog_question" ("exercise_id", "numero", "ordre", "enonce_markdown", "corrige_markdown", "difficulte_estimee", "type_reponse", "choix", "reponse_correcte", "created_at", "updated_at") VALUES (7521, 'B.2', 6, 'Appliquer le théorème du centre d''inertie au ballon et déterminer les lois horaires du mouvement.', '### Rappel de méthode
Le théorème du centre d''inertie appliqué à un solide en chute libre donne une accélération constante égale à g ; les lois horaires s''obtiennent par deux intégrations successives, en utilisant les conditions initiales (position et vitesse à t=0).

### Corrigé
**Théorème du centre d''inertie :** le ballon n''étant soumis qu''à son poids, $m\vec{a}=m\vec{g}$, donc $\vec{a}=\vec{g}$, soit en projection sur les axes (Ox horizontal, Oy vertical ascendant) :
$$a_x = 0 \qquad a_y = -g$$

**Vitesse** (par intégration, avec $v_{0x}=v_0\cos\alpha$, $v_{0y}=v_0\sin\alpha$ à t=0) :
$$v_x = v_0\cos\alpha \qquad v_y = v_0\sin\alpha - gt$$

**Position** (par intégration, avec x(0)=0, y(0)=0) :
$$x(t) = (v_0\cos\alpha)\,t \qquad y(t) = (v_0\sin\alpha)\,t - \dfrac{1}{2}gt^2$$

### Piège à éviter
Ne pas oublier la composante horizontale de la vitesse initiale (constante tout au long du mouvement, l''accélération étant purement verticale).

### Conseil
Toujours projeter l''accélération, puis la vitesse, puis la position, dans cet ordre, sur chacun des deux axes séparément : la méthode est identique quel que soit l''angle de lancement.', '', 'OUVERTE', '[]'::jsonb, '', '2026-08-07T17:11:18.056174+00:00'::timestamptz, '2026-08-07T17:11:18.056183+00:00'::timestamptz) RETURNING "catalog_question"."id"; args=(7521, 'B.2', 6, "Appliquer le théorème du centre d'inertie au ballon et déterminer les lois horaires du mouvement.", "### Rappel de méthode\nLe théorème du centre d'inertie appliqué à un solide en chute libre donne une accélération constante égale à g ; les lois horaires s'obtiennent par deux intégrations successives, en utilisant les conditions initiales (position et vitesse à t=0).\n\n### Corrigé\n**Théorème du centre d'inertie :** le ballon n'étant soumis qu'à son poids, $m\\vec{a}=m\\vec{g}$, donc $\\vec{a}=\\vec{g}$, soit en projection sur les axes (Ox horizontal, Oy vertical ascendant) :\n$$a_x = 0 \\qquad a_y = -g$$\n\n**Vitesse** (par intégration, avec $v_{0x}=v_0\\cos\\alpha$, $v_{0y}=v_0\\sin\\alpha$ à t=0) :\n$$v_x = v_0\\cos\\alpha \\qquad v_y = v_0\\sin\\alpha - gt$$\n\n**Position** (par intégration, avec x(0)=0, y(0)=0) :\n$$x(t) = (v_0\\cos\\alpha)\\,t \\qquad y(t) = (v_0\\sin\\alpha)\\,t - \\dfrac{1}{2}gt^2$$\n\n### Piège à éviter\nNe pas oublier la composante horizontale de la vitesse initiale (constante tout au long du mouvement, l'accélération étant purement verticale).\n\n### Conseil\nToujours projeter l'accélération, puis la vitesse, puis la position, dans cet ordre, sur chacun des deux axes séparément : la méthode est identique quel que soit l'angle de lancement.", '', TypeReponse.OUVERTE, <django.db.backends.postgresql.psycopg_any.Jsonb object at 0x770259e31d30>, '', datetime.datetime(2026, 8, 7, 17, 11, 18, 56174, tzinfo=datetime.timezone.utc), datetime.datetime(2026, 8, 7, 17, 11, 18, 56183, tzinfo=datetime.timezone.utc)); alias=default
