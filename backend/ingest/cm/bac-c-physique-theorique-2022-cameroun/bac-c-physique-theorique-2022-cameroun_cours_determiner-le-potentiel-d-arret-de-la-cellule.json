      "type": "regle",
      "titre": "Calcul du potentiel d'arrêt",
      "contenu_markdown": "U0=(Ephoton-W0)/e, avec Ephoton et W0 exprimés dans la même unité (eV recommandé).",
      "formule_principale": "U0 = (Ephoton-W0)/e",
      "variantes": []
    },
