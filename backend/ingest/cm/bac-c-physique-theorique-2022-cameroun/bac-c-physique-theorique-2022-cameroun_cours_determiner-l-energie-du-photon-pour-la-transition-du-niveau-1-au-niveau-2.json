  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "L'énergie du photon absorbé ou émis lors d'une transition électronique est égale à la différence d'énergie entre les deux niveaux concernés."
    },
    {
      "type": "prerequis",
      "items": [
        "En=-13,6/n²"
      ]
    },
    {
      "type": "regle",
      "titre": "Énergie d'un photon de transition",
      "contenu_markdown": "Ephoton=E2-E1 (transition n=1 vers n=2).",
      "formule_principale": "Ephoton = E2-E1",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Calculer l'énergie du photon faisant passer l'électron du niveau 1 au niveau 2.",
      "epreuve_source": true,
      "etapes": [
        "Calculer E1 et E2",
        "Soustraire E2-E1"
      ],
      "conclusion_markdown": "Ephoton = 10,2 eV"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Intervertir E1 et E2 dans la soustraction"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Calculer l'énergie du photon émis lors de la transition inverse (2→1)"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "ΔE=Ehaut-Ebas, toujours positive, que ce soit en absorption ou en émission"
      ]
    }
