      "titre": "v0 = E/B",
      "contenu_markdown": "À l'équilibre, qE=qv0B, d'où v0=E/B : la charge s'élimine, la masse n'apparaît pas.",
      "formule_principale": "v0 = E/B",
      "variantes": []
    },
