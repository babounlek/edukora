      "type": "prerequis",
      "items": []
    },
    {
      "type": "regle",
      "titre": "W0=hc/λ0",
      "contenu_markdown": "Le travail d'extraction W0 est l'énergie du photon de longueur d'onde égale à la longueur d'onde seuil λ0 : W0=hc/λ0.",
      "formule_principale": "W0 = hc/λ0",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "λ0=0,65×10⁻⁶m : calculer W0.",
      "epreuve_source": true,
      "etapes": [
        "Identifier λ0.",
        "Appliquer W0=hc/λ0."
      ],
      "conclusion_markdown": "W0≈1,91eV pour λ0=0,65×10⁻⁶m."
    },
    {
      "type": "erreurs_classiques",
      "items": [
