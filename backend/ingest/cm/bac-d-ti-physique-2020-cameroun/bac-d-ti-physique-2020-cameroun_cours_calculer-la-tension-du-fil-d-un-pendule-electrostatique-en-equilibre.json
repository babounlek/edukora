  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "Diviser le poids par le cosinus de l'angle d'inclinaison révèle la tension exacte supportée par un fil."
    },
    {
      "type": "prerequis",
      "items": [
        "T=P/cosα"
      ]
    },
    {
      "type": "regle",
      "titre": "T=mg/cosα",
      "contenu_markdown": "À l'équilibre, la projection verticale des forces donne P=Tcosα, d'où T=mg/cosα.",
      "formule_principale": "T = mg/cosα",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "m=10g, α=8°, g=9,8m/s² : calculer T.",
      "epreuve_source": true,
      "etapes": [
        "Écrire P=Tcosα.",
        "Isoler T=mg/cosα."
      ],
      "conclusion_markdown": "T≈0,099N pour les données de l'exercice."
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Confondre T=mg/cosα avec F=mg tanα."
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Calculer T pour m=8g, α=12°."
      ]
    },
    {
      "type": "synthese",
      "items_markdown": "T=mg/cosα complète le calcul de F=mg tanα pour caractériser entièrement l'équilibre d'un pendule électrostatique dans un champ uniforme."
    }
  ]
