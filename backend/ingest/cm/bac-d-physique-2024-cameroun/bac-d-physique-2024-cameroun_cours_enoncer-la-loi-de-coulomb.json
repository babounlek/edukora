  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "La loi de Coulomb décrit la force électrostatique entre deux charges ponctuelles."
    },
    {
      "type": "prerequis",
      "items": [
        "Notion de charge électrique"
      ]
    },
    {
      "type": "regle",
      "titre": "Loi de Coulomb",
      "contenu_markdown": "F=k|q1q2|/r², répulsive si même signe, attractive si signes opposés.",
      "formule_principale": "F = k|q1q2|/r²",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Énoncer la loi de Coulomb.",
      "epreuve_source": true,
      "etapes": [
        "Énoncer la proportionnalité aux charges",
        "Énoncer la loi en 1/r²",
        "Préciser le caractère attractif/répulsif"
      ],
      "conclusion_markdown": "F=k|q1q2|/r²"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Oublier de préciser le caractère attractif ou répulsif selon le signe des charges"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Comparer à la loi de gravitation universelle"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "Contrairement à la gravitation, la force électrostatique peut être répulsive"
      ]
    }
