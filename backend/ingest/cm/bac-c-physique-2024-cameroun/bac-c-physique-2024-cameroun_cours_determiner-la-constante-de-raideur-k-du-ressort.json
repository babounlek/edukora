  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "La pulsation propre d'un pendule élastique relie directement la période mesurée à la constante de raideur."
    },
    {
      "type": "prerequis",
      "items": [
        "ω0=2π/T",
        "ω0²=k/m"
      ]
    },
    {
      "type": "regle",
      "titre": "Constante de raideur à partir de la période",
      "contenu_markdown": "k=mω0², avec ω0=2π/T.",
      "formule_principale": "k = m(2π/T)²",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Déterminer k à partir de m et T d'un pendule élastique.",
      "epreuve_source": true,
      "etapes": [
        "Calculer ω0=2π/T",
        "Calculer k=mω0²"
      ],
      "conclusion_markdown": "k ≈ 2,47 N/m"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Confondre l'amplitude a avec une donnée nécessaire au calcul de k"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Calculer k pour d'autres valeurs de m et T"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "k ne dépend que de m et T (via ω0), jamais de l'amplitude du mouvement"
      ]
    }
  ]
