  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "Combiner Ep=mgL(1-cosθ) avec les approximations des petits angles donne une expression quadratique de Ep en fonction de x."
    },
    {
      "type": "prerequis",
      "items": [
        "Ep=mgz",
        "Approximation 1-cosθ≈θ²/2",
        "θ=x/L"
      ]
    },
    {
      "type": "regle",
      "titre": "Énergie potentielle de pesanteur en petites oscillations",
      "contenu_markdown": "Ep=mgL(1-cosθ)≈mgLθ²/2=mgx²/(2L) en utilisant θ=x/L.",
      "formule_principale": "Ep = mgx²/(2L)",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Exprimer Ep en fonction de x pour un pendule de longueur L.",
      "epreuve_source": true,
      "etapes": [
        "Écrire Ep=mgL(1-cosθ)",
        "Appliquer 1-cosθ≈θ²/2",
        "Substituer θ=x/L"
      ],
      "conclusion_markdown": "Ep = mgx²/(2L)"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Substituer θ=x/L avant d'appliquer l'approximation 1-cosθ≈θ²/2"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Comparer Ep du pendule à celle d'un ressort ½kx²"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "Ep=mgx²/(2L), quadratique en x, forme analogue à l'énergie potentielle élastique"
      ]
    }
  ]
