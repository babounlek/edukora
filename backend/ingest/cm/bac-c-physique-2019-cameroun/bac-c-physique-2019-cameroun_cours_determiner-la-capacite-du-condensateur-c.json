  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "Le triangle des impédances (R, Zc, Z) permet, connaissant Z et R, de déterminer la réactance capacitive puis la capacité."
    },
    {
      "type": "prerequis",
      "items": [
        "Relation Z²=R²+Zc²",
        "Réactance capacitive Zc=1/(Cω)"
      ]
    },
    {
      "type": "regle",
      "titre": "Détermination de C à partir de Z et R",
      "contenu_markdown": "Zc=√(Z²-R²), puis C=1/(2πN×Zc).",
      "formule_principale": "C = 1/(2πN×Zc)",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Calculer C pour Z=500Ω, R=300Ω, N=50Hz.",
      "epreuve_source": true,
      "etapes": [
        "Calculer Zc=√(Z²-R²)",
        "Appliquer C=1/(2πNZc)"
      ],
      "conclusion_markdown": "C ≈ 8,0 µF"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Confondre Zc avec Z-R au lieu de √(Z²-R²)"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Déterminer C connaissant directement Zc et N"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "Triangle des impédances R-Zc-Z : outil visuel pour tout calcul RC série"
      ]
    }
  ]
