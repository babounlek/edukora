  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "L'activité initiale d'un échantillon se calcule directement à partir du nombre de noyaux initial et de la demi-vie."
    },
    {
      "type": "prerequis",
      "items": [
        "A0=λN0",
        "λ=ln2/T"
      ]
    },
    {
      "type": "regle",
      "titre": "Activité initiale d'un échantillon radioactif",
      "contenu_markdown": "A0=(ln2/T)×N0, avec T converti en secondes pour obtenir A0 en becquerels.",
      "formule_principale": "A0 = (ln2/T)×N0",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Calculer A0 pour N0≈4,60×10¹⁵, T=8,0 jours.",
      "epreuve_source": true,
      "etapes": [
        "Convertir T en secondes",
        "Calculer λ=ln2/T",
        "Calculer A0=λN0"
      ],
      "conclusion_markdown": "A0 ≈ 4,61×10⁹ Bq"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Oublier de convertir T en secondes pour obtenir λ en s⁻¹"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Calculer l'activité à un instant t ultérieur"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "A0=(ln2/T)N0 : formule directe pour l'activité initiale, sans passer par N(t)"
      ]
