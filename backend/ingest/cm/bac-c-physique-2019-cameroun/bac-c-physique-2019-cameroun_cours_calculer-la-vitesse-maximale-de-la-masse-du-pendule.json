  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "La vitesse est maximale à l'équilibre, où toute l'énergie mécanique est sous forme cinétique."
    },
    {
      "type": "prerequis",
      "items": [
        "Em=½mVmax² en x=0",
        "Lecture graphique de Em"
      ]
    },
    {
      "type": "regle",
      "titre": "Vitesse maximale à partir de l'énergie mécanique",
      "contenu_markdown": "Em=½mVmax² (en x=0, où Ep=0), d'où Vmax=√(2Em/m).",
      "formule_principale": "Vmax = √(2Em/m)",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Calculer Vmax pour Em=20mJ, m=236g.",
      "epreuve_source": true,
      "etapes": [
        "Lire Em sur le graphe",
        "Convertir en joules",
        "Appliquer Vmax=√(2Em/m)"
      ],
      "conclusion_markdown": "Vmax ≈ 0,41 m/s"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Oublier de convertir Em de mJ en J"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Calculer Vmax pour une autre valeur de Em"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "Vmax se lit toujours à x=0, point où Ec est maximale"
      ]
    }
