  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "La vitesse d'un oscillateur harmonique est maximale au passage par la position d'équilibre, et vaut Xm·ω0."
    },
    {
      "type": "prerequis",
      "items": [
        "x(t)=Xm cos(ω0t+φ)",
        "v(t)=-Xm ω0 sin(ω0t+φ)"
      ]
    },
    {
      "type": "regle",
      "titre": "Vitesse maximale d'un mouvement harmonique",
      "contenu_markdown": "vmax=Xm·ω0, avec ω0=2π/T0.",
      "formule_principale": "vmax = Xm·ω0",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Déterminer vmax connaissant Xm et la période propre T0.",
      "epreuve_source": true,
      "etapes": [
        "Calculer ω0=2π/T0",
        "Calculer vmax=Xm·ω0"
      ],
      "conclusion_markdown": "vmax ≈ 0,296 m/s"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Oublier de convertir Xm en mètres avant le calcul"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Déterminer vmax pour une amplitude double"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "vmax est toujours atteinte au passage par la position d'équilibre (x=0), jamais aux positions extrêmes"
      ]
    }
  ]
