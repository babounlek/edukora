  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "Le nom d'un sel d'ammonium quaternaire cite systématiquement le contre-ion, puis les substituants portés par l'azote."
    },
    {
      "type": "prerequis",
      "items": [
        "Nomenclature des amines"
      ]
    },
    {
      "type": "regle",
      "titre": "Nomenclature d'un sel d'ammonium quaternaire",
      "contenu_markdown": "Nom = 'nom de l'anion' de 'préfixes des substituants sur N (N,N,N-...)' + nom de la chaîne principale + suffixe '-ammonium'.",
      "formule_principale": null,
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Nommer (CH3)4N+, Br-.",
      "epreuve_source": true,
      "etapes": [
        "Identifier les substituants sur l'azote",
        "Construire le nom avec le suffixe -ammonium",
        "Ajouter le nom de l'anion"
      ],
      "conclusion_markdown": "Bromure de tétraméthylammonium."
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Omettre le contre-ion dans le nom complet du sel"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Nommer (CH3)3(C2H5)N+, Cl-."
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "Nom du sel = anion + substituants sur N + '-ammonium'"
      ]
    }
  ]
