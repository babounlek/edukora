  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "La période propre se lit directement à partir de la pulsation identifiée dans l'équation différentielle."
    },
    {
      "type": "prerequis",
      "items": [
        "ω0²=k/m",
        "T0=2π/ω0"
      ]
    },
    {
      "type": "regle",
      "titre": "Période propre d'un pendule élastique",
      "contenu_markdown": "T0=2π√(m/k).",
      "formule_principale": "T0 = 2π√(m/k)",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Donner l'expression de la période d'un pendule élastique vertical.",
      "epreuve_source": true,
      "etapes": [
        "Identifier ω0² dans l'équation différentielle",
        "Appliquer T0=2π/ω0"
      ],
      "conclusion_markdown": "T0 = 2π√(m/k)"
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Confondre avec la formule du pendule simple ou du pendule pesant"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Élever T0 au carré pour obtenir la relation affine T0²=f(m)"
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "T0²=(4π²/k)m est la forme affine exploitée pour la détermination graphique de k"
      ]
    }
