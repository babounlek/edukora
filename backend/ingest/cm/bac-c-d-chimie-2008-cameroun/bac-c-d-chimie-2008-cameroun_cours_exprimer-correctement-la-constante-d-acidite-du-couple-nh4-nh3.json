  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "Exprimer correctement une constante d'acidité pour un couple donné consolide la maîtrise générale de cette notion."
    },
    {
      "type": "prerequis",
      "items": [
        "Expression générale de KA"
      ]
    },
    {
      "type": "regle",
      "titre": "Exprimer KA du couple NH4+/NH3",
      "contenu_markdown": "La constante d'acidité d'un couple s'exprime toujours KA=[base][H3O+]/[acide], avec l'acide au dénominateur et sa base conjuguée au numérateur.",
      "formule_principale": "KA = [NH3][H3O+]/[NH4+]",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Exprimer la constante d'acidité du couple NH4+/NH3.",
      "epreuve_source": true,
      "etapes": [
        "Identifier l'acide et la base du couple",
        "Écrire KA=[base][H3O+]/[acide]"
      ],
      "conclusion_markdown": "KA=[NH3][H3O+]/[NH4+]."
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Permuter acide et base dans l'expression de KA"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Exprimer KA du couple C6H5COOH/C6H5COO-.",
        "Exprimer KA du couple CH3NH3+/CH3NH2."
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "KA=[base][H3O+]/[acide], universel pour tout couple acide-base"
      ]
    }
  ]
