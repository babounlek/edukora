      ]
    },
    {
      "type": "regle",
      "titre": "Nommer un ester",
      "contenu_markdown": "Un ester R-COO-R' se nomme « [nom de l'acide en -oate] de [nom du groupe alkyle de l'alcool] ».",
      "formule_principale": null,
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Nommer l'ester CH3-COO-CH2CH2CH2CH3.",
      "epreuve_source": true,
      "etapes": [
        "Identifier le radical acide et lui donner le suffixe -oate",
        "Identifier le radical alcool et lui donner le suffixe -yle"
      ],
      "conclusion_markdown": "Éthanoate de butyle."
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Permuter les deux parties du nom (radical acide et radical alcool)"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Nommer l'ester CH3CH2-COO-CH3.",
        "Nommer l'ester HCOO-CH2CH3."
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "Ester R-COO-R' : [radical acide]-oate de [radical alcool]-yle"
