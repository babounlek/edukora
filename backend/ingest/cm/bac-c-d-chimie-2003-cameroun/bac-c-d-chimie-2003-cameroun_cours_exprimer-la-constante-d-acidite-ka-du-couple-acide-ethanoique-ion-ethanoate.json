  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "Exprimer correctement la constante d'acidité d'un couple est indispensable avant tout calcul quantitatif faisant intervenir le Ka ou le pKa."
    },
    {
      "type": "prerequis",
      "items": [
        "Notion de quotient de réaction à l'équilibre"
      ]
    },
    {
      "type": "regle",
      "titre": "Exprimer Ka d'un couple acide/base",
      "contenu_markdown": "Ka=[base][H3O+]/[acide], sans l'eau (solvant) dans l'expression.",
      "formule_principale": "Ka = [CH3COO-][H3O+]/[CH3COOH]",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Exprimer Ka du couple CH3COOH/CH3COO-.",
      "epreuve_source": true,
      "etapes": [
        "Identifier les espèces à l'équilibre",
        "Écrire le quotient produits/réactif"
      ],
      "conclusion_markdown": "Ka = [CH3COO-][H3O+]/[CH3COOH]."
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Inclure l'eau (solvant) dans l'expression de Ka"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Exprimer Ka du couple NH4+/NH3.",
        "Exprimer Ka du couple HCOOH/HCOO-."
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "Ka=[base][H3O+]/[acide], l'eau n'apparaît jamais dans l'expression"
      ]
    }
  ]
