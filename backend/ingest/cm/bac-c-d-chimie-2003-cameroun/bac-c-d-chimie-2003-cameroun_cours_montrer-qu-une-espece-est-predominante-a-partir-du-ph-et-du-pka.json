  "sections": [
    {
      "type": "accroche",
      "contenu_markdown": "Déterminer l'espèce prédominante d'un couple acide-base à partir du pH et du pKa est une application directe et fréquente de la relation de Henderson-Hasselbalch."
    },
    {
      "type": "prerequis",
      "items": [
        "Relation de Henderson-Hasselbalch"
      ]
    },
    {
      "type": "regle",
      "titre": "Prédominance d'une espèce selon pH et pKa",
      "contenu_markdown": "pH=pKa+log([base]/[acide]). Si pH>pKa, log positif, donc [base]>[acide] : la base conjuguée est prédominante.",
      "formule_principale": "[base]/[acide] = 10^(pH-pKa)",
      "variantes": []
    },
    {
      "type": "exemple_resolu",
      "enonce_markdown": "Montrer que CH3COO- est prédominant pour pH=6,5 et pKa=4,8.",
      "epreuve_source": true,
      "etapes": [
        "Calculer pH-pKa",
        "Calculer 10^(pH-pKa)",
        "Conclure sur la prédominance"
      ],
      "conclusion_markdown": "[CH3COO-]/[CH3COOH]=10^1,7≈50, CH3COO- est largement prédominant."
    },
    {
      "type": "erreurs_classiques",
      "items": [
        "Inverser le calcul (pKa-pH au lieu de pH-pKa)"
      ]
    },
    {
      "type": "exercices_application",
      "items": [
        "Montrer quelle espèce prédomine pour pH=3 et pKa=4,8.",
        "Calculer le rapport [base]/[acide] pour pH=pKa+1."
      ]
    },
    {
      "type": "synthese",
      "items_markdown": [
        "pH>pKa ⇒ base conjuguée prédominante",
        "pH<pKa ⇒ acide prédominant"
      ]
    }
  ]
}