# Modèle pour le .env de production - copier en .env sur le Droplet et remplir de
# vraies valeurs. Ne JAMAIS copier le .env de développement local tel quel : il a
# DEBUG=True et des identifiants CamPay de test.

DEBUG=False
# Génère une valeur fraîche, jamais celle du .env de dev :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-fresh-one
ALLOWED_HOSTS=edukora.africa
CSRF_TRUSTED_ORIGINS=https://edukora.africa
CORS_ALLOWED_ORIGINS=https://edukora.africa

# Optionnels - défauts sûrs déjà dérivés de DEBUG=False dans settings.py, à ne
# surcharger que si besoin (ex. tester la stack Docker en local sans TLS).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=604800

SITE_NAME=EduKora
FRONTEND_URL=https://edukora.africa

# Lues par docker-compose.yml (build args de l'image caddy) et par le Caddyfile -
# distinctes des variables Django ci-dessus car figées dans le bundle JS du frontend
# au moment du build (voir Dockerfile.caddy), jamais lues à l'exécution.
SITE_DOMAIN=edukora.africa
VITE_API_BASE_URL=https://edukora.africa
VITE_SITE_NAME=EduKora
VITE_SITE_URL=https://edukora.africa

# DB_HOST doit rester "db" (nom du service docker-compose), jamais "localhost" -
# seule valeur qui diffère structurellement d'un .env de développement.
DB_NAME=edukora_db
DB_USER=edukora_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Vrais identifiants CamPay production (dashboard CamPay), jamais ceux de DEV.
CAMPAY_ENVIRONMENT=PROD
CAMPAY_APP_USERNAME=change-me
CAMPAY_APP_PASSWORD=change-me

# Optionnel - défaut déjà sûr (ConsoleSMSBackend) si un vrai fournisseur SMS n'est
# pas encore branché.
# SMS_BACKEND=users.sms_backends.ConsoleSMSBackend

# Plafonds d'envoi d'OTP (voir users.otp_service.request_otp). Chaque code envoyé étant
# un SMS facturé, ces deux valeurs bornent directement la facture face à une attaque par
# saturation ("SMS pumping"). Les défauts du code (30/h par IP, 1000 par 24 h au total)
# conviennent au démarrage ; à revoir dès que le trafic réel augmente, faute de quoi le
# plafond global coupera l'authentification pour tout le monde (erreur 503, journalisée
# en ERROR donc visible dans Sentry). Ne pas serrer le plafond par IP sans précaution :
# les abonnés mobiles partagent massivement une même IP publique via le CGNAT opérateur.
# OTP_MAX_PER_IP_PER_HOUR=30
# OTP_DAILY_GLOBAL_CAP=1000

# Connexion par code envoyé par e-mail (voir users.email_service) - troisième méthode,
# proposée en deuxième, entre Google et le téléphone. Optionnel : par défaut le code
# s'affiche dans les journaux du serveur, sous la même forme compacte que les SMS
# (users.email_backends.ConsoleEmailBackend), au lieu d'être réellement envoyé.
#
# Trois points à ne pas rater en production, sous peine d'une panne SILENCIEUSE - les
# messages partent, mais atterrissent en indésirables et l'utilisateur reste bloqué sans
# comprendre :
#   1. DEFAULT_FROM_EMAIL doit être sur un domaine que vous contrôlez (pas gmail.com).
#   2. Ce domaine doit publier SPF et DKIM autorisant le routeur configuré ci-dessous,
#      et de préférence un enregistrement DMARC.
#   3. Testez l'arrivée réelle chez Gmail avant d'annoncer la méthode aux utilisateurs.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=change-me
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=EduKora <no-reply@edukora.africa>

# Plafonds d'envoi des codes e-mail (voir users.email_service.request_email_code).
# Compteurs SÉPARÉS de ceux des SMS, volontairement : un e-mail ne se facture pas, ces
# valeurs bornent l'abus (relais de spam, réputation du domaine) et non une dépense.
# Les mélanger ferait consommer le budget SMS par du trafic gratuit.
# EMAIL_CODE_MAX_PER_IP_PER_HOUR=60
# EMAIL_CODE_DAILY_GLOBAL_CAP=5000

# Connexion « Continuer avec Google » (voir users.google) - optionnel, l'endpoint
# répond 503 tant que ce n'est pas renseigné. Console Google Cloud > API et services >
# Identifiants > Créer un ID client OAuth > type « Application Web ». Ajouter l'origine
# du frontend dans « Origines JavaScript autorisées » (pas d'URI de redirection : le
# flux est un ID token vérifié par signature, pas un échange de code).
# Les deux variables portent le MÊME identifiant : la version VITE_ est lue par le
# navigateur, l'autre par le backend, et la vérification de la claim `aud` échoue si
# elles divergent. Ce n'est pas un secret - il est public par construction.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Rappels de révision WhatsApp (voir whatsapp.backends) - optionnel, défaut déjà sûr
# (ConsoleWhatsAppBackend, journalise au lieu d'envoyer) tant que ces trois valeurs ne
# sont pas renseignées. Phone Number ID + jeton d'accès : tableau de bord Meta for
# Developers > ton app > WhatsApp > Configuration de l'API.
# WHATSAPP_BACKEND=whatsapp.backends.MetaCloudAPIBackend
# WHATSAPP_PHONE_NUMBER_ID=change-me
# WHATSAPP_ACCESS_TOKEN=change-me

# Webhook WhatsApp (voir whatsapp.webhook) - nécessaire pour recevoir les « STOP »
# des utilisateurs, que la politique WhatsApp Business impose d'honorer. À renseigner
# dans Meta for Developers > ton app > WhatsApp > Configuration > Webhooks :
#   URL de rappel   : https://<SITE_DOMAIN>/whatsapp/webhook/
#   Vérifier le token : la valeur de WHATSAPP_VERIFY_TOKEN ci-dessous
# WHATSAPP_VERIFY_TOKEN : chaîne aléatoire de NOTRE choix, sans autre rôle que de
# prouver à Meta que l'URL nous appartient. En générer une avec
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WHATSAPP_APP_SECRET : « App Secret » de l'app Meta (Paramètres > De base), qui signe
# chaque notification. Tant qu'il est absent, TOUTE notification POST est refusée -
# défaut volontairement fermé, l'URL étant publique (voir webhook.verifier_signature).
# WHATSAPP_VERIFY_TOKEN=change-me
# WHATSAPP_APP_SECRET=change-me

# --- DigitalOcean Spaces - identifiants partagés par le stockage média Django et le
# service "backup" (même compte Spaces, deux buckets distincts ci-dessous) ---
# Clé d'accès dédiée (dashboard DO > Spaces > Manage Keys) - jamais la clé d'un
# compte personnel, pour pouvoir la révoquer sans tout casser ailleurs.
SPACES_ACCESS_KEY_ID=change-me
SPACES_SECRET_ACCESS_KEY=change-me
# Endpoint régional, ex. fra1.digitaloceanspaces.com (Frankfurt, la région la plus
# proche pour edukora.africa). Les deux buckets ci-dessous doivent vivre dans cette
# même région.
SPACES_ENDPOINT=fra1.digitaloceanspaces.com
SPACES_REGION=fra1

# Bucket PUBLIC (upload direct par Django - voir edtech_cm/settings.py, STORAGES) :
# héberge les figures d'exercice et les PDF de sujet générés, déjà publics par nature.
# À créer au préalable dans le dashboard DO avec "File Listing" activé/objets en
# public-read - jamais le même bucket que SPACES_BACKUP_BUCKET ci-dessous.
SPACES_BUCKET=edukora-media
# Optionnel - domaine du point de terminaison CDN Spaces si activé sur ce bucket
# (mis en cache, plus rapide) ; défaut = API Spaces brute du bucket si absent.
# SPACES_CDN_DOMAIN=edukora-media.fra1.cdn.digitaloceanspaces.com

# Bucket PRIVÉ (service "backup" uniquement) : dumps Postgres + copie offsite du
# contenu média historique (voir docker/backup/). Contient des données utilisateurs/
# paiement - ne jamais le rendre public, ne jamais réutiliser SPACES_BUCKET ici.
# Règles de cycle de vie à ajouter sur les préfixes postgres/daily|weekly|monthly
# pour purger automatiquement les anciens dumps (voir docker/backup/backup.sh).
SPACES_BACKUP_BUCKET=edukora-backups

# Optionnel - URL de ping healthchecks.io (ou équivalent) appelée après chaque
# backup réussi, et sur /fail en cas d'échec. Laisser vide pour désactiver.
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optionnel - fuseau horaire du service "backup" (log + heure du cron, 02h00 TZ).
# TZ=Africa/Douala

# Optionnel - supervision d'erreurs (Sentry, voir edtech_cm/settings.py). Laisser vide
# désactive complètement le SDK (aucun appel réseau, aucun sentry_sdk.init()) - à
# renseigner une fois un projet créé sur sentry.io (ou une instance auto-hébergée).
# Format DSN : https://<clé>@o<org>.ingest.sentry.io/<projet>
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_SEND_DEFAULT_PII=False

# Optionnel - même DSN Sentry côté frontend (projet Sentry distinct côté sentry.io) -
# laisser vide désactive le SDK frontend de la même façon. Lu au build (voir
# docker/caddy/Dockerfile) : contrairement aux variables Django ci-dessus, un simple
# changement de valeur ici exige un rebuild de l'image caddy pour prendre effet.
# VITE_SENTRY_DSN=
