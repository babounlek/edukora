# Modèle pour le .env de production - copier en .env sur le Droplet et remplir de
# vraies valeurs. Ne JAMAIS copier le .env de développement local tel quel : il a
# DEBUG=True et des identifiants CamPay de test.

DEBUG=False
# Génère une valeur fraîche, jamais celle du .env de dev :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=a-remplacer-par-une-longue-cle-aleatoire
ALLOWED_HOSTS=edukora.africa
CSRF_TRUSTED_ORIGINS=https://edukora.africa
CORS_ALLOWED_ORIGINS=https://edukora.africa

# Optionnels - défauts sûrs déjà dérivés de DEBUG=False dans settings.py, à ne
# surcharger que si besoin (ex. tester la stack Docker en local sans TLS).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=604800

SITE_NAME=EduKora
FRONTEND_URL=https://edukora.africa
SITE_DOMAIN=edukora.africa
# Lues par docker-compose.yml (build args de l'image caddy) et par le Caddyfile -
# distinctes des variables Django ci-dessus car figées dans le bundle JS du frontend
# au moment du build (voir Dockerfile.caddy), jamais lues à l'exécution.
SITE_DOMAIN=edukora.africa
VITE_API_BASE_URL=https://edukora.africa
VITE_SITE_NAME=EduKora
VITE_SITE_URL=https://edukora.africa

# DB_HOST doit rester "db" (nom du service docker-compose), jamais "localhost" -
# seule valeur qui diffère structurellement d'un .env de développement.
DB_NAME=edukora_db
DB_USER=edukora_user
DB_PASSWORD=a-remplacer
DB_HOST=db
DB_PORT=5432

# Vrais identifiants CamPay production (dashboard CamPay), jamais ceux de DEV.
CAMPAY_ACTIVE=1
# Paiement manuel (transfert déclaré, vérifié par l'équipe) : 1 = proposé, 0 = coupé.
MANUAL_PAYMENT_ACTIVE=1
CAMPAY_ENVIRONMENT=PROD
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=

# Optionnel - défaut déjà sûr (ConsoleSMSBackend) si un vrai fournisseur SMS n'est
# pas encore branché.
# SMS_BACKEND=users.sms_backends.ConsoleSMSBackend
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_ENDPOINT=sfo3.digitaloceanspaces.com
SPACES_REGION=sfo3
SPACES_BUCKET=edukora-media
SPACES_BACKUP_BUCKET=edukora-backups

GOOGLE_CLIENT_ID=519152011730-ek7vd2h7btotor6homo3jbcn4j0g5gnp.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=519152011730-ek7vd2h7btotor6homo3jbcn4j0g5gnp.apps.googleusercontent.com

# SMTP Google Workspace - authentifié sur contact@edukora.africa (compte réel), qui
# expédie "en tant que" no-reply@edukora.africa : ce dernier n'est qu'un ALIAS de
# domaine de contact@ (pas de compte propre, donc pas de mot de passe propre), et
# Workspace autorise automatiquement l'envoi sous ses propres alias de domaine, sans
# étape de vérification "Envoyer en tant que" comme pour un alias externe.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@edukora.africa
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EduKora <no-reply@edukora.africa>

SMS_BACKEND=users.sms_backends.LMTSMSBackend
LMT_API_KEY=
LMT_SECRET=
LMT_SENDER_ID=FRC

WHATSAPP_BACKEND=whatsapp.backends.MetaCloudAPIBackend
WHATSAPP_PHONE_NUMBER_ID=1285912357934946
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
deploy@ubuntu-s-2vcpu-2gb-60gb-nyc1:/srv/edukora$
deploy@ubuntu-s-2vcpu-2gb-60gb-nyc1:/srv/edukora$