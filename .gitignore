# Quiz : seul cm/ (contenu rédigé) est versionné ; la racine de _quiz/ ne contient que des requêtes de génération
# régénérables depuis la base (_batch_*.json), des journaux et des brouillons, hors les deux scripts de campagne.
backend/ingest/_quiz/*
!backend/ingest/_quiz/cm/
!backend/ingest/_quiz/_quiz_batch.py
!backend/ingest/_quiz/_pre_ingestion.py
# Sources téléchargées (PDF tiers filigranés, plusieurs Go) : matière première des lots, jamais versionnée.
backend/ingest/_telechargements_*/
# Copies de travail des lots d'épreuves : une fois ingéré et validé, le contenu vit dans cm/ (seul versionné).
backend/ingest/_gce_staging/
# Dossier d'exécution de Django (figures et PDF générés à l'ingestion), régénérable depuis ingest/ ; le dossier media/
# de la racine reste, lui, versionné pour les figures déjà suivies.
backend/media/
